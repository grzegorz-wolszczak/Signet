<Project>

  <!--
    Signet versioning: <VersionPrefix>-<yyyyMMddHHmm UTC>, e.g. 0.1.0.0-202610021432, for local builds.

    VersionPrefix comes from Directory.Build.props; the timestamp is the build time (UTC). A release build of the release
    pipeline passes -p:SignetReleaseVersion=X.Y.Z.W: Signet's own projects then carry exactly that version, without a
    timestamp. The EPUBCheck port overrides VersionPrefix (EpubCheckVersion.props) and keeps its timestamp.
    The full version goes into AssemblyInformationalVersionAttribute and is read at runtime
    by Signet.App.Infrastructure.AppVersion.

    Imported only by Signet.App.csproj. Skipped in IDE design-time builds.
  -->
  <PropertyGroup>
    <!-- No "+<commit hash>" appended by the SDK to InformationalVersion. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="SignetSetVersion"
          BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <!-- A timestamp given on the command line (-p:SignetBuildTimestamp=202611071500) wins: the publish script of the
           standalone EPUBCheck tool builds two platforms with one version. -->
      <SignetBuildTimestamp Condition="'$(SignetBuildTimestamp)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmm'))</SignetBuildTimestamp>
      <InformationalVersion>$(VersionPrefix)-$(SignetBuildTimestamp)</InformationalVersion>
      <InformationalVersion Condition="'$(SignetReleaseVersion)' != '' and '$(VersionPrefix)' == '$(SignetReleaseVersion)'">$(SignetReleaseVersion)</InformationalVersion>
    </PropertyGroup>

    <Message Importance="high" Text="Signet $(InformationalVersion)" />
  </Target>

</Project>
