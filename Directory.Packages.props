<Project>

  <!--
    Central Package Management. All package versions are pinned here; projects reference
    them with <PackageReference Include="..." /> without a Version attribute.
    Version bumps are deliberate changes (a separate `build` commit).
  -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Avalonia / UI">
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- Color picker in Preferences (ColorView: spectrum, sliders, #hex). -->
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Dependency of Signet.Controls.TreeDataGrid (the MIT TreeDataGrid fork uses Subject / Disposable). -->
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Docking">
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Serializer.SystemTextJson" Version="12.1.0.6" />
    <!-- Transitive dependency of Dock.Avalonia; referenced explicitly only so that dockable
         view models can implement IDeferredContentPresentation and turn deferred content off
         (materializing content through the dispatcher queue caused re-entrancy in the views'
         DataContextChanged handlers when docks were re-parented). -->
    <PackageVersion Include="Dock.Controls.DeferredContentControl" Version="12.1.0.6" />
  </ItemGroup>

  <ItemGroup Label="DI / logging">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- "mtp-off" variant: xUnit.v3 without Microsoft.Testing.Platform - test projects stay
         plain libraries and `dotnet test` runs classically via VSTest + runner.visualstudio,
         with no opt-in in global.json.
         Pinned to 3.2.2 (not 4.0.0): the official Avalonia.Headless.XUnit (12.1.x) is built
         against xUnit.v3 3.2.x and fails during discovery on 4.0.0. Avalonia view tests
         (Signet.App.UiTests) need a compatible version. Do not bump without checking them. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit3" Version="4.19.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Avalonia view tests on the UI thread - official package, [AvaloniaFact] attributes. -->
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup Label="Core - general utilities">
    <!-- Default generator of unique identifiers (see CLAUDE.md / Conventions). -->
    <PackageVersion Include="Ulid" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup Label="Preview / WebView">
    <!--
      Native WebView for Avalonia 12 - NativeControlHost over WebView2 (Windows) /
      WebKitGTK (Linux) / WKWebView (macOS), without bundling Chromium/CEF.
      All packages are released together - keep them on the same version.
    -->
    <PackageVersion Include="NativeWebView" Version="12.0.4.8" />
    <PackageVersion Include="NativeWebView.Core" Version="12.0.4.8" />
    <PackageVersion Include="NativeWebView.Platform.Windows" Version="12.0.4.8" />
    <PackageVersion Include="NativeWebView.Platform.Linux" Version="12.0.4.8" />
    <PackageVersion Include="NativeWebView.Platform.macOS" Version="12.0.4.8" />
  </ItemGroup>

  <ItemGroup Label="Image / font tabs">
    <!-- Image scaling and (de)coding for "Image Resize" and font pangram rendering.
         Version matches Avalonia.Skia 12.1.3 (native binaries already present transitively).
         Svg.Controls.Skia.Avalonia was considered and rejected: it pulls SkiaSharp.NativeAssets 4.x,
         which conflicts with 3.119.4 used by Avalonia 12 -> SVG tabs get a Code View only. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup Label="CLI (Signet.Cli)">
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup Label="Core libraries">
    <PackageVersion Include="AngleSharp" Version="1.7.2" />
    <PackageVersion Include="PCRE.NET" Version="1.6.0" />
    <PackageVersion Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <!-- Diff engine for checkpoint comparison, Apache-2.0. -->
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

</Project>
