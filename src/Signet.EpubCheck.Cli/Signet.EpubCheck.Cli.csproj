<Project Sdk="Microsoft.NET.Sdk">

  <!-- The standalone EPUBCheck tool: the executable is "epubcheck.net" (win-x64 and linux-x64, self-contained,
       single-file; not a dotnet tool). Its version is the one of Signet.EpubCheck.Core. -->
  <Import Project="..\..\version\EpubCheckVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Signet.EpubCheck.Cli</RootNamespace>
    <AssemblyName>epubcheck.net</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Signet.EpubCheck.Core\Signet.EpubCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Signet.EpubCheck.Cli.Tests" />
    <InternalsVisibleTo Include="Signet.EpubCheck.Conformance.Tests" />
  </ItemGroup>

</Project>
