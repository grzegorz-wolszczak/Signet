<Project Sdk="Microsoft.NET.Sdk">

  <!-- The standalone EPUBCheck tool: the executable is "epubcheck.net" (win-x64 and linux-x64, self-contained,
       single-file; not a dotnet tool). Its version is the one of Signet.EpubCheck.Core. -->
  <Import Project="..\..\version\EpubCheckVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Signet.EpubCheck.Cli</RootNamespace>
    <AssemblyName>epubcheck.net</AssemblyName>
  </PropertyGroup>

  <!-- `dotnet publish -r win-x64|linux-x64` (scripts/epubcheck/publish.sh) makes the standalone executable: self-contained, one file,
       not trimmed (the schemas and the message texts are resources loaded by name at run time, which a trimmer cannot follow).
       InvariantGlobalization stays off: the tool's Polish texts need the culture data (ICU on Linux). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en;pl</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Signet.EpubCheck.Core\Signet.EpubCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Signet.EpubCheck.Cli.Tests" />
    <InternalsVisibleTo Include="Signet.EpubCheck.Conformance.Tests" />
  </ItemGroup>

</Project>
