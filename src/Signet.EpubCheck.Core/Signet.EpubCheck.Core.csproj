<Project Sdk="Microsoft.NET.Sdk">

  <!-- The checking core of the EPUBCheck port (see UPSTREAM.md). It does not depend on Signet.Core: the standalone
       tool (Signet.EpubCheck.Cli) uses it alone, Signet uses it through its own adapters. -->
  <Import Project="..\..\version\EpubCheckVersion.props" />
  <Import Project="..\..\version\Versioning.targets" />

  <PropertyGroup>
    <RootNamespace>Signet.EpubCheck.Core</RootNamespace>
    <AssemblyName>Signet.EpubCheck.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Signet.EpubCheck.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jing's RELAX NG schema of NVDL, which NVDL schemas are validated with (Jing's validate/nvdl/resources/nvdl.rng). -->
    <EmbeddedResource Include="Jing\Resources\nvdl.rng" LogicalName="Signet.EpubCheck.Core.Jing.Resources.nvdl.rng" />
    <!-- Jing's RELAX NG schemas of ISO Schematron and Schematron 1.5 (Jing's validate/schematron/resources). -->
    <EmbeddedResource Include="Jing\Resources\iso-schematron.rnc" LogicalName="Signet.EpubCheck.Core.Jing.Resources.iso-schematron.rnc" />
    <EmbeddedResource Include="Jing\Resources\schematron.rnc" LogicalName="Signet.EpubCheck.Core.Jing.Resources.schematron.rnc" />
  </ItemGroup>

  <ItemGroup>
    <!-- EPUBCheck's schemas and the stylesheets its build runs on them (Xml/Schemas, see its README), named by their path
         there: schema/30/package-30.rnc, util/sch/iso-sch-include.xsl, … (SchemaResources). -->
    <EmbeddedResource Include="Xml\Schemas\schema\**\*.rnc;Xml\Schemas\schema\**\*.rng;Xml\Schemas\schema\**\*.nvdl;Xml\Schemas\schema\**\*.sch;Xml\Schemas\schema\**\*.xml;Xml\Schemas\schema\**\*.dtd;Xml\Schemas\schema\**\*.dtdinc"
                      LogicalName="schema/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Xml\Schemas\util\**\*.xsl" LogicalName="util/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
