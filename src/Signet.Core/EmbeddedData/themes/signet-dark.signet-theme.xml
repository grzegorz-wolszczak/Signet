<?xml version="1.0" encoding="utf-8"?>
<!-- Signet Dark: dark controls, after Visual Studio Code's Dark+ and Rider's Darcula. It sets every interface key that
     has a default, the colors of the Fluent palette among them (the registry holds their light values, this file their
     dark ones). The accent is the only one left to the system, because that is what it is: the user's accent color. The
     colors of the editors are in the color scheme of the same name. -->
<signet-theme version="1" id="signet-dark" name="Signet Dark" variant="Dark">
  <colors>
    <!-- The Fluent palette in its dark variant; the registry holds the light one. -->
    <color key="fluent.altHigh" value="#FF000000" />
    <color key="fluent.altLow" value="#33000000" />
    <color key="fluent.altMedium" value="#99000000" />
    <color key="fluent.altMediumHigh" value="#CC000000" />
    <color key="fluent.altMediumLow" value="#66000000" />
    <color key="fluent.baseHigh" value="#FFFFFFFF" />
    <color key="fluent.baseLow" value="#33FFFFFF" />
    <color key="fluent.baseMedium" value="#99FFFFFF" />
    <color key="fluent.baseMediumHigh" value="#CCFFFFFF" />
    <color key="fluent.baseMediumLow" value="#66FFFFFF" />
    <color key="fluent.chromeAltLow" value="#FFF2F2F2" />
    <color key="fluent.chromeBlackHigh" value="#FF000000" />
    <color key="fluent.chromeBlackLow" value="#33000000" />
    <color key="fluent.chromeBlackMedium" value="#CC000000" />
    <color key="fluent.chromeBlackMediumLow" value="#66000000" />
    <color key="fluent.chromeDisabledHigh" value="#FF333333" />
    <color key="fluent.chromeDisabledLow" value="#FF858585" />
    <color key="fluent.chromeGray" value="#FF767676" />
    <color key="fluent.chromeHigh" value="#FF767676" />
    <color key="fluent.chromeLow" value="#FF171717" />
    <color key="fluent.chromeMedium" value="#FF1F1F1F" />
    <color key="fluent.chromeMediumLow" value="#FF2B2B2B" />
    <color key="fluent.chromeWhite" value="#FFFFFFFF" />
    <color key="fluent.errorText" value="#FFFFF000" />
    <color key="fluent.listLow" value="#19FFFFFF" />
    <color key="fluent.listMedium" value="#33FFFFFF" />
    <color key="fluent.regionColor" value="#FF000000" />

    <color key="ui.dangerButton" value="#C42B1C" />
    <color key="ui.dangerButton.hover" value="#A82315" />
    <color key="ui.dangerButton.pressed" value="#8E1D11" />
    <color key="ui.dangerButton.text" value="#FFFFFF" />
    <color key="ui.cautionButton" value="#CA5010" />
    <color key="ui.cautionButton.hover" value="#AC440E" />
    <color key="ui.cautionButton.pressed" value="#923A0C" />
    <color key="ui.cautionButton.text" value="#FFFFFF" />
    <color key="ui.frame" value="#6E6E6E" />
    <color key="ui.mutedText" value="#9D9D9D" />
    <color key="ui.warningText" value="#E8A33D" />
    <color key="ui.errorNotification" value="#F1707B" />
    <color key="ui.errorText" value="#F48771" />
    <color key="ui.renameErrorText" value="#F14C4C" />
    <color key="ui.riskMarker" value="#F14C4C" />
    <color key="ui.filterActive" value="#6CC07A" />
    <color key="ui.icon.inactive" value="#6E6E6E" />
    <color key="ui.icon.attention" value="#F1707B" />
    <color key="ui.icon.folder" value="#4E94E8" />
    <color key="ui.icon.folderInner" value="#2B5A8C" />
    <color key="ui.icon.file" value="#D0D0D0" />
    <color key="ui.icon.fileOutline" value="#8A8A8A" />
    <color key="ui.icon.fileFold" value="#A0A0A0" />
    <!-- The Preview panel: the highlight of the caret keeps its color; the colors forced on the book are left to the book. -->
    <color key="preview.highlight" value="#FFEB3B" />
  </colors>
  <attributes>
    <attribute key="ui.textSelection" foreground="#FFFFFF" background="#264F78" />
    <attribute key="ui.fontPreview" foreground="#D4D4D4" background="#252526" />
  </attributes>
</signet-theme>
