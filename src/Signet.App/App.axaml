<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockFluent="using:Dock.Avalonia.Themes.Fluent"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:dockCore="using:Dock.Model.Core"
             xmlns:dockControls="using:Dock.Model.Controls"
             xmlns:dockConverters="using:Dock.Avalonia.Converters"
             xmlns:docking="using:Signet.App.Docking"
             xmlns:views="using:Signet.App.Views"
             xmlns:tabViews="using:Signet.App.Views.Tabs"
             xmlns:tabVm="using:Signet.App.ViewModels.Tabs"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:infra="using:Signet.App.Infrastructure"
             x:Class="Signet.App.App"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
    <DataTemplate DataType="docking:BookBrowserTool">
      <Panel IsEnabled="{Binding IsContentEnabled}">
        <views:BookBrowserView DataContext="{Binding ViewModel}" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="docking:PreviewTool">
      <Panel IsEnabled="{Binding IsContentEnabled}">
        <views:PreviewView DataContext="{Binding ViewModel}" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="docking:TableOfContentsTool">
      <Panel IsEnabled="{Binding IsContentEnabled}">
        <views:TableOfContentsView DataContext="{Binding ViewModel}" />
      </Panel>
    </DataTemplate>


    <DataTemplate DataType="docking:ValidationResultsTool">
      <Panel IsEnabled="{Binding IsContentEnabled}">
        <views:ValidationResultsView DataContext="{Binding ViewModel}" />
      </Panel>
    </DataTemplate>


    <DataTemplate DataType="docking:ClipsTool">
      <Panel IsEnabled="{Binding IsContentEnabled}">
        <views:ClipsPanelView DataContext="{Binding ViewModel}" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="docking:NotificationsTool">
      <views:NotificationsView DataContext="{Binding ViewModel}" />
    </DataTemplate>

    <DataTemplate DataType="docking:CheckpointsTool">
      <Panel IsEnabled="{Binding IsContentEnabled}">
        <views:CheckpointsPanelView DataContext="{Binding ViewModel}" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="docking:FindUsagesTool">
      <Panel IsEnabled="{Binding IsContentEnabled}">
        <views:FindUsagesView DataContext="{Binding ViewModel}" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="vm:StartScreenViewModel">
      <views:StartScreenView />
    </DataTemplate>

    <DataTemplate DataType="tabVm:PlaceholderContentTabViewModel">
      <tabViews:PlaceholderContentTabView />
    </DataTemplate>

    <DataTemplate DataType="tabVm:CodeTabViewModel">
      <tabViews:CodeTabView />
    </DataTemplate>

    <DataTemplate DataType="tabVm:ImageTabViewModel">
      <tabViews:ImageTabView />
    </DataTemplate>

    <DataTemplate DataType="tabVm:FontTabViewModel">
      <tabViews:FontTabView />
    </DataTemplate>

    <DataTemplate DataType="tabVm:MediaTabViewModel">
      <tabViews:MediaTabView />
    </DataTemplate>

    <DataTemplate DataType="docking:PlaceholderTool">
      <Border Padding="16">
        <TextBlock Text="{Binding Placeholder}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Opacity="0.7" />
      </Border>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <!-- Text selection in edit boxes (Fluent's dark accent made black text unreadable), the danger buttons, the
           file list icons and the other interface colors (Signet*Brush, SignetFolderIcon, SignetFileIcon) come from
           the theme: AppTheme sets them in App.Initialize and whenever a theme is applied. -->

      <!-- Menus and flyouts: Fluent caps their popup width at FlyoutThemeMaxWidth (456), which
           clipped longer menu labels (no ellipsis). Lift the cap so popups size to their content. -->
      <x:Double x:Key="FlyoutThemeMaxWidth">Infinity</x:Double>

      <!-- The menu of a panel's title bar (▾), replacing the Dock theme's one (same key, same items). Dock only enables
           "Dock" to undo "Auto Hide" and keeps "Float" enabled in a floating window; here a floating panel has "Float"
           disabled and "Dock" enabled, which docks it back into its region (MainDockFactory.PinDockable). -->
      <MenuFlyout x:Key="ToolChromeControlContextMenu" x:DataType="dockControls:IToolDock">
        <MenuItem Header="{DynamicResource ToolChromeControlFloatString}"
                  Command="{Binding Owner.Factory.FloatDockable}"
                  CommandParameter="{Binding ActiveDockable}"
                  IsEnabled="{Binding $parent[dock:ToolChromeControl].IsFloating, Converter={x:Static BoolConverters.Not}, FallbackValue=True}">
          <MenuItem.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <MultiBinding Converter="{x:Static dockConverters:DockCapabilityConverters.CanFloatMultiConverter}">
                <Binding Path="ActiveDockable" />
                <Binding Path="ActiveDockable.CanFloat" />
                <Binding Path="ActiveDockable.DockCapabilityOverrides.CanFloat" />
                <Binding Path="(dockCore:IDock).DockCapabilityPolicy.CanFloat" />
              </MultiBinding>
              <MultiBinding Converter="{x:Static dockConverters:CanRemoveDockableConverter.Instance}">
                <Binding Path="(dockCore:IDock).CanCloseLastDockable" FallbackValue="{x:True}" />
                <Binding Path="(dockCore:IDock).VisibleDockables.Count" FallbackValue="0" />
              </MultiBinding>
            </MultiBinding>
          </MenuItem.IsVisible>
        </MenuItem>
        <MenuItem Header="{DynamicResource ToolChromeControlDockString}"
                  Command="{Binding Owner.Factory.PinDockable}"
                  CommandParameter="{Binding ActiveDockable}">
          <MenuItem.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
              <Binding Path="ActiveDockable.OriginalOwner" Converter="{x:Static ObjectConverters.IsNotNull}" FallbackValue="False" />
              <Binding Path="$parent[dock:ToolChromeControl].IsFloating" FallbackValue="False" />
            </MultiBinding>
          </MenuItem.IsEnabled>
          <MenuItem.IsVisible>
            <MultiBinding Converter="{x:Static dockConverters:DockCapabilityConverters.CanPinMultiConverter}">
              <Binding Path="ActiveDockable" />
              <Binding Path="ActiveDockable.CanPin" />
              <Binding Path="ActiveDockable.DockCapabilityOverrides.CanPin" />
              <Binding Path="(dockCore:IDock).DockCapabilityPolicy.CanPin" />
            </MultiBinding>
          </MenuItem.IsVisible>
        </MenuItem>
        <MenuItem Header="{DynamicResource ToolChromeControlDockAsDocumentString}"
                  Command="{Binding Owner.Factory.DockAsDocument}"
                  CommandParameter="{Binding ActiveDockable}">
          <MenuItem.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <MultiBinding Converter="{x:Static dockConverters:DockCapabilityConverters.CanDockAsDocumentMultiConverter}">
                <Binding Path="ActiveDockable" />
                <Binding Path="ActiveDockable.CanDockAsDocument" />
                <Binding Path="ActiveDockable.DockCapabilityOverrides.CanDockAsDocument" />
                <Binding Path="(dockCore:IDock).DockCapabilityPolicy.CanDockAsDocument" />
              </MultiBinding>
              <Binding Path="ActiveDockable.Owner" Converter="{x:Static dockConverters:OwnerIsToolDockConverter.Instance}" />
            </MultiBinding>
          </MenuItem.IsVisible>
        </MenuItem>
        <MenuItem Header="{DynamicResource ToolChromeControlAutoHideString}"
                  Command="{Binding Owner.Factory.PinDockable}"
                  CommandParameter="{Binding ActiveDockable}"
                  IsEnabled="{Binding ActiveDockable.OriginalOwner, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=False}">
          <MenuItem.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <MultiBinding Converter="{x:Static dockConverters:DockCapabilityConverters.CanPinMultiConverter}">
                <Binding Path="ActiveDockable" />
                <Binding Path="ActiveDockable.CanPin" />
                <Binding Path="ActiveDockable.DockCapabilityOverrides.CanPin" />
                <Binding Path="(dockCore:IDock).DockCapabilityPolicy.CanPin" />
              </MultiBinding>
              <Binding Path="$parent[dock:ToolChromeControl].IsFloating" Converter="{x:Static BoolConverters.Not}" />
            </MultiBinding>
          </MenuItem.IsVisible>
        </MenuItem>
        <!-- "Close" hides the panel (MainDockFactory.CloseDockable; the View menu shows it again). It is always listed and
             only greyed out when the panel cannot be closed — also for the last panel of a dock, e.g. alone in a
             floating window, where Dock's own condition (CanCloseLastDockable of a dock Dock created itself) hid it. -->
        <MenuItem Header="{DynamicResource ToolChromeControlCloseString}"
                  Command="{Binding Owner.Factory.CloseDockable}"
                  CommandParameter="{Binding ActiveDockable}"
                  IsEnabled="{Binding ActiveDockable.CanClose, FallbackValue=False}" />
      </MenuFlyout>

      <!-- Font size of the warning texts in dialogs (TextBlock.warning / .warningNote). The real value — the
           interface text size or the size chosen in Preferences → Appearance › General › Fonts — is set by
           UiDensityManager; this is the Fluent default for design time and headless tests. -->
      <x:Double x:Key="SignetWarningFontSize">14</x:Double>

      <!-- Notification icons (16×16, drawn for Signet). -->
      <StreamGeometry x:Key="SignetBellGeometry">M8,1.5 C5.5,1.5 4,3.5 4,6 L4,9.5 L2.5,11.5 L13.5,11.5 L12,9.5 L12,6 C12,3.5 10.5,1.5 8,1.5 Z M6.3,12.5 C6.5,13.5 7.2,14.3 8,14.3 C8.8,14.3 9.5,13.5 9.7,12.5 Z</StreamGeometry>
      <StreamGeometry x:Key="SignetWarningGeometry">F1 M8,1 L15.5,14.5 L0.5,14.5 Z M7.2,5.5 L8.8,5.5 L8.5,10 L7.5,10 Z M7.2,11.2 L8.8,11.2 L8.8,12.8 L7.2,12.8 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <dockFluent:DockFluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <!-- Theme of Signet.Controls.TreeDataGrid (virtualized trees and tables). After FluentTheme: it resolves the Fluent
         palette colours with StaticResource when loaded. -->
    <StyleInclude Source="avares://Signet.Controls.TreeDataGrid/Themes/Fluent.axaml" />
    <!-- Every dialog has a thin frame close to the edge of its window (the color is the theme's "ui.frame"). The main
         window, the popup-like windows and the floating tool windows of the docking opt out. -->
    <Style Selector="Window:not(.noFrame) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Margin" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SignetFrameBrush}" />
    </Style>
    <Style Selector="dock|HostWindow /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderBrush" Value="{x:Null}" />
    </Style>
    <!-- The document tabs (also those dragged out into windows of their own): the font from Preferences › Appearance › Code
         Editor › Fonts and the colors of the theme (Interface Colors). A resource that is not set leaves the tab as the
         controls have it. -->
    <Style Selector="dock|DocumentTabStripItem">
      <Setter Property="FontFamily" Value="{DynamicResource SignetDocumentTabFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource SignetDocumentTabFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource SignetDocumentTabFontWeight}" />
    </Style>
    <Style Selector="dock|DocumentTabStripItem:not(:selected)">
      <Setter Property="Foreground" Value="{DynamicResource SignetDocumentTabForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource SignetDocumentTabBackgroundBrush}" />
    </Style>
    <Style Selector="dock|DocumentTabStripItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource SignetDocumentTabSelectedForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource SignetDocumentTabSelectedBackgroundBrush}" />
    </Style>
    <!-- Tabs that do not fit in a row go to several rows instead of the scrolling arrows (Preferences › Code Editor; the
         class is on the windows that hold tabs). -->
    <Style Selector="Window.multilineTabs dock|DocumentTabStrip">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="Window.multilineTabs dock|DocumentTabStrip /template/ ScrollViewer#PART_ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <!-- Buttons that remove or delete something are red (Classes="danger", ButtonClasses.Danger); the ones that save
         use Fluent's "accent" (blue). Disabled, both are gray like any button (Fluent's :disabled template style). -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource SignetDangerButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SignetDangerButtonTextBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SignetDangerButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SignetDangerButtonTextBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SignetDangerButtonPressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SignetDangerButtonTextBrush}" />
    </Style>
    <!-- Every TreeDataGrid: resizable columns, each at least as wide as its header (TreeDataGridHeaderSizing). -->
    <Style Selector="TreeDataGrid">
      <Setter Property="CanUserResizeColumns" Value="True" />
      <Setter Property="infra:TreeDataGridHeaderSizing.FitHeaders" Value="True" />
    </Style>
    <!-- Horizontal grid lines between the rows (the counterpart of DataGrid GridLinesVisibility="Horizontal"). -->
    <Style Selector="TreeDataGrid.gridLines TreeDataGridRow">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource TreeDataGridGridLinesBrush}" />
    </Style>
    <!-- ColorView theme (color picker in Preferences). -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

    <!-- Application icon on every window (main, dialogs, tool windows) — without it child
         windows show the default Avalonia icon. -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="/Assets/AppIcon/app.ico" />
      <!-- The weight of the interface font (Preferences › Appearance › Fonts): a resource that is not set leaves the
           text as the controls have it; the text inherits it from the window. -->
      <Setter Property="FontWeight" Value="{DynamicResource SignetUiFontWeight}" />
    </Style>
    <!-- Floating panels (Dock's HostWindow) use the UI font like the main window: Fluent's Window theme sets it, the
         HostWindow theme does not, so a floated panel fell back to Avalonia's default 12 px. Dynamic, so the UI font
         from Preferences (UiDensityManager) applies to them too. -->
    <Style Selector="dock|HostWindow">
      <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
      <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    </Style>

    <!-- Tooltips: the typeface of the area they are in (Preferences → the "Fonts" pages); TooltipFonts sets the
         resource on the application and on the root of every area, together with the Fluent size resource. -->
    <Style Selector="ToolTip">
      <Setter Property="FontFamily" Value="{DynamicResource SignetToolTipFontFamily}" />
      <Setter Property="FontWeight" Value="{DynamicResource SignetToolTipFontWeight}" />
    </Style>

    <!-- A disabled button (e.g. in a toolbar) still shows its tooltip: it is where the reason for being disabled
         or the shortcut is written. -->
    <Style Selector=":is(Button), SplitButton">
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>

    <!-- Warning texts in dialogs (e.g. what a risky change would alter): size and color from
         the theme (SignetWarningBrush) and Preferences → Appearance › General › Fonts (UiDensityManager.ApplyWarningAppearance). -->
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource SignetWarningBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource SignetWarningFontSize}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Cautions of a dialog section: the warning size, with the muted look of a note. -->
    <Style Selector="TextBlock.warningNote">
      <Setter Property="FontSize" Value="{DynamicResource SignetWarningFontSize}" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="SelectionBrush" Value="{DynamicResource SignetTextSelectionBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SignetTextSelectionForegroundBrush}" />
    </Style>

    <!-- Tool tab titles: the title, followed by the notification bell for the panels that show one
         (SignetTool.ShowsNotificationBell — the Notifications panel); unread errors (SignetTool.AttentionCount)
         put a red dot on the bell and "[n]" after it. Dock's default header is just the title. -->
    <Style Selector="dock|ToolControl">
      <Setter Property="HeaderTemplate">
        <DataTemplate DataType="dockCore:IDockable">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding Title}" Padding="{DynamicResource DockHeaderContentPadding}" VerticalAlignment="Center" />
            <views:NotificationBell x:DataType="docking:SignetTool"
                                    IsVisible="{Binding ShowsNotificationBell, FallbackValue=False}"
                                    UnreadCount="{Binding AttentionCount, FallbackValue=0}" />
          </StackPanel>
        </DataTemplate>
      </Setter>
    </Style>
    <!-- A collapsed ("Auto Hide") tab: the ToolPinItemControl template of Dock.Avalonia.Themes.Fluent (v12.1.0.6)
         with the notification bell after the title (as in the tool tab header above). -->
    <Style Selector="dock|ToolPinItemControl" x:DataType="dockCore:IDockable">
      <Setter Property="Template">
        <ControlTemplate>
          <DockableControl TrackingMode="Pinned">
            <LayoutTransformControl x:Name="PART_LayoutTransformControl">
              <Border Background="{TemplateBinding Background}"
                      DockProperties.IsDragArea="True"
                      DockProperties.IsDropArea="True"
                      DockProperties.IsDockTarget="True"
                      DockProperties.ShowDockIndicatorOnly="True"
                      DockProperties.IndicatorDockOperation="Fill">
                <Button Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Command="{Binding Owner.Factory.TogglePreviewPinnedDockable}"
                        CommandParameter="{Binding}">
                  <Button.IsVisible>
                    <MultiBinding Converter="{x:Static dockConverters:DockCapabilityConverters.CanPinMultiConverter}">
                      <Binding />
                      <Binding Path="CanPin" />
                      <Binding Path="DockCapabilityOverrides.CanPin" />
                      <Binding Path="((dockCore:IDock)Owner).DockCapabilityPolicy.CanPin" />
                    </MultiBinding>
                  </Button.IsVisible>
                  <StackPanel Orientation="Horizontal" Spacing="5" ContextMenu="{TemplateBinding PinContextMenu}">
                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />
                    <views:NotificationBell x:DataType="docking:SignetTool"
                                            IsVisible="{Binding ShowsNotificationBell, FallbackValue=False}"
                                            UnreadCount="{Binding AttentionCount, FallbackValue=0}" />
                  </StackPanel>
                </Button>
              </Border>
            </LayoutTransformControl>
          </DockableControl>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Spinner buttons (NumericUpDown, ButtonSpinner): "down" on the left, "up" on the right.
         The Fluent template stacks Increase before Decrease horizontally; reversing the flow
         direction of that panel swaps them (the chevrons are horizontally symmetric). -->
    <Style Selector="ButtonSpinner /template/ StackPanel#PART_SpinnerPanel">
      <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>

    <!-- Scroll bars everywhere: always expanded to their full width (Fluent shows them as thin lines that widen only
         when the pointer comes near, which made them hard to hit), and beside the content instead of over it (the
         Fluent ScrollViewer lets the content run under the bars only while they may hide). The attached property is set
         on every templated control, not only on ScrollViewer: TextBox, ListBox, the code editor and others pass their
         own value to the ScrollViewer of their template, which a ScrollViewer style could not override. Covered by
         ScrollBarStyleTests. -->
    <Style Selector=":is(TemplatedControl)">
      <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>
  </Application.Styles>

</Application>
