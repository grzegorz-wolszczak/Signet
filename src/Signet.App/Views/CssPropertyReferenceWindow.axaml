<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.CssPropertyReferenceWindow"
        x:DataType="vm:CssPropertyReferenceViewModel"
        Title="{loc:Loc CssPropertyReferenceWindow_Title}"
        Width="720" Height="600"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <Window.Resources>
    <DataTemplate x:Key="PropertyNameCellTemplate" x:DataType="vm:CssPropertyReferenceRow">
      <!-- The tooltip is formatted text (RichText): the description, then the keywords in the font and color of code. -->
      <TextBlock Text="{Binding Name}" Background="Transparent" VerticalAlignment="Center"
                 ToolTip.Tip="{Binding Tooltip}" />
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="10">
    <CheckBox Grid.Row="0" Grid.ColumnSpan="2"
              Content="{loc:Loc CssPropertyReferenceWindow_All}"
              ToolTip.Tip="{loc:Loc CssPropertyReferenceWindow_AllTooltip}"
              IsChecked="{Binding ShowAll, Mode=TwoWay}" />

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
      <TextBlock Text="{loc:Loc CssPropertyReferenceWindow_DisplayLegend}" TextWrapping="Wrap" />
      <TextBlock Text="{loc:Loc CssPropertyReferenceWindow_DisplayHint}"
                 FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
    </StackPanel>

    <TextBox Grid.Row="2" Grid.ColumnSpan="2"
             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PlaceholderText="{loc:Loc CssPropertyReferenceWindow_SearchPlaceholder}">
      <TextBox.InnerLeftContent>
        <Path Classes="filterSearchIcon" />
      </TextBox.InnerLeftContent>
      <TextBox.InnerRightContent>
        <Button x:Name="ClearSearchButton" Content="✕" Padding="6,2" Background="Transparent" Focusable="False"
                ToolTip.Tip="{loc:Loc CssPropertyReferenceWindow_ClearSearch}"
                Command="{Binding ClearSearchCommand}"
                IsVisible="{Binding HasSearchText}" />
      </TextBox.InnerRightContent>
    </TextBox>

    <GroupBox Grid.Row="3" Grid.Column="0" Header="{loc:Loc CssPropertyReferenceWindow_Inherited}">
      <TreeDataGrid x:Name="InheritedList" Classes="gridLines" />
    </GroupBox>

    <GroupBox Grid.Row="3" Grid.Column="1" Header="{loc:Loc CssPropertyReferenceWindow_NonInherited}">
      <TreeDataGrid x:Name="NonInheritedList" Classes="gridLines" />
    </GroupBox>
  </Grid>
</Window>
