<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        xmlns:v="using:Signet.App.Views"
        x:Class="Signet.App.Views.FootnoteWindow"
        infra:TooltipFonts.Area="Footnotes"
        x:DataType="vm:FootnoteViewModel"
        Width="1040" Height="600" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">

  <Grid Margin="16" RowDefinitions="*,Auto">
    <v:FootnoteView x:Name="Body" />

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
      <Button x:Name="RemoveButton" Classes="danger" Content="{loc:Loc FootnoteWindow_RemoveButton}" MinWidth="80"
              IsVisible="{Binding IsEditing}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="OkButton" Content="{Binding AcceptText}" MinWidth="100" Classes.accent="{Binding IsEditing}"
                IsEnabled="{Binding CanAccept}" />
        <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
