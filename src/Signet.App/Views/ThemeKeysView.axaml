<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Signet.App.Resources"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:infra="using:Signet.App.Infrastructure"
             x:Class="Signet.App.Views.ThemeKeysView"
             x:DataType="vm:ThemeKeysPageViewModel">

  <!-- A page of the keys of Appearance › Color Scheme, as Rider's Color Scheme pages: the tree of the keys of the page
       on the left (keys the theme changes in bold), the panel of the selected key on the right and the preview below. -->
  <UserControl.Resources>
    <DataTemplate x:Key="ThemeKeyNameCellTemplate" x:DataType="vm:ThemeKeyNode">
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Classes.modified="{Binding IsModified}" />
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.modified">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- The color as one control: a button filled with the color, with its hex written on it, which opens the color
         picker. There is no hex field to type into — a color is chosen in the picker. -->
    <Style Selector="Button.colorField">
      <Setter Property="Width" Value="150" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="{DynamicResource SignetFrameBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- A color that is only shown (inherited, or the accent of the system) keeps its color on a switched-off
         button: a grayed-out one would hide the very thing it shows. -->
    <Style Selector="Button.colorField:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- A field with no color at all says what it falls back to instead of a hex. -->
    <Style Selector="Button.colorField.empty">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <!-- The link to the key an inherited color comes from. -->
    <Style Selector="Button.sourceLink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.sourceLink:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- Both splitters move: the width of the tree and the height of the preview (pixels, the rest stretches); the
       window remembers them for each page (TreeWidth, PreviewHeight). -->
  <Grid x:Name="Split" MinHeight="520">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" MinWidth="160" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" MinWidth="240" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="160" />
      <RowDefinition Height="12" />
      <RowDefinition Height="230" MinHeight="80" />
    </Grid.RowDefinitions>
    <Border Grid.Column="0" BorderBrush="{DynamicResource SignetFrameBrush}" BorderThickness="1">
      <TreeDataGrid x:Name="Tree" ShowColumnHeaders="False" />
    </Border>
    <GridSplitter x:Name="TreeSplitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <ScrollViewer Grid.Column="2">
      <StackPanel Spacing="8" Margin="8,0,0,0">
        <TextBlock Text="{loc:Loc ColorScheme_NoKey}" IsVisible="{Binding !HasKey}" Opacity="0.7" />

        <StackPanel x:Name="KeyPanel" Spacing="8" IsVisible="{Binding HasKey}">
          <!-- "Inherit values from <base>", with a link to the base (possibly on another page). -->
          <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanInherit}">
            <CheckBox x:Name="InheritBox" Content="{loc:Loc ColorScheme_InheritFrom}" IsChecked="{Binding Inherit}" />
            <HyperlinkButton x:Name="BaseLink" Content="{Binding BaseName}" Command="{Binding ShowBaseCommand}"
                             VerticalAlignment="Center" />
          </StackPanel>

          <!-- The look of text. -->
          <StackPanel x:Name="AttributesPanel" Spacing="6" IsVisible="{Binding IsAttributesKey}" IsEnabled="{Binding IsEditable}">
            <CheckBox x:Name="BoldBox" Content="{loc:Loc ColorScheme_Bold}" IsChecked="{Binding Bold}" />
            <CheckBox x:Name="ItalicBox" Content="{loc:Loc ColorScheme_Italic}" IsChecked="{Binding Italic}" />
            <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
              <CheckBox x:Name="ForegroundBox" Grid.Row="0" Grid.Column="0" Content="{loc:Loc ColorScheme_Foreground}"
                        IsChecked="{Binding HasForeground}" />
              <!-- Unset: the text keeps the color of what is around it, which the theme of the controls gives. -->
              <Button x:Name="ForegroundField" Grid.Row="0" Grid.Column="1" Classes="colorField" Classes.empty="{Binding !HasForeground}"
                      IsEnabled="{Binding HasForeground}" Content="{Binding ForegroundFieldText}" Command="{Binding PickForegroundCommand}"
                      ToolTip.Tip="{loc:Loc ColorScheme_PickColor}"
                      Background="{Binding Foreground, Converter={x:Static infra:ColorConverters.ToBrush}, FallbackValue={x:Null}}"
                      Foreground="{Binding ForegroundFieldTextColor, Converter={x:Static infra:ColorConverters.ToBrush}, FallbackValue={x:Null}}" />

              <CheckBox x:Name="BackgroundBox" Grid.Row="1" Grid.Column="0" Content="{loc:Loc ColorScheme_Background}"
                        IsChecked="{Binding HasBackground}" />
              <!-- Unset: no background is painted at all, so what is behind shows through. -->
              <Button x:Name="BackgroundField" Grid.Row="1" Grid.Column="1" Classes="colorField" Classes.empty="{Binding !HasBackground}"
                      IsEnabled="{Binding HasBackground}" Content="{Binding BackgroundFieldText}" Command="{Binding PickBackgroundCommand}"
                      ToolTip.Tip="{loc:Loc ColorScheme_PickColor}"
                      Background="{Binding Background, Converter={x:Static infra:ColorConverters.ToBrush}, FallbackValue={x:Null}}"
                      Foreground="{Binding BackgroundFieldTextColor, Converter={x:Static infra:ColorConverters.ToBrush}, FallbackValue={x:Null}}" />

              <CheckBox x:Name="EffectBox" Grid.Row="2" Grid.Column="0" Content="{loc:Loc ColorScheme_Effects}"
                        IsChecked="{Binding HasEffect}" />
              <ComboBox x:Name="EffectTypeBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding HasEffect}" ItemsSource="{Binding Effects}" SelectedItem="{Binding Effect}"
                        DisplayMemberBinding="{Binding DisplayName}" />

              <CheckBox x:Name="EffectColorBox" Grid.Row="3" Grid.Column="0" Content="{loc:Loc ColorScheme_EffectColor}"
                        IsEnabled="{Binding HasEffect}" IsChecked="{Binding HasEffectColor}" Margin="20,0,0,0" />
              <!-- Unset: the effect is drawn in the text color, the field two rows above. -->
              <Button x:Name="EffectColorField" Grid.Row="3" Grid.Column="1" Classes="colorField" Classes.empty="{Binding !HasEffectColor}"
                      IsEnabled="{Binding HasEffectColor}" Content="{Binding EffectColorFieldText}" Command="{Binding PickEffectColorCommand}"
                      ToolTip.Tip="{loc:Loc ColorScheme_PickColor}"
                      Background="{Binding EffectColor, Converter={x:Static infra:ColorConverters.ToBrush}, FallbackValue={x:Null}}"
                      Foreground="{Binding EffectColorFieldTextColor, Converter={x:Static infra:ColorConverters.ToBrush}, FallbackValue={x:Null}}" />
            </Grid>
          </StackPanel>

          <!-- A single color. -->
          <StackPanel x:Name="ColorPanel" Spacing="6" IsVisible="{Binding IsColorKey}">
            <CheckBox x:Name="OwnColorBox" Content="{loc:Loc ColorScheme_OwnColor}" IsChecked="{Binding HasColor}"
                      IsVisible="{Binding CanBeEmpty}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{loc:Loc ColorScheme_Color}" VerticalAlignment="Center" />
              <Button x:Name="ColorField" Classes="colorField" Classes.empty="{Binding !HasColorFieldColor}"
                      IsEnabled="{Binding HasColor}" Content="{Binding ColorFieldText}" Command="{Binding PickColorCommand}"
                      ToolTip.Tip="{loc:Loc ColorScheme_PickColor}"
                      Background="{Binding SwatchColor, Converter={x:Static infra:ColorConverters.ToBrush}, FallbackValue={x:Null}}"
                      Foreground="{Binding ColorFieldTextColor, Converter={x:Static infra:ColorConverters.ToBrush}, FallbackValue={x:Null}}" />
              <!-- Inherited from another key: a link that goes there (the field itself cannot, it is switched off). -->
              <Button x:Name="InheritedColorLink" Classes="sourceLink" Content="↗" IsVisible="{Binding HasInheritedSource}"
                      Command="{Binding GoToColorSourceCommand}" ToolTip.Tip="{Binding InheritedFromText}" />
            </StackPanel>
            <TextBlock Text="{loc:Loc ColorScheme_OwnColorNote}" IsVisible="{Binding CanBeEmpty}" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Undoes the change of the key (the key is bold in the tree while it is changed). -->
          <HyperlinkButton x:Name="RestoreLink" Content="{Binding RestoreText}" Command="{Binding RestoreCommand}"
                           IsVisible="{Binding IsModified}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- The preview in the colors of the theme with the changes not saved yet: a click selects the key under the
         mouse, and the selected key blinks (built in code for the page). -->
    <GridSplitter x:Name="PreviewSplitter" Grid.Row="1" Grid.ColumnSpan="3" ResizeDirection="Rows" Background="Transparent" />

    <Border x:Name="PreviewHost" Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{DynamicResource SignetFrameBrush}"
            BorderThickness="1" ClipToBounds="True" />
  </Grid>
</UserControl>
