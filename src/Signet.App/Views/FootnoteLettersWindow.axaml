<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.FootnoteLettersWindow"
        infra:TooltipFonts.Area="Footnotes"
        x:DataType="vm:FootnoteLettersViewModel"
        Width="900" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc FootnoteLettersWindow_Title}">

  <!-- The cells of the tree (the columns are built in code; FootnoteLetterNode). A double click opens the place. -->
  <Window.Resources>
    <DataTemplate x:Key="FootnoteLettersTitleCellTemplate" x:DataType="vm:FootnoteLetterNode">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" DoubleTapped="OnRowDoubleTapped">
        <CheckBox IsChecked="{Binding Check, Mode=TwoWay}" IsVisible="{Binding HasCheckBox}" MinWidth="0" Margin="0,0,4,0" />
        <TextBlock Text="{loc:Loc FootnoteLettersWindow_NoticeMark}" IsVisible="{Binding IsNotice}" Margin="0,0,6,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="FootnoteLettersPlaceCellTemplate" x:DataType="vm:FootnoteLetterNode">
      <TextBlock Text="{Binding Place}" VerticalAlignment="Stretch" TextTrimming="CharacterEllipsis" Background="Transparent"
                 ToolTip.Tip="{Binding Place}" DoubleTapped="OnRowDoubleTapped" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="UnifyButton" Content="{loc:Loc FootnoteLettersWindow_Unify}" Command="{Binding UnifyCommand}"
              Classes="accent" MinWidth="80" />
      <Button x:Name="CloseButton" Content="{loc:Loc Common_Close}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="{loc:Loc FootnoteLettersWindow_Intro}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{loc:Loc FootnoteLettersWindow_Style}" VerticalAlignment="Center" />
        <ComboBox x:Name="StyleBox" ItemsSource="{x:Static vm:FootnoteLettersViewModel.Styles}" SelectedItem="{Binding Style}" MinWidth="140">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={x:Static infra:DisplayNameConverters.FootnoteLetterStyle}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" IsVisible="{Binding HasItems}">
        <Button Content="{loc:Loc FootnoteConversionWindow_SelectAll}" Command="{Binding SelectAllCommand}" />
        <Button Content="{loc:Loc FootnoteConversionWindow_SelectNone}" Command="{Binding SelectNoneCommand}" />
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{loc:Loc FootnoteLettersWindow_DoubleClickHint}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Text="{loc:Loc FootnoteLettersWindow_None}" IsVisible="{Binding !HasItems}" TextWrapping="Wrap" />
    </StackPanel>

    <Border BorderBrush="{DynamicResource SignetFrameBrush}" BorderThickness="1" IsVisible="{Binding HasItems}">
      <TreeDataGrid x:Name="Tree" />
    </Border>
  </DockPanel>
</Window>
