<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        xmlns:cv="using:Signet.App.CodeEditor"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:tabs="using:Signet.App.Views.Tabs"
        xmlns:views="using:Signet.App.Views"
        x:Class="Signet.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        infra:TooltipFonts.Area="PreferencesWindow"
        Title="{loc:Loc PreferencesWindow_Title}">

  <Window.Styles>
    <!-- A subtle separation of the section tree (left) from the page (right): the tree panel gets a dimmed
         background derived from the window background, and the page its own background and a thin border. Without
         this both parts are white and blend into a single plane. -->
    <Style Selector="Border.sectionPanel">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- The pages are the tabs of a TabControl whose tab strip is hidden: the section tree selects them. -->
    <Style Selector="TabControl.preferences /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The tab bars inside the pages (the Fonts tab of an Appearance section, the tabs of Spellcheck): the Fluent
         default is a 24 px header, far larger than the settings below it. -->
    <Style Selector="TabControl:not(.preferences) > TabItem">
      <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Top-level sections in bold, subsections in the normal weight (as in Rider). -->
    <Style Selector="TextBlock.topSection">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Close: only a frame, next to the filled (accent) Save button, as in Rider. -->
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TabControl.preferences /template/ ContentPresenter#PART_SelectedContentHost">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Sections inside a page as subtle cards (e.g. "Warnings"). -->
    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.listFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- Code Editor color fields: the background takes the color of the entered value, also on hover and when focused
         (Fluent then replaces the template border's background with its own). -->
    <Style Selector="TextBox.colorValue:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    </Style>
    <Style Selector="TextBox.colorValue:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    </Style>
    <!-- "Label + control" grids: 2/3 of the width for the (wrapping) label, 1/3 for the control
         stretched across the whole column — long labels do not hide under the fields. -->
    <Style Selector="Grid.labeled > TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.labeled > ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <DataTemplate x:Key="PreferencesSectionCellTemplate" x:DataType="vm:PreferencesSectionNode">
      <TextBlock Text="{Binding Title}" Classes.topSection="{Binding IsTopLevel}" VerticalAlignment="Center" Margin="2,3" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="10">

    <!-- Save / Close: Save (filled, enabled only with changes) writes the changes and keeps the window open; Close (a
         frame) closes it like the window's close button and Escape do: with unsaved changes it asks what to do with
         them. -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
      <Button Grid.Column="0" x:Name="OpenPreferencesLocationButton"
              Content="{loc:Loc PreferencesWindow_OpenPreferencesLocation}" Click="OnOpenPreferencesLocationClicked" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button x:Name="SaveButton" Content="{loc:Loc Common_Save}" Command="{Binding ApplyCommand}" Classes="accent"
                MinWidth="90" HorizontalContentAlignment="Center" />
        <Button x:Name="CloseButton" Content="{loc:Loc Common_Close}" Click="OnCloseClicked" Classes="outline"
                MinWidth="90" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- The splitter between the sections and the page moves; the window remembers the width (SplitterSizes). -->
    <Grid x:Name="Body">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="150" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>
      <!-- The sections as a tree with a search box: the search keeps the sections whose name or page text
           matches, and frames the matching controls on the page. -->
      <Border Grid.Column="0" Classes="sectionPanel">
        <DockPanel>
          <TextBox x:Name="SectionSearch" DockPanel.Dock="Top" Margin="6" PlaceholderText="{loc:Loc PreferencesWindow_Search}">
            <!-- A magnifying glass in front of the text, as in Rider. -->
            <TextBox.InnerLeftContent>
              <Path Data="M 6.5,1.5 A 5,5 0 1 1 6.5,11.5 A 5,5 0 1 1 6.5,1.5 M 10.2,10.2 L 14.5,14.5"
                    Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}" StrokeThickness="1.5"
                    Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button x:Name="ClearSectionSearchButton" Content="✕" Padding="6,2" Background="Transparent"
                      Focusable="False" Click="OnClearSectionSearchClicked"
                      IsVisible="{Binding #SectionSearch.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </TextBox.InnerRightContent>
          </TextBox>
          <TreeDataGrid x:Name="SectionTree" ShowColumnHeaders="False" />
        </DockPanel>
      </Border>

      <GridSplitter x:Name="SectionsSplitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <DockPanel Grid.Column="2">
        <TextBlock x:Name="Breadcrumb" DockPanel.Dock="Top" FontWeight="Bold" FontSize="15" Margin="4,2,0,8" />

    <TabControl x:Name="Pages" Classes="preferences">

      <!-- ================================ Language ================================ -->
      <TabItem Header="{loc:Loc PreferencesWindow_Language}">
        <StackPanel Spacing="10" Margin="8">
          <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_Language}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                      DisplayMemberBinding="{Binding DisplayName}" />
          </Grid>
          <TextBlock Text="{loc:Loc PreferencesWindow_LanguageRestartNotice}"
                     Opacity="0.7" FontStyle="Italic" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>















      <!-- ========================= Appearance and Behavior ========================= -->
      <!-- As in Rider, the section has no settings of its own: it lists its subsections. "Appearance" holds the theme of
           the interface and, one level down, the look and the fonts of every part of the application. The parts that also
           have behaviour (Code Editor, Preview, Footnotes) have a section of their own directly under it; the color
           scheme of the editors is under Code Editor. -->
      <TabItem x:Name="AppearancePage" Header="{loc:Loc PreferencesWindow_AppearanceAndBehavior}" />

      <!-- Appearance (Rider's page of the same name): the theme of the interface and the color scheme of the editors, each
           with its own list and gear; General: the icon theme, the compact interface; Fonts: the interface font, the size of
           the warnings in dialogs and the tooltip fonts of the parts without a section of their own; Interface Colors: the
           colors of the theme. The DataContexts of the theme and the scheme are set in code. -->
      <TabItem x:Name="AppearanceGeneralPage" Header="{loc:Loc PreferencesWindow_Appearance}" views:PreferencesPage.Parent="AppearancePage">
        <TabControl x:Name="AppearanceGeneralTabs">
          <TabItem Header="{loc:Loc PreferencesWindow_General}">
              <ScrollViewer>
                <StackPanel Spacing="10" Margin="8">

                  <Border Classes="section">
                    <StackPanel x:Name="ThemePanel" x:DataType="vm:ThemeDocumentViewModel" Spacing="10">
                      <views:ThemeSelectorView x:Name="ThemeSelector" />
                      <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc ColorScheme_Variant}" VerticalAlignment="Center" />
                        <ComboBox x:Name="VariantBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Variants}" SelectedItem="{Binding Variant}" DisplayMemberBinding="{Binding DisplayName}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc ColorScheme_IconSet}" VerticalAlignment="Center" />
                        <ComboBox x:Name="IconSetBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding IconSets}" SelectedItem="{Binding IconSet}" DisplayMemberBinding="{Binding DisplayName}" />
                      </Grid>
                      <TextBlock Text="{Binding BundledNote}" IsVisible="{Binding IsBundled}" Opacity="0.7" TextWrapping="Wrap" />
                      <TextBlock Text="{loc:Loc ColorScheme_IconSetNote}" Opacity="0.7" FontStyle="Italic" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <!-- The color scheme of the editors is chosen here as in Rider; its colors are edited under Code Editor. -->
                  <Border Classes="section">
                    <StackPanel Spacing="6">
                      <views:ThemeSelectorView x:Name="SchemeSelector" />
                      <HyperlinkButton Content="{loc:Loc PreferencesWindow_ColorsInScheme}" Padding="0"
                                       views:PreferencesPage.Target="ColorSchemePage" />
                    </StackPanel>
                  </Border>

                  <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_IconTheme}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableIconThemes}" SelectedItem="{Binding SelectedIconTheme}"
                              DisplayMemberBinding="{Binding DisplayName}" />
                  </Grid>

                  <CheckBox Content="{loc:Loc PreferencesWindow_CompactUi}" IsChecked="{Binding CompactUi}" />

            <CheckBox Content="{loc:Loc PreferencesWindow_ShowZoomHint}" IsChecked="{Binding ShowZoomHint}"
                      ToolTip.Tip="{loc:Loc PreferencesWindow_ShowZoomHintTip}" />

                  <CheckBox x:Name="PreferencesModalBox" Content="{loc:Loc PreferencesWindow_Modal}" IsChecked="{Binding PreferencesWindowModal}"
                            ToolTip.Tip="{loc:Loc PreferencesWindow_ModalTip}" />

                  <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_CustomIconFolder}" />
                    <TextBox Grid.Column="1" Text="{Binding CustomIconFolder}" />
                  </Grid>

                  <Button Content="{loc:Loc PreferencesWindow_RestoreAppearanceDefaults}" Command="{Binding RestoreAppearanceDefaultsCommand}"
                          HorizontalAlignment="Left" />

                </StackPanel>
              </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
            <views:FontsPageView x:Name="AppearanceFontsView" />
          </TabItem>
          <!-- The colors of the theme (warnings, error notifications, icons, …): the tree of its keys and the panel of the
               selected one. The DataContext is set in code. -->
          <TabItem x:Name="InterfaceColorsTab" Header="{loc:Loc PreferencesWindow_InterfaceColors}">
            <views:ThemeKeysView x:Name="ThemeInterfaceView" Margin="8" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- Appearance › StartScreen: the list of recent files (General, Fonts), with one preview panel for both tabs. -->
      <TabItem x:Name="StartScreenAppearancePage" Header="{loc:Loc PreferencesWindow_StartScreen}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <Grid x:Name="StartScreenPreviewHost">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="320" MinWidth="200" />
          </Grid.ColumnDefinitions>
          <TabControl x:Name="StartScreenAppearanceTabs">
            <TabItem Header="{loc:Loc PreferencesWindow_General}">
              <ScrollViewer>
                <StackPanel Spacing="10" Margin="8">
                  <Border Classes="section">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{loc:Loc PreferencesWindow_StartScreenRecentList}" FontWeight="Bold" />
                      <!-- The same setting as the number of recent files of the File menu (General › Behavior). -->
                      <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_StartScreenRecentFilesLimit}" />
                        <NumericUpDown x:Name="StartScreenRecentFilesLimitBox" Grid.Column="1" Value="{Binding RecentFilesLimit}"
                                       Minimum="0" Maximum="{x:Static vm:PreferencesViewModel.RecentFilesLimitMax}"
                                       Increment="1" FormatString="0" HorizontalAlignment="Left" Width="130" />
                      </Grid>
                      <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_StartScreenIndent}" />
                        <NumericUpDown x:Name="StartScreenIndentBox" Grid.Column="1" Value="{Binding StartScreenIndent}"
                                       Minimum="{x:Static vm:PreferencesViewModel.StartScreenIndentMin}"
                                       Maximum="{x:Static vm:PreferencesViewModel.StartScreenIndentMax}"
                                       Increment="1" FormatString="0" HorizontalAlignment="Left" Width="130" />
                      </Grid>
                      <HyperlinkButton Content="{loc:Loc PreferencesWindow_StartScreenTitleColorInTheme}" Padding="0"
                                       views:PreferencesPage.Target="AppearanceGeneralPage"
                                       views:PreferencesPage.TargetKey="ui.startScreen.title" />
                      <HyperlinkButton Content="{loc:Loc PreferencesWindow_StartScreenLocationColorInTheme}" Padding="0"
                                       views:PreferencesPage.Target="AppearanceGeneralPage"
                                       views:PreferencesPage.TargetKey="ui.startScreen.location" />
                      <HyperlinkButton Content="{loc:Loc PreferencesWindow_StartScreenHighlightInTheme}" Padding="0"
                                       views:PreferencesPage.Target="AppearanceGeneralPage"
                                       views:PreferencesPage.TargetKey="ui.startScreen.highlight" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
              <views:FontsPageView x:Name="StartScreenFontsView" HasSharedPreview="True" />
            </TabItem>
          </TabControl>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
          <!-- The preview, common to the tabs of the page: the real start screen with fabricated books, in the look the settings
               give it now (the unsaved ones too), and the sample of a tooltip under it. Not searched: it holds no settings. -->
          <Border x:Name="StartScreenPreviewPane" Grid.Column="2" Classes="section noSearchTree" Padding="8"
                  infra:TooltipFonts.Area="StartScreen">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:Loc PreferencesWindow_Preview}" FontWeight="Bold" Margin="0,0,0,6" />
              <Border Classes="listFrame">
                <Grid RowDefinitions="*,Auto">
                  <views:StartScreenView x:Name="StartScreenPreview" />
                  <views:TooltipSample x:Name="StartScreenSampleTip" Grid.Row="1" Margin="8" />
                </Grid>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Appearance › BookBrowser: which folders are expanded when a book is loaded; Fonts. -->
      <TabItem x:Name="BookBrowserAppearancePage" Header="{loc:Loc PreferencesWindow_BookBrowser}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <Grid x:Name="BookBrowserPreviewHost">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="320" MinWidth="200" />
          </Grid.ColumnDefinitions>
          <TabControl x:Name="BookBrowserAppearanceTabs">
            <TabItem Header="{loc:Loc PreferencesWindow_General}">
              <ScrollViewer>
                <StackPanel Spacing="10" Margin="8">
                  <Border Classes="section">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{loc:Loc PreferencesWindow_BookBrowserExpandOnLoad}" FontWeight="Bold" />
                      <ItemsControl ItemsSource="{Binding BookBrowserFolders}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FolderExpandOption">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- The look of the tree: the indentation of the files in a folder, the height of the rows and whether the file names show their folders. -->
                  <Border Classes="section">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{loc:Loc PreferencesWindow_BookBrowserTreeLook}" FontWeight="Bold" />
                      <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_BookBrowserIndent}" />
                        <NumericUpDown x:Name="BookBrowserIndentBox" Grid.Column="1" Value="{Binding BookBrowserIndent}"
                                       Minimum="{x:Static vm:PreferencesViewModel.BookBrowserIndentMin}"
                                       Maximum="{x:Static vm:PreferencesViewModel.BookBrowserIndentMax}"
                                       Increment="1" FormatString="0" HorizontalAlignment="Left" Width="130" />
                      </Grid>
                      <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_BookBrowserCellMinHeight}" />
                        <NumericUpDown x:Name="BookBrowserCellMinHeightBox" Grid.Column="1" Value="{Binding BookBrowserCellMinHeight}"
                                       Minimum="0"
                                       Maximum="{x:Static vm:PreferencesViewModel.BookBrowserCellMinHeightMax}"
                                       Increment="1" FormatString="0" HorizontalAlignment="Left" Width="130" />
                      </Grid>
                      <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_BookBrowserCellPadding}" />
                        <NumericUpDown x:Name="BookBrowserCellPaddingBox" Grid.Column="1" Value="{Binding BookBrowserCellPadding}"
                                       Minimum="0"
                                       Maximum="{x:Static vm:PreferencesViewModel.BookBrowserCellPaddingMax}"
                                       Increment="1" FormatString="0" HorizontalAlignment="Left" Width="130" />
                      </Grid>
                      <CheckBox x:Name="BookBrowserShowFoldersBox" Content="{loc:Loc PreferencesWindow_BookBrowserShowFolders}"
                                IsChecked="{Binding BookBrowserShowFolders}" ToolTip.Tip="{loc:Loc PreferencesWindow_BookBrowserShowFoldersTip}" />
                      <HyperlinkButton Content="{loc:Loc PreferencesWindow_BookBrowserBackgroundInTheme}" Padding="0"
                                       views:PreferencesPage.Target="AppearanceGeneralPage"
                                       views:PreferencesPage.TargetKey="ui.bookBrowser.background" />
                      <HyperlinkButton Content="{loc:Loc PreferencesWindow_BookBrowserSelectionInTheme}" Padding="0"
                                       views:PreferencesPage.Target="AppearanceGeneralPage"
                                       views:PreferencesPage.TargetKey="ui.bookBrowser.selection" />

                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
              <views:FontsPageView x:Name="BookBrowserFontsView" HasSharedPreview="True" />
            </TabItem>
          </TabControl>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
          <!-- The preview, common to the tabs of the page: the real Book Browser over a sample book, in the look the settings
               give it now (the unsaved ones too); the sample of a tooltip is under it. Not searched: it holds no settings. -->
          <Border x:Name="BookBrowserPreviewPane" Grid.Column="2" Classes="section noSearchTree" Padding="8"
                  infra:TooltipFonts.Area="BookBrowser">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:Loc PreferencesWindow_Preview}" FontWeight="Bold" Margin="0,0,0,6" />
              <!-- The tooltip of a file, drawn in the empty space under the tree and always there (a real one shows only while the
                   pointer rests on a file): its font follows the tooltip font setting as it is changed. -->
              <Border Classes="listFrame">
                <Grid RowDefinitions="*,Auto">
                  <views:BookBrowserView x:Name="BookBrowserPreview" />
                  <views:TooltipSample x:Name="BookBrowserSampleTip" Grid.Row="1" Margin="8" />
                </Grid>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Appearance › TableOfContents: Fonts only. -->
      <TabItem x:Name="TableOfContentsAppearancePage" Header="{loc:Loc PreferencesWindow_TableOfContents}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <TabControl x:Name="TableOfContentsAppearanceTabs">
          <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
            <views:FontsPageView x:Name="TableOfContentsFontsView" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- Appearance › CodeEditor: what the editor looks like (General, Fonts), with one preview panel for both tabs: the
           document tabs and the editor itself. -->
      <TabItem x:Name="CodeEditorAppearancePage" Header="{loc:Loc PreferencesWindow_CodeEditor}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <Grid x:Name="CodeEditorPreviewHost">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="380" MinWidth="240" />
          </Grid.ColumnDefinitions>
          <TabControl x:Name="CodeEditorAppearanceTabs">
            <TabItem Header="{loc:Loc PreferencesWindow_General}">
              <ScrollViewer>
                <StackPanel Spacing="10" Margin="8">
                  <Border Classes="section">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{loc:Loc PreferencesWindow_CodeEditorLook}" FontWeight="Bold" />
                      <CheckBox x:Name="ExtendedHighlightingBox" Content="{loc:Loc PreferencesWindow_ExtendedHighlighting}"
                                IsChecked="{Binding ExtendedHighlighting}" />
                      <!-- The document tabs: several rows when they do not fit. -->
                      <CheckBox x:Name="MultilineTabsBox" Content="{loc:Loc PreferencesWindow_MultilineTabs}" IsChecked="{Binding MultilineTabs}" />
                      <!-- The colors of the editor and of the hint are in the color scheme, the colors of the tabs in the theme. -->
                      <HyperlinkButton Content="{loc:Loc PreferencesWindow_ColorsInScheme}" Padding="0"
                                       views:PreferencesPage.Target="ColorSchemePage" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
              <views:FontsPageView x:Name="CodeEditorFontsView" HasSharedPreview="True" />
            </TabItem>
          </TabControl>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
          <!-- The preview, common to the tabs of the page: the tabs of the documents and the real Code Editor tab over a
               chapter of the sample book, in the look the settings give them now (the unsaved ones too), and the opening tag
               hint (which a real one shows only over a closing tag) under it. Not searched: it holds no settings. -->
          <Border x:Name="CodeEditorPreviewPane" Grid.Column="2" Classes="section noSearchTree" Padding="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:Loc PreferencesWindow_Preview}" FontWeight="Bold" Margin="0,0,0,6" />
              <Border Classes="listFrame">
                <DockPanel>
                  <views:DocumentTabsSample x:Name="DocumentTabsPreview" DockPanel.Dock="Top" Margin="4,4,4,0" />
                  <views:TooltipSample x:Name="CodeEditorSampleHint" DockPanel.Dock="Bottom" Margin="8" />
                  <tabs:CodeTabView x:Name="CodeEditorPreview" />
                </DockPanel>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Appearance › Preview: the highlight of the caret location; Fonts: the preview fonts. -->
      <TabItem x:Name="PreviewAppearancePage" Header="{loc:Loc PreferencesWindow_Preview}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <TabControl x:Name="PreviewAppearanceTabs">
          <TabItem Header="{loc:Loc PreferencesWindow_Preview}">
              <ScrollViewer>
                <StackPanel Spacing="10" Margin="8">
                  <Border Classes="section">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{loc:Loc PreferencesWindow_PreviewHighlight}" FontWeight="Bold" />
                      <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewHighlightStyle}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePreviewHighlightStyles}" SelectedItem="{Binding PreviewHighlightStyle}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Converter={x:Static infra:DisplayNameConverters.PreviewHighlightStyle}}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- The color of the highlight is in the color scheme (preview.highlight). -->
                        <HyperlinkButton Content="{loc:Loc PreferencesWindow_ColorsInScheme}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="0"
                                         views:PreferencesPage.Target="ColorSchemePage" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewHighlightOpacity}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   IsEnabled="{Binding IsPreviewHighlightBackground}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PreviewHighlightOpacity}" Width="80" HorizontalAlignment="Left"
                                 IsEnabled="{Binding IsPreviewHighlightBackground}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewHighlightOutlineWidth}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   IsEnabled="{Binding IsPreviewHighlightOutline}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PreviewHighlightOutlineWidth}" Width="80" HorizontalAlignment="Left"
                                 IsEnabled="{Binding IsPreviewHighlightOutline}" />

                        <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="{loc:Loc PreferencesWindow_PreviewHighlightAutoHide}"
                                  IsChecked="{Binding PreviewHighlightAutoHide}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewHighlightAutoHideDelay}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   IsEnabled="{Binding PreviewHighlightAutoHide}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PreviewHighlightAutoHideDelay}" Width="80" HorizontalAlignment="Left"
                                 IsEnabled="{Binding PreviewHighlightAutoHide}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
            <views:FontsPageView x:Name="PreviewFontsView" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- Appearance › FindReplace: Fonts only. -->
      <TabItem x:Name="FindReplaceAppearancePage" Header="{loc:Loc PreferencesWindow_FindReplace}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <Grid x:Name="FindReplacePreviewHost">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="8" />
            <RowDefinition Height="230" MinHeight="120" />
          </Grid.RowDefinitions>
          <TabControl x:Name="FindReplaceAppearanceTabs">
            <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
              <views:FontsPageView x:Name="FindReplaceFontsView" HasSharedPreview="True" />
            </TabItem>
          </TabControl>
          <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" />
          <!-- The preview: the real Find and Replace panel (wide, so it is under the settings) with no book behind it, and a sample of its tooltip. Not searched: it holds no settings. -->
          <Border x:Name="FindReplacePreviewPane" Grid.Row="2" Classes="section noSearchTree" Padding="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:Loc PreferencesWindow_Preview}" FontWeight="Bold" Margin="0,0,0,6" />
              <Border Classes="listFrame">
                <Grid RowDefinitions="*,Auto">
                  <views:FindReplaceView x:Name="FindReplacePreview" />
                  <views:TooltipSample x:Name="FindReplaceSampleTip" Grid.Row="1" Margin="8" />
                </Grid>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Appearance › SpecialCharacters: Fonts only. -->
      <TabItem x:Name="SpecialCharactersAppearancePage" Header="{loc:Loc PreferencesWindow_SpecialCharacters}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <Grid x:Name="SpecialCharactersPreviewHost">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="8" />
            <RowDefinition Height="300" MinHeight="120" />
          </Grid.RowDefinitions>
          <TabControl x:Name="SpecialCharactersAppearanceTabs">
            <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
              <views:FontsPageView x:Name="SpecialCharacterFontsView" HasSharedPreview="True" />
            </TabItem>
          </TabControl>
          <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" />
          <!-- The preview: the "Insert Special Character" window (wide, so it is under the settings) with a few characters, and a sample of its tooltip. Not searched: it holds no settings. -->
          <Border x:Name="SpecialCharactersPreviewPane" Grid.Row="2" Classes="section noSearchTree" Padding="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:Loc PreferencesWindow_Preview}" FontWeight="Bold" Margin="0,0,0,6" />
              <Border Classes="listFrame">
                <Grid RowDefinitions="*,Auto">
                  <views:SpecialCharactersSample x:Name="SpecialCharactersPreview" />
                  <views:TooltipSample x:Name="SpecialCharactersSampleTip" Grid.Row="1" Margin="8" />
                </Grid>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Appearance › Checkpoints: Fonts only. -->
      <TabItem x:Name="CheckpointsAppearancePage" Header="{loc:Loc PreferencesWindow_Checkpoints}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <TabControl x:Name="CheckpointsAppearanceTabs">
          <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
            <views:FontsPageView x:Name="CheckpointsFontsView" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- Appearance › Validation: Fonts only. -->
      <TabItem x:Name="ValidationAppearancePage" Header="{loc:Loc PreferencesWindow_Validation}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <TabControl x:Name="ValidationAppearanceTabs">
          <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
            <views:FontsPageView x:Name="ValidationFontsView" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- Appearance › MetadataEditor: Fonts only. -->
      <TabItem x:Name="MetadataEditorAppearancePage" Header="{loc:Loc PreferencesWindow_MetadataEditor}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <TabControl x:Name="MetadataEditorAppearanceTabs">
          <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
            <views:FontsPageView x:Name="MetadataEditorFontsView" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- Appearance › Cleanup: Fonts only. -->
      <TabItem x:Name="CleanupAppearancePage" Header="{loc:Loc PreferencesWindow_Cleanup}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <TabControl x:Name="CleanupAppearanceTabs">
          <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
            <views:FontsPageView x:Name="CleanupFontsView" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- Appearance › Footnotes: Fonts only. -->
      <TabItem x:Name="FootnotesAppearancePage" Header="{loc:Loc PreferencesWindow_Footnotes}" views:PreferencesPage.Parent="AppearanceGeneralPage">
        <TabControl x:Name="FootnotesAppearanceTabs">
          <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
            <views:FontsPageView x:Name="FootnotesFontsView" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- ============================== Code Editor ============================== -->
      <!-- The behaviour of Code Editor: highlighting and the opening tag hint. Its look is under Appearance; its color
           scheme is the subsection below. -->
      <TabItem x:Name="CodeEditorPage" Header="{loc:Loc PreferencesWindow_CodeEditor}" views:PreferencesPage.Parent="AppearancePage">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8">
            <!-- The Book Browser follows the active document tab (the look of the tabs and of the editor is under Appearance). -->
            <CheckBox x:Name="BookBrowserFollowsTabBox" Content="{loc:Loc PreferencesWindow_BookBrowserFollowsTab}"
                      IsChecked="{Binding BookBrowserFollowsActiveTab}" />

            <!-- Code Editor: the opening tag tooltip over a closing tag, with its delay. -->
            <CheckBox Content="{loc:Loc PreferencesWindow_OpenTagHint}" IsChecked="{Binding OpenTagHint}" />
            <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8" Margin="28,0,0,0">
              <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_OpenTagHintDelay}" IsEnabled="{Binding OpenTagHint}" />
              <TextBox Grid.Column="1" Text="{Binding OpenTagHintDelay}" Width="80" HorizontalAlignment="Left"
                       IsEnabled="{Binding OpenTagHint}" />
            </Grid>

            <!-- The colors of the editor and of the hint are in the color scheme (its section is below), their fonts are under Appearance. -->
            <HyperlinkButton Content="{loc:Loc PreferencesWindow_ColorsInScheme}" Padding="0"
                             views:PreferencesPage.Target="ColorSchemePage" />

            <TextBlock Text="{loc:Loc PreferencesWindow_FontColorRestartNotice}"
                       IsVisible="{Binding RestartNoticeVisible}" Opacity="0.7" FontStyle="Italic" TextWrapping="Wrap" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Code Editor › Color Scheme (Rider's Editor › Color Scheme): the color scheme in use and the actions on schemes (the
           gear, as Rider's scheme actions). The DataContext is set in code (a binding on the content of a page that is
           not shown does not resolve). -->
      <TabItem x:Name="ColorSchemePage" Header="{loc:Loc PreferencesWindow_ColorScheme}" views:PreferencesPage.Parent="CodeEditorPage">
        <ScrollViewer>
          <StackPanel x:Name="ColorSchemePanel" x:DataType="vm:ThemeDocumentViewModel" Spacing="10" Margin="8">
            <views:ThemeSelectorView x:Name="ColorSchemeSelector" />

            <TextBlock Text="{Binding BundledNote}" IsVisible="{Binding IsBundled}" Opacity="0.7" TextWrapping="Wrap" />

            <!-- The font of the code previews of the pages below (a setting of the program, not of the scheme); the
                 DataContext is set in code. -->
            <views:FontSettingView x:Name="ColorSchemePreviewFontView" Margin="0,8,0,0" Width="420" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Code Editor › Color Scheme › <area>: the keys of the color scheme by area (ThemePage), each page with the tree of
           its keys and the panel of the selected one. The DataContexts are set in code, like the Fonts tabs. -->
      <TabItem x:Name="ThemeGeneralPage" Header="{loc:Loc PreferencesWindow_General}" views:PreferencesPage.Parent="ColorSchemePage">
        <views:ThemeKeysView x:Name="ThemeGeneralView" Margin="8" />
      </TabItem>
      <TabItem x:Name="ThemeXhtmlPage" Header="{loc:Loc PreferencesWindow_ThemeXhtml}" views:PreferencesPage.Parent="ColorSchemePage">
        <views:ThemeKeysView x:Name="ThemeXhtmlView" Margin="8" />
      </TabItem>
      <TabItem x:Name="ThemeCssPage" Header="{loc:Loc PreferencesWindow_ThemeCss}" views:PreferencesPage.Parent="ColorSchemePage">
        <views:ThemeKeysView x:Name="ThemeCssView" Margin="8" />
      </TabItem>
      <TabItem x:Name="ThemeJavaScriptJsonPage" Header="{loc:Loc PreferencesWindow_ThemeJavaScriptJson}" views:PreferencesPage.Parent="ColorSchemePage">
        <views:ThemeKeysView x:Name="ThemeJavaScriptJsonView" Margin="8" />
      </TabItem>
      <TabItem x:Name="ThemeDiffPage" Header="{loc:Loc PreferencesWindow_ThemeDiff}" views:PreferencesPage.Parent="ColorSchemePage">
        <views:ThemeKeysView x:Name="ThemeDiffView" Margin="8" />
      </TabItem>
      <TabItem x:Name="ThemePreviewPage" Header="{loc:Loc PreferencesWindow_Preview}" views:PreferencesPage.Parent="ColorSchemePage">
        <views:ThemeKeysView x:Name="ThemePreviewView" Margin="8" />
      </TabItem>


      <!-- ================================ Preview ================================ -->
      <TabItem x:Name="PreviewPage" Header="{loc:Loc PreferencesWindow_Preview}" views:PreferencesPage.Parent="AppearancePage">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8">

            <!-- The look of the preview (the highlight of the caret location, the fonts) is under Appearance; its colors in the color scheme. -->
            <HyperlinkButton x:Name="PreviewAppearanceLink" Content="{loc:Loc PreferencesWindow_Appearance}" Padding="0"
                             views:PreferencesPage.Target="PreviewAppearancePage" />

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_PreviewLiveRefresh}" FontWeight="Bold" />
                <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewRefreshDelay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBox Grid.Column="1" Text="{Binding PreviewRefreshDelay}" Width="80" HorizontalAlignment="Left" />
                </Grid>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>


      <!-- ============================ Find Usages Window ============================ -->
      <!-- The "Find Usages" panel (the usages of a class, the matches of "Count All"). The wrapping of the rows and the
           grouping are buttons of the panel itself. General: the width of the first column; Fonts: the column headers, the
           "Context" column and the other cells. -->
      <TabItem x:Name="FindUsagesPage" Header="{loc:Loc PreferencesWindow_FindUsagesWindow}" views:PreferencesPage.Parent="AppearancePage">
        <Grid x:Name="FindUsagesPreviewHost">
          <!-- The window of the usages is wide, so its preview is under the settings, not at their right. -->
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="170" />
            <RowDefinition Height="8" />
            <RowDefinition Height="250" MinHeight="140" />
          </Grid.RowDefinitions>
          <TabControl x:Name="FindUsagesTabs">
            <TabItem Header="{loc:Loc PreferencesWindow_General}">
              <ScrollViewer>
                <StackPanel Spacing="10" Margin="8">
                  <Border Classes="section">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{loc:Loc PreferencesWindow_FindUsagesColumns}" FontWeight="Bold" />
                      <StackPanel Spacing="2">
                        <CheckBox x:Name="FindUsagesFitUsageColumnBox" Content="{loc:Loc PreferencesWindow_FindUsagesFitUsageColumn}"
                                  IsChecked="{Binding FindUsagesFitUsageColumn}" />
                        <TextBlock Text="{loc:Loc PreferencesWindow_FindUsagesFitUsageColumnHint}" TextWrapping="Wrap" Opacity="0.75"
                                   Margin="28,0,0,0" />
                      </StackPanel>
                      <!-- The background of each column is a color of the theme (ui.findUsages.*.background). -->
                      <HyperlinkButton Content="{loc:Loc PreferencesWindow_FindUsagesBackgroundInTheme}" Padding="0"
                                       views:PreferencesPage.Target="AppearanceGeneralPage"
                                       views:PreferencesPage.TargetKey="ui.findUsages.usage.background" />
                    </StackPanel>
                  </Border>

                  <Border Classes="section">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{loc:Loc PreferencesWindow_FindUsagesRows}" FontWeight="Bold" />
                      <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_FindUsagesRowSpacing}" />
                        <NumericUpDown x:Name="FindUsagesRowSpacingBox" Grid.Column="1" Value="{Binding FindUsagesRowSpacing}"
                                       Minimum="0" Maximum="{x:Static vm:PreferencesViewModel.FindUsagesRowSpacingMax}"
                                       Increment="1" FormatString="0" HorizontalAlignment="Left" Width="130" />
                      </Grid>
                      <TextBlock Text="{loc:Loc PreferencesWindow_FindUsagesRowSpacingHint}" TextWrapping="Wrap" Opacity="0.75" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc PreferencesWindow_Fonts}">
              <views:FontsPageView x:Name="FindUsagesFontsView" HasSharedPreview="True" />
            </TabItem>
          </TabControl>
          <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" />
          <!-- The preview, common to the tabs of the page: the real Find Usages panel over fabricated usages, in the look the
               settings give it now (the unsaved ones too). Not searched: it holds no settings. -->
          <Border x:Name="FindUsagesPreviewPane" Grid.Row="2" Classes="section noSearchTree" Padding="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:Loc PreferencesWindow_Preview}" FontWeight="Bold" Margin="0,0,0,6" />
              <Border Classes="listFrame">
                <views:FindUsagesView x:Name="FindUsagesPreview" />
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- =============================== Footnotes =============================== -->
      <!-- General: how the footnote operations behave; CSS: the CSS of Signet's footnote classes (FootnoteStyles),
           written to the book on every footnote operation. -->
      <TabItem x:Name="FootnotesPage" Header="{loc:Loc PreferencesWindow_Footnotes}" views:PreferencesPage.Parent="AppearancePage">
        <TabControl x:Name="FootnotesTabs">
          <TabItem x:Name="FootnotesGeneralTab" Header="{loc:Loc PreferencesWindow_FootnotesGeneralTab}">
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="8">
                <CheckBox x:Name="ConfirmFootnoteRemovalBox" Content="{loc:Loc PreferencesWindow_ConfirmFootnoteRemoval}"
                          IsChecked="{Binding ConfirmFootnoteRemoval}" />
                <StackPanel Spacing="2">
                  <CheckBox x:Name="FootnoteGroupByChapterBox" Content="{loc:Loc PreferencesWindow_FootnoteGroupByChapter}"
                            IsChecked="{Binding FootnoteGroupByChapter}" />
                  <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteGroupByChapterHint}" TextWrapping="Wrap" Opacity="0.75"
                             Margin="28,0,0,0" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteLetterStyle}" VerticalAlignment="Center" />
                    <ComboBox x:Name="FootnoteLetterStyleBox" Grid.Column="1" MinWidth="160"
                              ItemsSource="{Binding AvailableFootnoteLetterStyles}" SelectedItem="{Binding FootnoteLetterStyle}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={x:Static infra:DisplayNameConverters.FootnoteLetterStyle}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                  <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteLetterStyleHint}" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="FootnotesCssTab" Header="{loc:Loc PreferencesWindow_FootnotesCssTab}">
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="8">
                <TextBlock Text="{loc:Loc PreferencesWindow_FootnotesIntro}" TextWrapping="Wrap" Opacity="0.75" />
                <StackPanel Spacing="4">
                  <WrapPanel>
                    <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteReferenceStyle}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBlock x:Name="FootnoteReferenceStyleError" Text="{Binding FootnoteReferenceStyleError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding FootnoteReferenceStyleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </WrapPanel>
                  <Grid RowDefinitions="Auto,Auto">
                    <cv:CssEditor x:Name="FootnoteReferenceStyleBox" CssText="{Binding FootnoteReferenceStyle, Mode=TwoWay}"
                             Height="{x:Static views:PreferencesWindow.DefaultFieldHeight}"
                             BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    <views:HeightResizeGrip Grid.Row="1" Target="{Binding #FootnoteReferenceStyleBox}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <WrapPanel>
                    <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteNoteStyle}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBlock x:Name="FootnoteNoteStyleError" Text="{Binding FootnoteNoteStyleError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding FootnoteNoteStyleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </WrapPanel>
                  <Grid RowDefinitions="Auto,Auto">
                    <cv:CssEditor x:Name="FootnoteNoteStyleBox" CssText="{Binding FootnoteNoteStyle, Mode=TwoWay}"
                             Height="{x:Static views:PreferencesWindow.DefaultFieldHeight}"
                             BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    <views:HeightResizeGrip Grid.Row="1" Target="{Binding #FootnoteNoteStyleBox}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <WrapPanel>
                    <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteParagraphStyle}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBlock x:Name="FootnoteParagraphStyleError" Text="{Binding FootnoteParagraphStyleError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding FootnoteParagraphStyleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </WrapPanel>
                  <Grid RowDefinitions="Auto,Auto">
                    <cv:CssEditor x:Name="FootnoteParagraphStyleBox" CssText="{Binding FootnoteParagraphStyle, Mode=TwoWay}"
                             Height="{x:Static views:PreferencesWindow.DefaultFieldHeight}"
                             BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    <views:HeightResizeGrip Grid.Row="1" Target="{Binding #FootnoteParagraphStyleBox}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <WrapPanel>
                    <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteLocalContainerStyle}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBlock x:Name="FootnoteLocalContainerStyleError" Text="{Binding FootnoteLocalContainerStyleError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding FootnoteLocalContainerStyleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </WrapPanel>
                  <Grid RowDefinitions="Auto,Auto">
                    <cv:CssEditor x:Name="FootnoteLocalContainerStyleBox" CssText="{Binding FootnoteLocalContainerStyle, Mode=TwoWay}"
                             Height="{x:Static views:PreferencesWindow.DefaultFieldHeight}"
                             BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    <views:HeightResizeGrip Grid.Row="1" Target="{Binding #FootnoteLocalContainerStyleBox}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <WrapPanel>
                    <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteGlobalContainerStyle}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBlock x:Name="FootnoteGlobalContainerStyleError" Text="{Binding FootnoteGlobalContainerStyleError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding FootnoteGlobalContainerStyleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </WrapPanel>
                  <Grid RowDefinitions="Auto,Auto">
                    <cv:CssEditor x:Name="FootnoteGlobalContainerStyleBox" CssText="{Binding FootnoteGlobalContainerStyle, Mode=TwoWay}"
                             Height="{x:Static views:PreferencesWindow.DefaultFieldHeight}"
                             BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    <views:HeightResizeGrip Grid.Row="1" Target="{Binding #FootnoteGlobalContainerStyleBox}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <WrapPanel>
                    <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteSeparatorStyle}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBlock x:Name="FootnoteSeparatorStyleError" Text="{Binding FootnoteSeparatorStyleError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding FootnoteSeparatorStyleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </WrapPanel>
                  <Grid RowDefinitions="Auto,Auto">
                    <cv:CssEditor x:Name="FootnoteSeparatorStyleBox" CssText="{Binding FootnoteSeparatorStyle, Mode=TwoWay}"
                             Height="{x:Static views:PreferencesWindow.DefaultFieldHeight}"
                             BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    <views:HeightResizeGrip Grid.Row="1" Target="{Binding #FootnoteSeparatorStyleBox}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <WrapPanel>
                    <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteGroupStyle}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBlock x:Name="FootnoteGroupStyleError" Text="{Binding FootnoteGroupStyleError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding FootnoteGroupStyleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </WrapPanel>
                  <Grid RowDefinitions="Auto,Auto">
                    <cv:CssEditor x:Name="FootnoteGroupStyleBox" CssText="{Binding FootnoteGroupStyle, Mode=TwoWay}"
                             Height="{x:Static views:PreferencesWindow.DefaultFieldHeight}"
                             BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    <views:HeightResizeGrip Grid.Row="1" Target="{Binding #FootnoteGroupStyleBox}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <WrapPanel>
                    <TextBlock Text="{loc:Loc PreferencesWindow_FootnoteGroupTitleStyle}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBlock x:Name="FootnoteGroupTitleStyleError" Text="{Binding FootnoteGroupTitleStyleError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding FootnoteGroupTitleStyleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </WrapPanel>
                  <Grid RowDefinitions="Auto,Auto">
                    <cv:CssEditor x:Name="FootnoteGroupTitleStyleBox" CssText="{Binding FootnoteGroupTitleStyle, Mode=TwoWay}"
                             Height="{x:Static views:PreferencesWindow.DefaultFieldHeight}"
                             BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    <views:HeightResizeGrip Grid.Row="1" Target="{Binding #FootnoteGroupTitleStyleBox}" />
                  </Grid>
                </StackPanel>
                <Button x:Name="ResetFootnoteStylesButton" Content="{loc:Loc PreferencesWindow_FootnoteStylesReset}"
                        Command="{Binding ResetFootnoteStylesCommand}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- ================================ General ================================ -->
      <TabItem Header="{loc:Loc PreferencesWindow_General}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8">
            <CheckBox Content="{loc:Loc PreferencesWindow_DefaultEpub3}" IsChecked="{Binding DefaultVersionIsEpub3}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_MendOnOpen}" IsChecked="{Binding MendOnOpen}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_MendOnSave}" IsChecked="{Binding MendOnSave}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_ReopenLastFile}" IsChecked="{Binding ReopenLastFileOnStartup}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_EnableFileDropZone}" IsChecked="{Binding FileDropZoneEnabled}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_AutoCloseTags}" IsChecked="{Binding AutoCloseTags}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_PasteNormalizeNfc}" IsChecked="{Binding PasteNormalizeNfc}"
                      ToolTip.Tip="{loc:Loc PreferencesWindow_PasteNormalizeNfcTip}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_FindUsagesRefreshOnSave}" IsChecked="{Binding FindUsagesRefreshOnSave}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_NavigationHistoryRemember}" IsChecked="{Binding NavigationHistoryRemember}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsEnabled="{Binding NavigationHistoryRemember}">
              <TextBlock Text="{loc:Loc PreferencesWindow_NavigationHistoryDays}" VerticalAlignment="Center" />
              <TextBox Text="{Binding NavigationHistoryDays}" Width="80" />
            </StackPanel>

            <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,6,0,0">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_ClipboardHistoryLimit}" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ClipboardHistoryLimit}" Width="80" HorizontalAlignment="Left" />

              <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc PreferencesWindow_RecentFilesLimit}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RecentFilesLimit}" Width="80" HorizontalAlignment="Left" />

              <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc PreferencesWindow_RecentLocationsLimit}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding RecentLocationsLimit}" Width="80" HorizontalAlignment="Left" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc PreferencesWindow_TempFolder}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TempFolderHome}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc PreferencesWindow_ExternalXEditorPath}" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExternalXEditorPath}" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc PreferencesWindow_CssEpub2Profile}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableCssValidationSpecs}"
                        SelectedItem="{Binding CssEpub2ValidationSpec}" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc PreferencesWindow_CssEpub3Profile}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AvailableCssValidationSpecs}"
                        SelectedItem="{Binding CssEpub3ValidationSpec}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- =============================== Edition page =============================== -->
      <!-- The page Signet adds to the book on the first save after opening it (EditionPage): removing it from the open book right away,
           then the settings (shared by all books), enabled only while the page is switched on. -->
      <TabItem Header="{loc:Loc PreferencesWindow_EditionPage}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8">
            <TextBlock Text="{loc:Loc PreferencesWindow_EditionPageIntro}" TextWrapping="Wrap" Opacity="0.75" />

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="danger" x:Name="RemoveEditionPageButton" Content="{loc:Loc PreferencesWindow_EditionPageRemove}"
                      Command="{Binding RemoveEditionPageCommand}" />
              <TextBlock Text="{Binding EditionPageStatus}" VerticalAlignment="Center" Opacity="0.75" />
            </StackPanel>

            <CheckBox x:Name="EditionPageEnabledBox" Content="{loc:Loc PreferencesWindow_EditionPageEnabled}"
                      IsChecked="{Binding EditionPageEnabled}" />

            <StackPanel x:Name="EditionPageOptions" Spacing="10" Margin="28,0,0,0" IsEnabled="{Binding EditionPageEnabled}">
              <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_EditionPagePosition}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableEditionPagePositions}"
                          SelectedItem="{Binding EditionPagePosition}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={x:Static infra:DisplayNameConverters.EditionPagePosition}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc PreferencesWindow_EditionPageTitle}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditionPageTitle}"
                         PlaceholderText="{loc:Loc PreferencesWindow_EditionPageTitlePlaceholder}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc PreferencesWindow_EditionPageHeadingLevel}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding EditionPageHeadingLevels}"
                          SelectedItem="{Binding EditionPageHeadingLevel}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:HeadingLevelOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <CheckBox Content="{loc:Loc PreferencesWindow_EditionPageAddToToc}" IsChecked="{Binding EditionPageAddToToc}" />

              <!-- The table fields: the user's rows (editable, removable), then the two fixed rows — revision and save
                   date — which can only be shown or hidden. -->
              <Border Classes="section">
                <StackPanel Spacing="4">
                  <TextBlock Text="{loc:Loc PreferencesWindow_EditionPageFields}" FontWeight="Bold" />
                  <Grid ColumnDefinitions="60,*,2*,80" ColumnSpacing="6" Opacity="0.75">
                    <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_EditionPageShow}" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc PreferencesWindow_EditionPageKey}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc PreferencesWindow_EditionPageValue}" />
                  </Grid>
                  <ItemsControl x:Name="EditionPageFieldList" ItemsSource="{Binding EditionPageFields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:EditionPageFieldRow">
                        <Grid ColumnDefinitions="60,*,2*,80" Margin="0,2" ColumnSpacing="6">
                          <CheckBox Grid.Column="0" IsChecked="{Binding Show}" HorizontalAlignment="Center" />
                          <TextBox Grid.Column="1" Text="{Binding Key}" />
                          <TextBox Grid.Column="2" Text="{Binding Value}" />
                          <Button Classes="danger" Grid.Column="3" Content="{loc:Loc Common_Remove}" Command="{Binding RemoveCommand}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="60,*,2*,80" Margin="0,2" ColumnSpacing="6">
                    <CheckBox Grid.Column="0" IsChecked="{Binding EditionPageShowProgram}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc PreferencesWindow_EditionPageProgram}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Signet" VerticalAlignment="Center" Opacity="0.75" />
                  </Grid>
                  <Grid ColumnDefinitions="60,*,2*,80" Margin="0,2" ColumnSpacing="6">
                    <CheckBox Grid.Column="0" IsChecked="{Binding EditionPageShowVersion}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc PreferencesWindow_EditionPageVersion}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding EditionPageProgramVersion}" VerticalAlignment="Center" Opacity="0.75" />
                  </Grid>
                  <Grid ColumnDefinitions="60,*,2*,80" Margin="0,2" ColumnSpacing="6">
                    <CheckBox Grid.Column="0" IsChecked="{Binding EditionPageShowRevision}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc PreferencesWindow_EditionPageRevision}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc PreferencesWindow_EditionPageRevisionValue}" VerticalAlignment="Center" Opacity="0.75" />
                  </Grid>
                  <Grid ColumnDefinitions="60,*,2*,80" Margin="0,2" ColumnSpacing="6">
                    <CheckBox Grid.Column="0" IsChecked="{Binding EditionPageShowDate}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc PreferencesWindow_EditionPageDate}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc PreferencesWindow_EditionPageDateValue}" VerticalAlignment="Center" Opacity="0.75" />
                  </Grid>
                  <Button Content="{loc:Loc Common_Add}" Command="{Binding AddEditionPageFieldCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                  <TextBlock Text="{loc:Loc PreferencesWindow_EditionPageFixedNote}" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================= Mend & Prettify ============================= -->
      <!-- Mend and Prettify are separate operations, so each has its own box of options. -->
      <TabItem Header="{loc:Loc PreferencesWindow_MendPrettify}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8">
            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_PrettifySection}" FontWeight="Bold" />
                <CheckBox Content="{loc:Loc PreferencesWindow_PrettifyAddMissingDoctype}" IsChecked="{Binding PrettifyAddMissingDoctype}" />
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_MendSection}" FontWeight="Bold" />
                <CheckBox Content="{loc:Loc PreferencesWindow_MendAddMissingDoctype}" IsChecked="{Binding MendAddMissingDoctype}" />
                <CheckBox Content="{loc:Loc PreferencesWindow_MendShowDiff}" IsChecked="{Binding MendShowDiff}" />
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_DoctypeWarningsSection}" FontWeight="Bold" />
                <CheckBox Content="{loc:Loc PreferencesWindow_WarnMissingDoctype}" IsChecked="{Binding WarnMissingDoctype}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- =============================== Spellcheck =============================== -->
      <!-- Layout: Hunspell dictionaries and options at the top, below them the tabs
           "user dictionaries" (Add/Rename/Copy/Delete + a list with an enable toggle)
           and the "word list" of the selected dictionary; the selected dictionary is also the default one. -->
      <TabItem Header="{loc:Loc PreferencesWindow_Spellcheck}">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Spacing="10">
            <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PrimaryDictionary}" />
              <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PrimaryDictionaryBox"
                        ItemsSource="{Binding AvailableDictionaries}"
                        SelectedItem="{Binding SelectedPrimaryDictionary}"
                        DisplayMemberBinding="{Binding DisplayName, DataType=vm:DictionaryOption}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc PreferencesWindow_SecondaryDictionary}" />
              <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SecondaryDictionaryBox"
                        ItemsSource="{Binding AvailableSecondaryDictionaries}"
                        SelectedItem="{Binding SelectedSecondaryDictionary}"
                        DisplayMemberBinding="{Binding DisplayName, DataType=vm:DictionaryOption}" />
            </Grid>
            <CheckBox Content="{loc:Loc PreferencesWindow_EnableSpellCheck}" IsChecked="{Binding SpellCheckEnabled}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_CheckWordsWithNumbers}" IsChecked="{Binding SpellCheckNumbers}" />
            <Separator />
          </StackPanel>

          <TextBlock DockPanel.Dock="Bottom" x:Name="DefaultUserDictionaryText"
                     Text="{Binding DefaultUserDictionaryText}" Margin="0,8,0,0" />

          <TabControl>
            <TabItem Header="{loc:Loc PreferencesWindow_UserDictionaries}">
              <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Left" Spacing="6" Margin="0,0,8,0" MinWidth="110">
                  <Button x:Name="AddUserDictionaryButton" Content="{loc:Loc Common_Add}"
                          Command="{Binding AddUserDictionaryCommand}" HorizontalAlignment="Stretch" />
                  <Button x:Name="RenameUserDictionaryButton" Content="{loc:Loc Common_Rename}"
                          Command="{Binding RenameUserDictionaryCommand}" HorizontalAlignment="Stretch" />
                  <Button x:Name="CopyUserDictionaryButton" Content="{loc:Loc PreferencesWindow_CopyDictionary}"
                          Command="{Binding CopyUserDictionaryCommand}" HorizontalAlignment="Stretch" />
                  <Button Classes="danger" x:Name="RemoveUserDictionaryButton" Content="{loc:Loc Common_Remove}"
                          Command="{Binding RemoveUserDictionaryCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Border Classes="listFrame">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="70,*" Margin="8,4">
                      <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_DictionaryEnabledColumn}" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="{loc:Loc PreferencesWindow_DictionaryNameColumn}" FontWeight="Bold" />
                    </Grid>
                    <ListBox x:Name="UserDictionaryList" ItemsSource="{Binding UserDictionaries}"
                             SelectedItem="{Binding SelectedUserDictionary}" SelectionMode="Single">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:UserDictionaryRow">
                          <Grid ColumnDefinitions="62,*">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>
              </DockPanel>
            </TabItem>

            <TabItem Header="{loc:Loc PreferencesWindow_UserWordList}">
              <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Left" Spacing="6" Margin="0,0,8,0" MinWidth="110">
                  <Button x:Name="AddUserWordsButton" Content="{loc:Loc Common_Add}"
                          Command="{Binding AddUserWordsCommand}" HorizontalAlignment="Stretch" />
                  <Button x:Name="EditUserWordButton" Content="{loc:Loc PreferencesWindow_EditWord}"
                          Command="{Binding EditUserWordCommand}" HorizontalAlignment="Stretch" />
                  <Button Classes="danger" x:Name="RemoveUserWordsButton" Content="{loc:Loc Common_Remove}"
                          Command="{Binding RemoveUserWordsCommand}" HorizontalAlignment="Stretch" />
                  <Button Classes="danger" x:Name="RemoveAllUserWordsButton" Content="{loc:Loc PreferencesWindow_RemoveAllWords}"
                          Command="{Binding RemoveAllUserWordsCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Border Classes="listFrame">
                  <ListBox x:Name="UserWordList" ItemsSource="{Binding UserWords}" SelectionMode="Multiple"
                           SelectionChanged="OnUserWordSelectionChanged" DoubleTapped="OnUserWordDoubleTapped" />
                </Border>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </TabItem>

      <!-- =========================== Keyboard Shortcuts =========================== -->
      <!-- The keymap editor modelled on IntelliJ's Keymap page (KeymapView). -->
      <TabItem Header="{loc:Loc PreferencesWindow_KeyboardShortcuts}">
        <views:KeymapView DataContext="{Binding Keymap}" Margin="8" />
      </TabItem>

      <!-- ============================ Preserve Entities ============================ -->
      <TabItem Header="{loc:Loc PreferencesWindow_PreserveEntities}">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Bottom" Content="{loc:Loc Common_Add}" Command="{Binding AddPreserveEntityCommand}"
                  HorizontalAlignment="Left" Margin="0,8,0,0" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding PreserveEntities}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PreserveEntityRow">
                  <Grid ColumnDefinitions="100,*,80" Margin="0,2" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding CodeText}" PlaceholderText="{loc:Loc PreferencesWindow_CodePlaceholder}" />
                    <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="{loc:Loc PreferencesWindow_EntityPlaceholder}" />
                    <Button Classes="danger" Grid.Column="2" Content="{loc:Loc Common_Remove}" Command="{Binding RemoveCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ================================= Debug ================================== -->
      <TabItem Header="{loc:Loc PreferencesWindow_Debug}">
        <StackPanel Spacing="8" Margin="8">
          <!-- Where the log files are; a click opens the folder in the system file manager. -->
          <StackPanel Spacing="2" Margin="0,0,0,6">
            <TextBlock Text="{loc:Loc PreferencesWindow_LogsDirectory}" />
            <HyperlinkButton Content="{Binding LogsDirectory}" Command="{Binding OpenLogsDirectoryCommand}"
                             ToolTip.Tip="{loc:Loc PreferencesWindow_LogsDirectoryTip}" Padding="0" />
            <TextBlock Text="{Binding LogsDirectoryError}" Classes="warning" TextWrapping="Wrap"
                       IsVisible="{Binding LogsDirectoryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <CheckBox Content="{loc:Loc PreferencesWindow_DebugLogging}" IsChecked="{Binding DebugLogging}" />
          <TextBlock Text="{loc:Loc PreferencesWindow_DebugLoggingNote}" TextWrapping="Wrap" Opacity="0.75" Margin="28,0,0,0" />
        </StackPanel>
      </TabItem>

    </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
