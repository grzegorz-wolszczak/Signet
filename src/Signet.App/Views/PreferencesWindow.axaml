<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:views="using:Signet.App.Views"
        x:Class="Signet.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc PreferencesWindow_Title}">

  <Window.Styles>
    <!-- A subtle separation of the tab list (left) from the content (right): the tab strip
         gets a dimmed background derived from the window background, and the content area gets its own
         background and a thin border. Without this, in the light theme both parts are white and blend
         into a single plane. Colors come from DynamicResource, so it also works in the dark theme. -->
    <Style Selector="TabControl.preferences">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
    <Style Selector="TabControl.preferences /template/ ContentPresenter#PART_SelectedContentHost">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Sections inside a tab as subtle cards (e.g. "Code View — Light/Dark theme"). -->
    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.listFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- Code View color fields: the background takes the color of the entered value, also on hover and when focused
         (Fluent then replaces the template border's background with its own). -->
    <Style Selector="TextBox.colorValue:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    </Style>
    <Style Selector="TextBox.colorValue:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    </Style>
    <!-- "Label + control" grids: 2/3 of the width for the (wrapping) label, 1/3 for the control
         stretched across the whole column — long labels do not hide under the fields. -->
    <Style Selector="Grid.labeled > TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.labeled > ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.fontField > TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Font field: a read-only name rendered in the chosen font; changed via "Choose…". -->
    <Style Selector="Border.fontField">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="10">

    <!-- Save / Cancel / Apply, as in IntelliJ: changes take effect only on Save or Apply; Cancel, Escape and the
         window's close button drop them without a question. -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
      <Button Grid.Column="0" x:Name="OpenPreferencesLocationButton"
              Content="{loc:Loc PreferencesWindow_OpenPreferencesLocation}" Click="OnOpenPreferencesLocationClicked" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button x:Name="SaveButton" Content="{loc:Loc Common_Save}" Click="OnSaveClicked" MinWidth="80"
                HorizontalContentAlignment="Center" />
        <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" Click="OnCancelClicked" IsCancel="True" MinWidth="80"
                HorizontalContentAlignment="Center" />
        <Button x:Name="ApplyButton" Content="{loc:Loc Common_Apply}" Command="{Binding ApplyCommand}" MinWidth="80"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>

    <TabControl TabStripPlacement="Left" Classes="preferences">

      <!-- ================================ Language ================================ -->
      <TabItem Header="{loc:Loc PreferencesWindow_Language}">
        <StackPanel Spacing="10" Margin="8">
          <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_Language}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                      DisplayMemberBinding="{Binding DisplayName}" />
          </Grid>
          <TextBlock Text="{loc:Loc PreferencesWindow_LanguageRestartNotice}"
                     Opacity="0.7" FontStyle="Italic" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <!-- ============================== Appearance ============================== -->
      <TabItem Header="{loc:Loc PreferencesWindow_Appearance}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8">

            <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_Theme}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static infra:DisplayNameConverters.ThemePreference}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_IconTheme}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableIconThemes}" SelectedItem="{Binding SelectedIconTheme}"
                        DisplayMemberBinding="{Binding DisplayName}" />
            </Grid>

            <CheckBox Content="{loc:Loc PreferencesWindow_CompactUi}" IsChecked="{Binding CompactUi}" />

            <!-- Interface font: the description rendered in the chosen font (empty = the mode's default). -->
            <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_UiFont}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <Border Classes="fontField uiFont">
                  <TextBlock Text="{Binding UiFontDescription}" TextTrimming="CharacterEllipsis"
                             FontFamily="{Binding EffectiveUiFontFamily, Converter={x:Static infra:FontFamilyConverters.FromName}}" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="{loc:Loc PreferencesWindow_ChooseFont}" Command="{Binding ChooseUiFontCommand}" />
                  <Button Content="{loc:Loc PreferencesWindow_UiFontReset}" Command="{Binding ResetUiFontCommand}" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_CustomIconFolder}" />
              <TextBox Grid.Column="1" Text="{Binding CustomIconFolder}" />
            </Grid>

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_SpecialCharacterFont}" FontWeight="Bold" />
                <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_Family}" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="0" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc PreferencesWindow_ChooseFont}" Command="{Binding ChooseSpecialCharacterFontCommand}" Margin="6,0,0,0" />
                    <Border Classes="fontField"><TextBlock Text="{Binding SpecialCharacterFontFamily}" FontFamily="{Binding SpecialCharacterFontFamily, Converter={x:Static infra:FontFamilyConverters.FromName}}" /></Border>
                  </DockPanel>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc PreferencesWindow_Size}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SpecialCharacterFontSize}" Width="80" HorizontalAlignment="Left" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Warnings in dialogs: font size (0 = as the interface text) and the warning color of both themes;
                 applied live, the sample below shows the result. -->
            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_Warnings}" FontWeight="Bold" />
                <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_WarningFontSize}" />
                  <TextBox Grid.Row="0" Grid.Column="1" x:Name="WarningFontSizeBox" Text="{Binding WarningFontSize}"
                           Width="80" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding WarningLightColor.Label}" />
                  <DockPanel Grid.Row="1" Grid.Column="1" DataContext="{Binding WarningLightColor}">
                    <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                            ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                    <TextBox Classes="colorValue" Text="{Binding Value}"
                             Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                             Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
                  </DockPanel>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding WarningDarkColor.Label}" />
                  <DockPanel Grid.Row="2" Grid.Column="1" DataContext="{Binding WarningDarkColor}">
                    <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                            ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                    <TextBox Classes="colorValue" Text="{Binding Value}"
                             Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                             Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
                  </DockPanel>
                </Grid>
                <TextBlock x:Name="WarningSample" Classes="warning" Text="{loc:Loc PreferencesWindow_WarningSample}" />
                <TextBlock Text="{loc:Loc PreferencesWindow_WarningsNote}" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <CheckBox Content="{loc:Loc PreferencesWindow_ExtendedHighlighting}" IsChecked="{Binding ExtendedHighlighting}" />

            <!-- Code View: the opening tag tooltip over a closing tag, with its delay. -->
            <CheckBox Content="{loc:Loc PreferencesWindow_OpenTagHint}" IsChecked="{Binding OpenTagHint}" />
            <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8" Margin="28,0,0,0">
              <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_OpenTagHintDelay}" IsEnabled="{Binding OpenTagHint}" />
              <TextBox Grid.Column="1" Text="{Binding OpenTagHintDelay}" Width="80" HorizontalAlignment="Left"
                       IsEnabled="{Binding OpenTagHint}" />
            </Grid>
            <!-- The look of the hint: font (default = the editor font) and colors for both themes. -->
            <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6"
                  Margin="28,0,0,0" IsEnabled="{Binding OpenTagHint}">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_OpenTagHintFont}" />
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <!-- A description ("Default (as in the editor)" / "Consolas, 14 px"), not a name in its own font. -->
                <Border Classes="fontField description">
                  <TextBlock Text="{Binding OpenTagHintFontDescription}" TextTrimming="CharacterEllipsis" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="{loc:Loc PreferencesWindow_ChooseFont}" Command="{Binding ChooseOpenTagHintFontCommand}" />
                  <Button Content="{loc:Loc PreferencesWindow_UiFontReset}" Command="{Binding ResetOpenTagHintFontCommand}" />
                </StackPanel>
              </StackPanel>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding OpenTagHintLightBackground.Label}" />
              <DockPanel Grid.Row="1" Grid.Column="1" DataContext="{Binding OpenTagHintLightBackground}">
                <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                        ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                <TextBox Classes="colorValue" Text="{Binding Value}"
                         Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                         Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
              </DockPanel>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding OpenTagHintLightForeground.Label}" />
              <DockPanel Grid.Row="2" Grid.Column="1" DataContext="{Binding OpenTagHintLightForeground}">
                <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                        ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                <TextBox Classes="colorValue" Text="{Binding Value}"
                         Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                         Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
              </DockPanel>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding OpenTagHintDarkBackground.Label}" />
              <DockPanel Grid.Row="3" Grid.Column="1" DataContext="{Binding OpenTagHintDarkBackground}">
                <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                        ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                <TextBox Classes="colorValue" Text="{Binding Value}"
                         Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                         Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
              </DockPanel>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding OpenTagHintDarkForeground.Label}" />
              <DockPanel Grid.Row="4" Grid.Column="1" DataContext="{Binding OpenTagHintDarkForeground}">
                <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                        ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                <TextBox Classes="colorValue" Text="{Binding Value}"
                         Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                         Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
              </DockPanel>
            </Grid>

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_CodeViewLight}" FontWeight="Bold" />
                <ContentControl Content="{Binding CodeViewLight}">
                  <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:CodeViewAppearanceEditor">
                      <StackPanel Spacing="6">
                        <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_FontFamily}" VerticalAlignment="Center" />
                          <DockPanel Grid.Row="0" Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc PreferencesWindow_ChooseFont}" Command="{Binding ChooseFontCommand}" Margin="6,0,0,0" />
                            <Border Classes="fontField"><TextBlock Text="{Binding FontFamily}" FontFamily="{Binding FontFamily, Converter={x:Static infra:FontFamilyConverters.FromName}}" /></Border>
                          </DockPanel>
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc PreferencesWindow_FontSize}" VerticalAlignment="Center" />
                          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FontSize}" Width="80" HorizontalAlignment="Left" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Colors}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ColorSettingRow">
                              <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" />
                                <DockPanel Grid.Column="1">
                                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                                          ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                                  <TextBox Classes="colorValue" Text="{Binding Value}"
                                           Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                                           Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
                                </DockPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_CodeViewDark}" FontWeight="Bold" />
                <ContentControl Content="{Binding CodeViewDark}">
                  <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:CodeViewAppearanceEditor">
                      <StackPanel Spacing="6">
                        <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_FontFamily}" VerticalAlignment="Center" />
                          <DockPanel Grid.Row="0" Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc PreferencesWindow_ChooseFont}" Command="{Binding ChooseFontCommand}" Margin="6,0,0,0" />
                            <Border Classes="fontField"><TextBlock Text="{Binding FontFamily}" FontFamily="{Binding FontFamily, Converter={x:Static infra:FontFamilyConverters.FromName}}" /></Border>
                          </DockPanel>
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc PreferencesWindow_FontSize}" VerticalAlignment="Center" />
                          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FontSize}" Width="80" HorizontalAlignment="Left" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Colors}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ColorSettingRow">
                              <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" />
                                <DockPanel Grid.Column="1">
                                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                                          ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                                  <TextBox Classes="colorValue" Text="{Binding Value}"
                                           Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                                           Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
                                </DockPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
              </StackPanel>
            </Border>

            <TextBlock Text="{loc:Loc PreferencesWindow_FontColorRestartNotice}"
                       IsVisible="{Binding RestartNoticeVisible}" Opacity="0.7" FontStyle="Italic" TextWrapping="Wrap" />

            <Button Content="{loc:Loc PreferencesWindow_RestoreAppearanceDefaults}" Command="{Binding RestoreAppearanceDefaultsCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================ Preview ================================ -->
      <TabItem Header="{loc:Loc PreferencesWindow_Preview}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8">

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_PreviewFonts}" FontWeight="Bold" />
                <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_Standard}" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="0" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc PreferencesWindow_ChooseFont}" Command="{Binding ChoosePreviewFontStandardCommand}" Margin="6,0,0,0" />
                    <Border Classes="fontField"><TextBlock Text="{Binding PreviewFontStandard}" FontFamily="{Binding PreviewFontStandard, Converter={x:Static infra:FontFamilyConverters.FromName}}" /></Border>
                  </DockPanel>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc PreferencesWindow_Serif}" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="1" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc PreferencesWindow_ChooseFont}" Command="{Binding ChoosePreviewFontSerifCommand}" Margin="6,0,0,0" />
                    <Border Classes="fontField"><TextBlock Text="{Binding PreviewFontSerif}" FontFamily="{Binding PreviewFontSerif, Converter={x:Static infra:FontFamilyConverters.FromName}}" /></Border>
                  </DockPanel>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc PreferencesWindow_SansSerif}" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="2" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc PreferencesWindow_ChooseFont}" Command="{Binding ChoosePreviewFontSansSerifCommand}" Margin="6,0,0,0" />
                    <Border Classes="fontField"><TextBlock Text="{Binding PreviewFontSansSerif}" FontFamily="{Binding PreviewFontSansSerif, Converter={x:Static infra:FontFamilyConverters.FromName}}" /></Border>
                  </DockPanel>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc PreferencesWindow_Size}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PreviewFontSize}" Width="80" HorizontalAlignment="Left" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_PreviewLiveRefresh}" FontWeight="Bold" />
                <Grid Classes="labeled" ColumnDefinitions="2*,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewRefreshDelay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBox Grid.Column="1" Text="{Binding PreviewRefreshDelay}" Width="80" HorizontalAlignment="Left" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_PreviewHighlight}" FontWeight="Bold" />
                <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewHighlightStyle}" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePreviewHighlightStyles}" SelectedItem="{Binding PreviewHighlightStyle}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static infra:DisplayNameConverters.PreviewHighlightStyle}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PreviewHighlightLightColor.Label}" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="1" Grid.Column="1" DataContext="{Binding PreviewHighlightLightColor}">
                    <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                            ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                    <TextBox Classes="colorValue" Text="{Binding Value}"
                             Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                             Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
                  </DockPanel>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding PreviewHighlightDarkColor.Label}" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="2" Grid.Column="1" DataContext="{Binding PreviewHighlightDarkColor}">
                    <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseColorCommand}"
                            ToolTip.Tip="{loc:Loc PreferencesWindow_ChooseColor}" Margin="6,0,0,0" />
                    <TextBox Classes="colorValue" Text="{Binding Value}"
                             Background="{Binding Value, Converter={x:Static infra:ColorConverters.ToBrush}}"
                             Foreground="{Binding Value, Converter={x:Static infra:ColorConverters.ToContrastingForeground}}" />
                  </DockPanel>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewHighlightOpacity}" VerticalAlignment="Center" TextWrapping="Wrap"
                             IsEnabled="{Binding IsPreviewHighlightBackground}" />
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PreviewHighlightOpacity}" Width="80" HorizontalAlignment="Left"
                           IsEnabled="{Binding IsPreviewHighlightBackground}" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewHighlightOutlineWidth}" VerticalAlignment="Center" TextWrapping="Wrap"
                             IsEnabled="{Binding IsPreviewHighlightOutline}" />
                  <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PreviewHighlightOutlineWidth}" Width="80" HorizontalAlignment="Left"
                           IsEnabled="{Binding IsPreviewHighlightOutline}" />

                  <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="{loc:Loc PreferencesWindow_PreviewHighlightAutoHide}"
                            IsChecked="{Binding PreviewHighlightAutoHide}" />

                  <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PreviewHighlightAutoHideDelay}" VerticalAlignment="Center" TextWrapping="Wrap"
                             IsEnabled="{Binding PreviewHighlightAutoHide}" />
                  <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PreviewHighlightAutoHideDelay}" Width="80" HorizontalAlignment="Left"
                           IsEnabled="{Binding PreviewHighlightAutoHide}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================ General ================================ -->
      <TabItem Header="{loc:Loc PreferencesWindow_General}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8">
            <CheckBox Content="{loc:Loc PreferencesWindow_DefaultEpub3}" IsChecked="{Binding DefaultVersionIsEpub3}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_MendOnOpen}" IsChecked="{Binding MendOnOpen}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_MendOnSave}" IsChecked="{Binding MendOnSave}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_ReopenLastFile}" IsChecked="{Binding ReopenLastFileOnStartup}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_EnableFileDropZone}" IsChecked="{Binding FileDropZoneEnabled}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_AutoCloseTags}" IsChecked="{Binding AutoCloseTags}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_FindUsagesRefreshOnSave}" IsChecked="{Binding FindUsagesRefreshOnSave}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_NavigationHistoryRemember}" IsChecked="{Binding NavigationHistoryRemember}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsEnabled="{Binding NavigationHistoryRemember}">
              <TextBlock Text="{loc:Loc PreferencesWindow_NavigationHistoryDays}" VerticalAlignment="Center" />
              <TextBox Text="{Binding NavigationHistoryDays}" Width="80" />
            </StackPanel>

            <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,6,0,0">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_ClipboardHistoryLimit}" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ClipboardHistoryLimit}" Width="80" HorizontalAlignment="Left" />

              <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc PreferencesWindow_RecentFilesLimit}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RecentFilesLimit}" Width="80" HorizontalAlignment="Left" />

              <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc PreferencesWindow_RecentLocationsLimit}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding RecentLocationsLimit}" Width="80" HorizontalAlignment="Left" />


              <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc PreferencesWindow_TempFolder}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TempFolderHome}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc PreferencesWindow_ExternalXEditorPath}" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExternalXEditorPath}" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc PreferencesWindow_CssEpub2Profile}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableCssValidationSpecs}"
                        SelectedItem="{Binding CssEpub2ValidationSpec}" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc PreferencesWindow_CssEpub3Profile}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AvailableCssValidationSpecs}"
                        SelectedItem="{Binding CssEpub3ValidationSpec}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================= Mend & Prettify ============================= -->
      <!-- Mend and Prettify are separate operations, so each has its own box of options. -->
      <TabItem Header="{loc:Loc PreferencesWindow_MendPrettify}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8">
            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_PrettifySection}" FontWeight="Bold" />
                <CheckBox Content="{loc:Loc PreferencesWindow_PrettifyAddMissingDoctype}" IsChecked="{Binding PrettifyAddMissingDoctype}" />
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_MendSection}" FontWeight="Bold" />
                <CheckBox Content="{loc:Loc PreferencesWindow_MendAddMissingDoctype}" IsChecked="{Binding MendAddMissingDoctype}" />
                <CheckBox Content="{loc:Loc PreferencesWindow_MendShowDiff}" IsChecked="{Binding MendShowDiff}" />
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc PreferencesWindow_DoctypeWarningsSection}" FontWeight="Bold" />
                <CheckBox Content="{loc:Loc PreferencesWindow_WarnMissingDoctype}" IsChecked="{Binding WarnMissingDoctype}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- =============================== Spellcheck =============================== -->
      <!-- Layout: Hunspell dictionaries and options at the top, below them the tabs
           "user dictionaries" (Add/Rename/Copy/Delete + a list with an enable toggle)
           and the "word list" of the selected dictionary; the selected dictionary is also the default one. -->
      <TabItem Header="{loc:Loc PreferencesWindow_Spellcheck}">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Spacing="10">
            <Grid Classes="labeled" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc PreferencesWindow_PrimaryDictionary}" />
              <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PrimaryDictionaryBox"
                        ItemsSource="{Binding AvailableDictionaries}"
                        SelectedItem="{Binding SelectedPrimaryDictionary}"
                        DisplayMemberBinding="{Binding DisplayName, DataType=vm:DictionaryOption}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc PreferencesWindow_SecondaryDictionary}" />
              <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SecondaryDictionaryBox"
                        ItemsSource="{Binding AvailableSecondaryDictionaries}"
                        SelectedItem="{Binding SelectedSecondaryDictionary}"
                        DisplayMemberBinding="{Binding DisplayName, DataType=vm:DictionaryOption}" />
            </Grid>
            <CheckBox Content="{loc:Loc PreferencesWindow_EnableSpellCheck}" IsChecked="{Binding SpellCheckEnabled}" />
            <CheckBox Content="{loc:Loc PreferencesWindow_CheckWordsWithNumbers}" IsChecked="{Binding SpellCheckNumbers}" />
            <Separator />
          </StackPanel>

          <TextBlock DockPanel.Dock="Bottom" x:Name="DefaultUserDictionaryText"
                     Text="{Binding DefaultUserDictionaryText}" Margin="0,8,0,0" />

          <TabControl>
            <TabItem Header="{loc:Loc PreferencesWindow_UserDictionaries}">
              <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Left" Spacing="6" Margin="0,0,8,0" MinWidth="110">
                  <Button x:Name="AddUserDictionaryButton" Content="{loc:Loc Common_Add}"
                          Command="{Binding AddUserDictionaryCommand}" HorizontalAlignment="Stretch" />
                  <Button x:Name="RenameUserDictionaryButton" Content="{loc:Loc Common_Rename}"
                          Command="{Binding RenameUserDictionaryCommand}" HorizontalAlignment="Stretch" />
                  <Button x:Name="CopyUserDictionaryButton" Content="{loc:Loc PreferencesWindow_CopyDictionary}"
                          Command="{Binding CopyUserDictionaryCommand}" HorizontalAlignment="Stretch" />
                  <Button x:Name="RemoveUserDictionaryButton" Content="{loc:Loc Common_Remove}"
                          Command="{Binding RemoveUserDictionaryCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Border Classes="listFrame">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="70,*" Margin="8,4">
                      <TextBlock Grid.Column="0" Text="{loc:Loc PreferencesWindow_DictionaryEnabledColumn}" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="{loc:Loc PreferencesWindow_DictionaryNameColumn}" FontWeight="Bold" />
                    </Grid>
                    <ListBox x:Name="UserDictionaryList" ItemsSource="{Binding UserDictionaries}"
                             SelectedItem="{Binding SelectedUserDictionary}" SelectionMode="Single">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:UserDictionaryRow">
                          <Grid ColumnDefinitions="62,*">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>
              </DockPanel>
            </TabItem>

            <TabItem Header="{loc:Loc PreferencesWindow_UserWordList}">
              <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Left" Spacing="6" Margin="0,0,8,0" MinWidth="110">
                  <Button x:Name="AddUserWordsButton" Content="{loc:Loc Common_Add}"
                          Command="{Binding AddUserWordsCommand}" HorizontalAlignment="Stretch" />
                  <Button x:Name="EditUserWordButton" Content="{loc:Loc PreferencesWindow_EditWord}"
                          Command="{Binding EditUserWordCommand}" HorizontalAlignment="Stretch" />
                  <Button x:Name="RemoveUserWordsButton" Content="{loc:Loc Common_Remove}"
                          Command="{Binding RemoveUserWordsCommand}" HorizontalAlignment="Stretch" />
                  <Button x:Name="RemoveAllUserWordsButton" Content="{loc:Loc PreferencesWindow_RemoveAllWords}"
                          Command="{Binding RemoveAllUserWordsCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Border Classes="listFrame">
                  <ListBox x:Name="UserWordList" ItemsSource="{Binding UserWords}" SelectionMode="Multiple"
                           SelectionChanged="OnUserWordSelectionChanged" DoubleTapped="OnUserWordDoubleTapped" />
                </Border>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </TabItem>

      <!-- =========================== Keyboard Shortcuts =========================== -->
      <!-- The keymap editor modelled on IntelliJ's Keymap page (KeymapView). -->
      <TabItem Header="{loc:Loc PreferencesWindow_KeyboardShortcuts}">
        <views:KeymapView DataContext="{Binding Keymap}" Margin="8" />
      </TabItem>

      <!-- ============================ Preserve Entities ============================ -->
      <TabItem Header="{loc:Loc PreferencesWindow_PreserveEntities}">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Bottom" Content="{loc:Loc Common_Add}" Command="{Binding AddPreserveEntityCommand}"
                  HorizontalAlignment="Left" Margin="0,8,0,0" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding PreserveEntities}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PreserveEntityRow">
                  <Grid ColumnDefinitions="100,*,80" Margin="0,2" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding CodeText}" PlaceholderText="{loc:Loc PreferencesWindow_CodePlaceholder}" />
                    <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="{loc:Loc PreferencesWindow_EntityPlaceholder}" />
                    <Button Grid.Column="2" Content="{loc:Loc Common_Remove}" Command="{Binding RemoveCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ================================= Debug ================================== -->
      <TabItem Header="{loc:Loc PreferencesWindow_Debug}">
        <StackPanel Spacing="8" Margin="8">
          <!-- Where the log files are; a click opens the folder in the system file manager. -->
          <StackPanel Spacing="2" Margin="0,0,0,6">
            <TextBlock Text="{loc:Loc PreferencesWindow_LogsDirectory}" />
            <HyperlinkButton Content="{Binding LogsDirectory}" Command="{Binding OpenLogsDirectoryCommand}"
                             ToolTip.Tip="{loc:Loc PreferencesWindow_LogsDirectoryTip}" Padding="0" />
            <TextBlock Text="{Binding LogsDirectoryError}" Classes="warning" TextWrapping="Wrap"
                       IsVisible="{Binding LogsDirectoryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <CheckBox Content="{loc:Loc PreferencesWindow_DebugLogging}" IsChecked="{Binding DebugLogging}" />
          <TextBlock Text="{loc:Loc PreferencesWindow_DebugLoggingNote}" TextWrapping="Wrap" Opacity="0.75" Margin="28,0,0,0" />
        </StackPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
