<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.SelectClipWindow"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc SelectClipWindow_Title}">

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc SelectClipWindow_Prompt}" Margin="0,0,0,8" />
    <TextBox x:Name="Filter" DockPanel.Dock="Top" PlaceholderText="{loc:Loc SelectClipWindow_FilterPlaceholder}" Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton" Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="80" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <ListBox x:Name="Clips" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ClipPickerItem">
          <TextBlock Text="{Binding Display}" ToolTip.Tip="{Binding Text}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
