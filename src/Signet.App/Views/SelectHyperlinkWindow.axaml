<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.SelectHyperlinkWindow"
        Width="460" Height="480"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc SelectHyperlinkWindow_Title}">

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc SelectHyperlinkWindow_Prompt}" Margin="0,0,0,8" TextWrapping="Wrap" />
    <TextBox x:Name="HrefInput" DockPanel.Dock="Top" Margin="0,0,0,8" />
    <TextBox x:Name="Filter" DockPanel.Dock="Top" PlaceholderText="{loc:Loc SelectHyperlinkWindow_FilterPlaceholder}" Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton" Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="80" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <ListBox x:Name="Targets" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:HyperlinkTargetItem">
          <TextBlock Text="{Binding Display}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
