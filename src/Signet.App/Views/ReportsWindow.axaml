<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.ReportsWindow"
        x:DataType="vm:ReportsViewModel"
        Width="1000" Height="640"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc ReportsWindow_Title}">

  <DockPanel Margin="10">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,8,0,0">
      <Button Content="{loc:Loc ReportsWindow_ExportCsv}" Command="{Binding ExportCsvCommand}" />
      <Button Content="{loc:Loc Common_Refresh}" Command="{Binding RefreshCommand}" />
      <Button Content="{loc:Loc Common_Close}" Click="OnCloseClicked" />
    </StackPanel>

    <TabControl TabStripPlacement="Left" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

      <TabItem Header="{loc:Loc ReportsWindow_AllFiles}">
        <DataGrid x:Name="AllFilesGrid" ItemsSource="{Binding AllFiles}" IsReadOnly="True"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                  DoubleTapped="OnAllFilesDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Name}" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Type}" Binding="{Binding TypeName}" Width="110" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_SizeBytes}" Binding="{Binding SizeBytes}" Width="120" />
            <DataGridCheckBoxColumn Header="{loc:Loc ReportsWindow_InSpine}" Binding="{Binding InSpine}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{loc:Loc ReportsWindow_HtmlFiles}">
        <DataGrid x:Name="HtmlFilesGrid" ItemsSource="{Binding HtmlFiles}" IsReadOnly="True"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                  DoubleTapped="OnHtmlFilesDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Name}" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_SizeBytes}" Binding="{Binding SizeBytes}" Width="120" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_AllWords}" Binding="{Binding WordCount}" Width="100" />
            <DataGridCheckBoxColumn Header="{loc:Loc ReportsWindow_WellFormed}" Binding="{Binding WellFormed}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{loc:Loc ReportsWindow_ImageFiles}">
        <DataGrid x:Name="ImageFilesGrid" ItemsSource="{Binding ImageFiles}" IsReadOnly="True"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                  DoubleTapped="OnImageFilesDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Name}" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Format}" Binding="{Binding Format}" Width="80" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_SizeBytes}" Binding="{Binding SizeBytes}" Width="110" />
            <DataGridTextColumn Header="{loc:Loc ImageResizeWindow_Width}" Binding="{Binding Width}" Width="70" />
            <DataGridTextColumn Header="{loc:Loc ImageResizeWindow_Height}" Binding="{Binding Height}" Width="70" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_UsedIn}" Binding="{Binding UsedInDisplay}" Width="200" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{loc:Loc ReportsWindow_CssFiles}">
        <DataGrid x:Name="CssFilesGrid" ItemsSource="{Binding CssFiles}" IsReadOnly="True"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                  DoubleTapped="OnCssFilesDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Name}" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_SizeBytes}" Binding="{Binding SizeBytes}" Width="120" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_SelectorCount}" Binding="{Binding SelectorCount}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{loc:Loc ReportsWindow_ClassesInHtml}">
        <DataGrid x:Name="ClassesGrid" ItemsSource="{Binding Classes}" IsReadOnly="True"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                  DoubleTapped="OnClassesDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_HtmlFile}" Binding="{Binding HtmlBookPath}" Width="*" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Element}" Binding="{Binding ElementName}" Width="90" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Class}" Binding="{Binding ClassName}" Width="140" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_MatchedSelector}" Binding="{Binding SelectorText}" Width="180" />
            <DataGridCheckBoxColumn Header="{loc:Loc ReportsWindow_UsedInCss}" Binding="{Binding IsUsed}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{loc:Loc ReportsWindow_StylesInCss}">
        <DataGrid x:Name="StylesGrid" ItemsSource="{Binding Styles}" IsReadOnly="True"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                  DoubleTapped="OnStylesDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_CssFile}" Binding="{Binding CssBookPath}" Width="*" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_CssSelector}" Binding="{Binding SelectorText}" Width="220" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_UsedInHtmlFile}" Binding="{Binding UsedInHtmlBookPath}" Width="220" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{loc:Loc ReportsWindow_Links}">
        <DataGrid x:Name="LinksGrid" ItemsSource="{Binding Links}" IsReadOnly="True"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                  DoubleTapped="OnLinksDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_File}" Binding="{Binding HtmlBookPath}" Width="*" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Text}" Binding="{Binding Text}" Width="160" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Target}" Binding="{Binding TargetHref}" Width="220" />
            <DataGridCheckBoxColumn Header="{loc:Loc ReportsWindow_Internal}" Binding="{Binding IsInternal}" Width="80" />
            <DataGridCheckBoxColumn Header="{loc:Loc ReportsWindow_TargetExists}" Binding="{Binding TargetExists}" IsThreeState="True" Width="110" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{loc:Loc ReportsWindow_CharactersInHtml}">
        <DataGrid x:Name="CharactersGrid" ItemsSource="{Binding Characters}" IsReadOnly="True"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Character}" Binding="{Binding Character}" Width="80" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Decimal}" Binding="{Binding DecimalValue}" Width="80" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Hexadecimal}" Binding="{Binding Hexadecimal}" Width="90" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Name}" Binding="{Binding EntityName}" Width="*" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_Count}" Binding="{Binding Count}" Width="80" />
            <DataGridTextColumn Header="{loc:Loc ReportsWindow_FoundIn}" Binding="{Binding FoundInDisplay}" Width="220" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{loc:Loc ReportsWindow_WordCharCounts}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" FontWeight="Bold">
            <Run Text="{loc:Loc ReportsWindow_Total}" />
            <Run Text="{Binding TotalWords}" />
            <Run Text="{loc:Loc ReportsWindow_Words}" />
            <Run Text="{Binding TotalCharacters}" />
            <Run Text="{loc:Loc ReportsWindow_Characters}" />
          </TextBlock>
          <DataGrid x:Name="WordCountsGrid" ItemsSource="{Binding WordCounts}" IsReadOnly="True"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                    DoubleTapped="OnWordCountsDoubleTapped">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:Loc ReportsWindow_File}" Binding="{Binding BookPath}" Width="*" />
              <DataGridTextColumn Header="{loc:Loc ReportsWindow_Words}" Binding="{Binding Words}" Width="100" />
              <DataGridTextColumn Header="{loc:Loc ReportsWindow_Characters}" Binding="{Binding Characters}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
