<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.RegexRenameWindow"
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc RegexRenameWindow_Title}">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
      <TextBlock Text="{loc:Loc RegexRenameWindow_Pattern}" />
      <TextBox x:Name="PatternBox" PlaceholderText="{loc:Loc RegexRenameWindow_PatternPlaceholder}" />
      <TextBlock Text="{loc:Loc RegexRenameWindow_Replacement}" Margin="0,6,0,0" />
      <TextBox x:Name="ReplacementBox" PlaceholderText="{loc:Loc RegexRenameWindow_ReplacementPlaceholder}" />
      <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton" Content="{loc:Loc RegexRenameWindow_RenameButton}" IsDefault="True" MinWidth="100" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <Border BorderBrush="Gray" BorderThickness="1">
      <ScrollViewer>
        <ItemsControl x:Name="PreviewList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Padding="4,2" FontFamily="Consolas,Menlo,monospace" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
