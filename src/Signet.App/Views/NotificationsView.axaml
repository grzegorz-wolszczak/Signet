<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel">

  <UserControl.Styles>
    <!-- An error (a blocked or failed operation): the error color. -->
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SignetErrorBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
      <Button Content="{loc:Loc NotificationsView_Clear}"
              Command="{Binding ClearCommand}"
              IsEnabled="{Binding HasEntries}"
              Padding="8,2" />
    </StackPanel>

    <Panel>
      <TextBlock Text="{loc:Loc NotificationsView_Empty}"
                 IsVisible="{Binding !HasEntries}"
                 FontSize="16" Opacity="0.6"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />

      <ListBox x:Name="List"
               ItemsSource="{Binding Entries}"
               IsVisible="{Binding HasEntries}"
               BorderThickness="1"
               BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NotificationEntry">
            <Grid ColumnDefinitions="18,Auto,*" MinHeight="20">
              <Path Grid.Column="0"
                    Data="{StaticResource SignetWarningGeometry}"
                    Fill="{DynamicResource SignetErrorBrush}"
                    Stretch="Uniform" Width="13" Height="13"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsWarning}" />
              <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                         Opacity="0.7" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Message}"
                         Classes.error="{Binding IsWarning}"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
