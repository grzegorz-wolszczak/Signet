<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel">

  <UserControl.Styles>
    <!-- The timestamp column: one background and one text color for every row (Appearance › Interface Colors). -->
    <Style Selector="Border.timestampCell">
      <Setter Property="Background" Value="{DynamicResource SignetNotificationsTimestampBackgroundBrush}" />
    </Style>
    <Style Selector="TextBlock.timestampText">
      <Setter Property="Foreground" Value="{DynamicResource SignetNotificationsTimestampForegroundBrush}" />
    </Style>

    <!-- The message column: an ordinary row and a warning row (a blocked or failed operation) each have their own
         background and text color (Appearance › Interface Colors). -->
    <Style Selector="Border.messageCell">
      <Setter Property="Background" Value="{DynamicResource SignetNotificationsMessageInfoBackgroundBrush}" />
    </Style>
    <Style Selector="Border.messageCell.error">
      <Setter Property="Background" Value="{DynamicResource SignetNotificationsMessageWarningBackgroundBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.messageText">
      <Setter Property="Foreground" Value="{DynamicResource SignetNotificationsMessageInfoForegroundBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.messageText.error">
      <Setter Property="Foreground" Value="{DynamicResource SignetNotificationsMessageWarningForegroundBrush}" />
    </Style>

    <!-- The message does not wrap by default (an ellipsis cuts it); the "wrap rows" toggle of the left toolbar turns
         it on, as Find Usages does for its own columns. -->
    <Style Selector="SelectableTextBlock.messageText">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ListBox.wrapRows SelectableTextBlock.messageText">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="4">
    <!-- The left toolbar, like the Find tool window of the JetBrains IDEs (Find Usages has the same one). -->
    <Border DockPanel.Dock="Left" BorderThickness="0,0,1,0" Padding="2"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="4">
        <Button x:Name="ClearButton" Classes="panelTool" Command="{Binding ClearCommand}"
                IsEnabled="{Binding HasEntries}" ToolTip.Tip="{loc:Loc NotificationsView_Clear}">
          <!-- Material Design "delete" icon (Apache License 2.0). -->
          <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" />
        </Button>
        <ToggleButton x:Name="WrapRowsButton" Classes="panelTool" IsChecked="{Binding WrapRows, Mode=TwoWay}"
                      ToolTip.Tip="{loc:Loc NotificationsView_WrapRows}">
          <!-- Material Design "wrap" icon (Apache License 2.0): a line that turns back under itself. -->
          <Path Data="M21,5H3V7H21V5M3,19H10V17H3V19M3,13H18C19,13 20,13.43 20,15C20,16.57 19,17 18,17H16V15L12,18L16,21V19H18C20.95,19 22,17.73 22,15C22,12.27 20.95,11 18,11H3V13Z" />
        </ToggleButton>
      </StackPanel>
    </Border>

    <Panel>
      <TextBlock Text="{loc:Loc NotificationsView_Empty}"
                 IsVisible="{Binding !HasEntries}"
                 FontSize="16" Opacity="0.6"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />

      <!-- Dock's ToolChromeControl font reaches its content; unset notification fonts must use the interface font. -->
      <ListBox x:Name="List"
               ItemsSource="{Binding Entries}"
               IsVisible="{Binding HasEntries}"
               FontFamily="{DynamicResource ContentControlThemeFontFamily}"
               FontSize="{DynamicResource ControlContentThemeFontSize}"
               BorderThickness="1"
               BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
               Background="{DynamicResource SignetNotificationsBackgroundBrush}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NotificationEntry">
            <Grid ColumnDefinitions="18,Auto,*">
              <Path Grid.Column="0"
                    Data="{StaticResource SignetWarningGeometry}"
                    Fill="{DynamicResource SignetErrorBrush}"
                    Stretch="Uniform" Width="13" Height="13"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsWarning}" />
              <Border Grid.Column="1" Classes="timestampCell" Margin="0,0,10,0">
                <TextBlock Classes="entryFont timestampFont timestampText" Text="{Binding TimeText}"
                           Opacity="0.7" VerticalAlignment="Center" />
              </Border>
              <Border Grid.Column="2" Classes="messageCell" Classes.error="{Binding IsWarning}">
                <SelectableTextBlock Classes="entryFont messageFont messageText" Classes.error="{Binding IsWarning}"
                                     Text="{Binding Message}" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
