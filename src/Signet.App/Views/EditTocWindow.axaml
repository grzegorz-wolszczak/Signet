<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.EditTocWindow"
        x:DataType="vm:EditTocViewModel"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc EditTocWindow_Title}">

  <Window.Resources>
    <!-- Cell templates of the entries table (looked up by key from the code-behind). -->
    <DataTemplate x:Key="TitleCellTemplate" x:DataType="vm:EditTocNodeViewModel">
      <TextBlock Text="{Binding Text}" Margin="{Binding Indent}" Padding="6,0" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
    </DataTemplate>
    <DataTemplate x:Key="TitleEditingTemplate" x:DataType="vm:EditTocNodeViewModel">
      <TextBox Text="{Binding Text, Mode=TwoWay}" Margin="{Binding Indent}"
               PlaceholderText="{loc:Loc EditTocWindow_EntryTextPlaceholder}" />
    </DataTemplate>
    <DataTemplate x:Key="TargetCellTemplate" x:DataType="vm:EditTocNodeViewModel">
      <TextBlock Text="{Binding TargetDisplay}" Padding="6,0" VerticalAlignment="Center" Opacity="0.7"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TargetDisplay}" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="90" Command="{Binding AcceptCommand}" />
      <Button Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" Command="{Binding CancelCommand}" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Margin="0,8,0,0"
               TextWrapping="Wrap" Foreground="{DynamicResource SystemAccentColor}"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel DockPanel.Dock="Right" Width="120" Margin="8,0,0,0" Spacing="4">
      <Button Content="{loc:Loc EditTocWindow_AddAbove}" HorizontalAlignment="Stretch" Command="{Binding AddAboveCommand}"
              ToolTip.Tip="{loc:Loc EditTocWindow_AddAboveTip}" />
      <Button Content="{loc:Loc EditTocWindow_AddBelow}" HorizontalAlignment="Stretch" Command="{Binding AddBelowCommand}"
              ToolTip.Tip="{loc:Loc EditTocWindow_AddBelowTip}" />
      <Button Content="{loc:Loc Common_Delete}" HorizontalAlignment="Stretch" Command="{Binding DeleteCommand}"
              ToolTip.Tip="{loc:Loc EditTocWindow_DeleteTip}" />
      <Button Content="{loc:Loc EditTocWindow_SelectTarget}" HorizontalAlignment="Stretch" Command="{Binding SelectTargetCommand}"
              ToolTip.Tip="{loc:Loc EditTocWindow_SelectTargetTip}" />
      <Separator />
      <UniformGrid Columns="4">
        <Button Content="←" Command="{Binding MoveLeftCommand}" ToolTip.Tip="{loc:Loc EditTocWindow_DecreaseLevelTip}" />
        <Button Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="{loc:Loc EditTocWindow_MoveUpTip}" />
        <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="{loc:Loc EditTocWindow_MoveDownTip}" />
        <Button Content="→" Command="{Binding MoveRightCommand}" ToolTip.Tip="{loc:Loc EditTocWindow_IncreaseLevelTip}" />
      </UniformGrid>
      <Button Content="{loc:Loc EditTocWindow_SortByBookOrder}" HorizontalAlignment="Stretch" Command="{Binding SortByBookOrderCommand}"
              ToolTip.Tip="{loc:Loc EditTocWindow_SortByBookOrderTip}" />

    </StackPanel>

    <!-- A flat table in reading order: the level is shown as the indentation of the title and in its own column;
         ← → change it. Sorting is off — the order of the rows is the order of the table of contents. The source and the
         columns (Title, Level, Target) are built in the code-behind from the cell templates below. -->
    <TreeDataGrid x:Name="Grid"
                  Classes="gridLines"
                  CanUserSortColumns="False"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <TreeDataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{loc:Loc Common_Rename}" Command="{Binding RenameCommand}" />
          <MenuItem Header="{loc:Loc Common_Delete}" Command="{Binding DeleteCommand}" />
        </ContextMenu>
      </TreeDataGrid.ContextMenu>
    </TreeDataGrid>
  </DockPanel>
</Window>
