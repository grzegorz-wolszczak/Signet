<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.MissingDoctypeDialog"
        Width="600" Height="420" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{loc:Loc MissingDoctypeDialog_Title}">

  <!-- Fixed height: a long file list scrolls inside the frame instead of growing the window. -->
  <DockPanel Margin="16">
    <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" />
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
      <CheckBox x:Name="DontAskAgainBox" Content="{loc:Loc MissingDoctypeDialog_DontAskAgain}" />
      <TextBlock Text="{loc:Loc MissingDoctypeDialog_DontAskAgainHint}" TextWrapping="Wrap"
                 Opacity="0.7" FontStyle="Italic" Margin="28,0,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
        <Button x:Name="YesButton" Content="{loc:Loc Common_Yes}" IsDefault="True" MinWidth="90" />
        <Button x:Name="NoButton" Content="{loc:Loc Common_No}" IsCancel="True" MinWidth="90" />
      </StackPanel>
    </StackPanel>
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="4">
      <ListBox x:Name="FileList" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Border>
  </DockPanel>
</Window>
