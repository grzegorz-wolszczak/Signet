<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.TableOfContentsView"
             x:DataType="vm:TableOfContentsViewModel"
             x:Name="Root">

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="4" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <Button Content="{loc:Loc TableOfContentsView_Edit}" Command="{Binding EditCommand}" HorizontalAlignment="Left"
              ToolTip.Tip="{loc:Loc TableOfContentsView_EditTip}" />
    </Border>

    <Panel>
      <TextBlock Text="{loc:Loc TableOfContentsView_NoToc}"
                 IsVisible="{Binding !HasEntries}"
                 Margin="16" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top" />

      <!-- The TOC tree with the Title (expandable) and Target columns; source built in the code-behind. -->
      <TreeDataGrid x:Name="Tree" IsVisible="{Binding HasEntries}" />
    </Panel>
  </DockPanel>
</UserControl>
