<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Signet.App.Views"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.DeleteUnusedMediaWindow"
        x:DataType="v:DeleteUnusedMediaWindow"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc DeleteUnusedMediaWindow_Title}">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton" Content="{loc:Loc DeleteUnusedMediaWindow_DeleteMarked}" IsDefault="True" MinWidth="150" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <CheckBox x:Name="ToggleSelectAllCheckBox" DockPanel.Dock="Top" IsChecked="True"
              Content="{loc:Loc Common_ToggleSelectAll}" Margin="0,0,0,8" />

    <ListBox x:Name="RowsList" ItemsSource="{Binding Rows}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="v:DeleteUnusedMediaRow">
          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding BookPath}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
