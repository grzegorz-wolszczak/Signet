<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.SaveChangesDialog"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Title="Signet">

  <StackPanel Margin="16" Spacing="14">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap"
               Text="{loc:Loc SaveChangesDialog_Message}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="SaveButton" Content="{loc:Loc Common_Save}" IsDefault="True" MinWidth="90" />
      <Button x:Name="DiscardButton" Content="{loc:Loc SaveChangesDialog_Discard}" MinWidth="90" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
