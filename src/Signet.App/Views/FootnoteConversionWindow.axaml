<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.FootnoteConversionWindow"
        infra:TooltipFonts.Area="Footnotes"
        x:DataType="vm:FootnoteConversionViewModel"
        Width="1000" Height="760" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc FootnoteConversionWindow_Title}">

  <Window.Styles>
    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <!-- The cells of the tree (the columns are built in code; FootnoteConversionNode). A double click in the reference
       or the note column opens that place in the code. -->
  <Window.Resources>
    <DataTemplate x:Key="FootnoteConversionTitleCellTemplate" x:DataType="vm:FootnoteConversionNode">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox IsChecked="{Binding Check, Mode=TwoWay}" IsVisible="{Binding HasCheckBox}" IsEnabled="{Binding CanCheck}"
                  MinWidth="0" Margin="0,0,4,0" />
        <TextBlock Text="⚠" IsVisible="{Binding HasWarnings}" FontWeight="Bold" Foreground="{DynamicResource SignetWarningBrush}"
                   Margin="0,0,6,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TitleTip}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="FootnoteConversionKindCellTemplate" x:DataType="vm:FootnoteConversionNode">
      <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="FootnoteConversionReferenceCellTemplate" x:DataType="vm:FootnoteConversionNode">
      <TextBlock Classes="referenceCell" Text="{Binding Reference}" VerticalAlignment="Stretch" TextTrimming="CharacterEllipsis"
                 Background="Transparent" ToolTip.Tip="{Binding Reference}" DoubleTapped="OnReferenceDoubleTapped" />
    </DataTemplate>
    <DataTemplate x:Key="FootnoteConversionNoteCellTemplate" x:DataType="vm:FootnoteConversionNode">
      <TextBlock Classes="noteCell" Text="{Binding Note}" VerticalAlignment="Stretch" TextTrimming="CharacterEllipsis"
                 Background="Transparent" ToolTip.Tip="{Binding Note}" DoubleTapped="OnNoteDoubleTapped" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button x:Name="ConvertButton" Content="{loc:Loc FootnoteConversionWindow_Convert}"
              Command="{Binding ConvertCommand}" MinWidth="80" />
      <Button x:Name="CloseButton" Content="{loc:Loc Common_Close}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc FootnoteConversionWindow_Intro}" TextWrapping="Wrap" Margin="0,0,0,12" />

    <!-- What went wrong in the last conversion. -->
    <Border DockPanel.Dock="Bottom" Classes="section" Margin="0,10,0,0" IsVisible="{Binding HasProblems}">
      <StackPanel Spacing="4">
        <TextBlock Classes="warningNote" Text="{Binding ProblemsTitle}" FontWeight="SemiBold" />
        <!-- Each problem: what is wrong, where the footnote was and, for a text that changed, the text before and after; a click
             goes to the note (the book was brought back, so it is where it was). -->
        <ScrollViewer MaxHeight="160">
          <ItemsControl ItemsSource="{Binding Problems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FootnoteConversionProblemRow">
                <Panel Margin="12,0,0,6">
                  <HyperlinkButton Command="{Binding GoTo}" IsVisible="{Binding IsLink}" Padding="0" HorizontalAlignment="Left"
                                   ToolTip.Tip="{loc:Loc FootnoteConversionWindow_ProblemGoTo}">
                    <TextBlock Classes="warning" Text="{Binding Text}" TextWrapping="Wrap" />
                  </HyperlinkButton>
                  <TextBlock Classes="warning" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding !IsLink}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- The notes file of the global footnotes: only when a checked footnote is global. -->
    <Border DockPanel.Dock="Bottom" Classes="section" Margin="0,10,0,0" IsVisible="{Binding NeedsGlobalFile}">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Loc FootnoteConversionWindow_GlobalFile}" FontWeight="SemiBold" />
        <TextBlock Classes="note" Text="{loc:Loc FootnoteConversionWindow_GlobalFileHint}" />
        <ListBox x:Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                 MaxHeight="140">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FootnoteConversionFileViewModel">
              <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="section" Margin="0,10,0,0" IsVisible="{Binding HasItems}">
      <StackPanel Spacing="2">
        <CheckBox Content="{loc:Loc FootnoteConversionWindow_KeepClasses}" IsChecked="{Binding KeepClasses, Mode=TwoWay}" />
        <TextBlock Classes="note" Text="{loc:Loc FootnoteConversionWindow_KeepClassesHint}" Margin="28,0,0,0" />
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc FootnoteConversionWindow_None}" IsVisible="{Binding !HasItems}" />

    <DockPanel IsVisible="{Binding HasItems}">
      <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8" ItemSpacing="8" LineSpacing="4">
        <CheckBox x:Name="OnlyWarningsBox" Content="{Binding OnlyWarningsText}" IsChecked="{Binding OnlyWarnings, Mode=TwoWay}"
                  VerticalAlignment="Center" />
        <Button Content="{loc:Loc FootnoteConversionWindow_SelectAll}" Command="{Binding SelectAllCommand}" />
        <Button Content="{loc:Loc FootnoteConversionWindow_SelectNone}" Command="{Binding SelectNoneCommand}" />
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Classes="note" Text="{loc:Loc FootnoteConversionWindow_DoubleClickHint}" VerticalAlignment="Center" />
      </WrapPanel>

      <!-- The tree of the footnotes and, under the splitter (the window's owner remembers its place), the details of
           the selected row. -->
      <Grid x:Name="Split">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition Height="8" />
          <RowDefinition Height="170" MinHeight="60" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{DynamicResource SignetFrameBrush}" BorderThickness="1">
          <TreeDataGrid x:Name="Tree" />
        </Border>
        <GridSplitter x:Name="DetailsSplitter" Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />
        <Border Grid.Row="2" BorderBrush="{DynamicResource SignetFrameBrush}" BorderThickness="1" Padding="8,6">
          <ScrollViewer>
            <Panel>
              <TextBlock Classes="note" Text="{loc:Loc FootnoteConversionWindow_NoSelection}" IsVisible="{Binding !HasSelection}" />
              <StackPanel x:Name="Details" Spacing="4" DataContext="{Binding Selected}" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}"
                          x:DataType="vm:FootnoteConversionNode">
                <TextBlock Text="{Binding DetailTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding DetailWarnings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="warning" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="NoticeList" ItemsSource="{Binding DetailNotices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding StringFormat='ℹ {0}'}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="PlaceList" ItemsSource="{Binding Places}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FootnoteConversionPlace">
                      <StackPanel Spacing="1" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Location}" VerticalAlignment="Center" />
                          <Button Content="{loc:Loc FootnoteConversionWindow_GoTo}" Command="{Binding GoTo}" Padding="8,1" />
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="16,0,0,0"
                                             IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Panel>
          </ScrollViewer>
        </Border>
      </Grid>
    </DockPanel>
  </DockPanel>
</Window>
