<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.ColorPickerWindow"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{loc:Loc ColorPickerWindow_Title}">

  <!-- #RRGGBB color picker for the color fields in Preferences: spectrum, sliders, palette and a hex field;
       no alpha channel (all Code View colors are opaque). OK sets the color, Cancel does not. -->
  <StackPanel Margin="16" Spacing="12">
    <ColorView x:Name="Picker"
               IsAlphaEnabled="False" IsAlphaVisible="False"
               IsColorPreviewVisible="True" IsColorModelVisible="True" IsHexInputVisible="True" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="80"
              HorizontalContentAlignment="Center" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80"
              HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</Window>
