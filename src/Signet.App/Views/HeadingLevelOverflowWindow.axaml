<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Signet.App.Views"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.HeadingLevelOverflowWindow"
        Width="520" Height="380"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc HeadingSelectorWindow_HeadingLevelOverflowTitle}">

  <Window.Resources>
    <DataTemplate x:Key="HeadingTemplate" x:DataType="views:HeadingOverflowEntry">
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Padding="6,4" Click="OnShowHeadingClick" ToolTip.Tip="{loc:Loc HeadingSelectorWindow_ShowHeadingTip}">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" Opacity="0.7" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button x:Name="ContinueButton" Content="{loc:Loc HeadingSelectorWindow_Continue}"
              IsDefault="True" MinWidth="100" Click="OnContinueClick" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}"
              IsCancel="True" MinWidth="80" Click="OnCancelClick" />
    </StackPanel>

    <StackPanel Spacing="12">
      <TextBlock Text="{loc:Loc HeadingSelectorWindow_HeadingLevelOverflowMessage}" TextWrapping="Wrap" />
      <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="HeadingList" ItemTemplate="{StaticResource HeadingTemplate}" />
      </ScrollViewer>
    </StackPanel>
  </DockPanel>
</Window>
