<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.BookmarksView"
             x:DataType="vm:BookmarksViewModel">

  <UserControl.Resources>
    <!-- The one column of the tree: a file with the number of its bookmarks, or the line of a bookmark with its text. -->
    <DataTemplate x:Key="BookmarkTextCellTemplate" x:DataType="vm:BookmarkNode">
      <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding Text}" />
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <!-- Left toolbar, like the Bookmarks tool window of the JetBrains IDEs. The buttons are the shared "panelTool" style
         in App.axaml. -->
    <Border DockPanel.Dock="Left" BorderThickness="0,0,1,0" Padding="2"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="4">
        <Button x:Name="DeleteButton" Classes="panelTool" Command="{Binding DeleteCommand}"
                ToolTip.Tip="{loc:Loc Bookmarks_Delete}">
          <!-- Material Design "minus" icon (Apache License 2.0). -->
          <Path Data="M19,13H5V11H19V13Z" />
        </Button>
        <Button x:Name="ClearButton" Classes="panelTool" Command="{Binding ClearCommand}"
                ToolTip.Tip="{loc:Loc Bookmarks_Clear}">
          <!-- Material Design "delete-sweep" icon (Apache License 2.0). -->
          <Path Data="M15,16H19V18H15V16M15,8H22V10H15V8M15,12H21V14H15V12M3,18A2,2 0 0,0 5,20H11A2,2 0 0,0 13,18V8H3V18M14,5H11L10,4H6L5,5H2V7H14V5Z" />
        </Button>
      </StackPanel>
    </Border>

    <Panel>
      <TextBlock Text="{loc:Loc Bookmarks_None}" IsVisible="{Binding !HasBookmarks}"
                 Margin="16" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top" />

      <!-- The bookmarks tree; its source is built in the code-behind. -->
      <TreeDataGrid x:Name="Tree" IsVisible="{Binding HasBookmarks}" ShowColumnHeaders="False" />
    </Panel>
  </DockPanel>
</UserControl>
