<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:infra="using:Signet.App.Infrastructure"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.FontSettingView"
             x:DataType="vm:FontSettingViewModel">
  <!-- One font setting of a "Fonts" page: the font as one line (typeface, size, weight) and "Choose…" (the font picker
       window with a search). A setting that is only a size has a size field. -->
  <!-- Every setting is a box of its own (the "section" card style of the Preferences window), so that the settings are told apart. -->
  <Border Classes="section">
  <StackPanel Spacing="4">
    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <!-- A setting with a parent can use the parent's font instead of its own: "Use: <where the parent is> <its font>"; the
         link goes to the parent setting. While it is checked the controls below are switched off. -->
    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasInheritance}">
      <CheckBox x:Name="InheritBox" Classes="noSearch" Content="{loc:Loc PreferencesWindow_FontInheritUse}"
                IsChecked="{Binding InheritFromParent}" MinWidth="0" />
      <HyperlinkButton x:Name="ParentLink" Classes="noSearch" Content="{Binding ParentPath}" Padding="0" VerticalAlignment="Center"
                       ToolTip.Tip="{loc:Loc PreferencesWindow_FontInheritGoTo}" Click="OnParentLinkClick" />
      <TextBlock Classes="noSearch" Text="{Binding ParentFont}" Opacity="0.7" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel x:Name="OwnFontControls" Spacing="4" IsEnabled="{Binding IsOwnFont}">
    <!-- The font as one line; "Choose…" (the font picker, which shows its changes in the preview at once) is the only way to change it. -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasFamily}">
      <TextBlock x:Name="FontSummary" Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding Summary}" />
      <Button x:Name="ChooseButton" Grid.Column="1" Content="{loc:Loc PreferencesWindow_ChooseFont}" Command="{Binding ChooseCommand}" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSizeOnly}">
      <NumericUpDown x:Name="SizeBox" Value="{Binding Size}" Minimum="{Binding MinSize}" Maximum="{Binding MaxSize}"
                     Increment="1" FormatString="0" Width="130" />
    </StackPanel>
    </StackPanel>
  </StackPanel>
  </Border>
</UserControl>
