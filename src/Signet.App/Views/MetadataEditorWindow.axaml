<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.MetadataEditorWindow"
        x:DataType="vm:MetadataEditorViewModel"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc MetadataEditorWindow_Title}">

  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="90" Command="{Binding AcceptCommand}" />
      <Button Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" Command="{Binding CancelCommand}" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Margin="0,8,0,0"
               TextWrapping="Wrap" Foreground="{DynamicResource SystemAccentColor}"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" Spacing="4">
      <Button x:Name="AddElementButton" Content="{loc:Loc MetadataEditorWindow_AddElement}" HorizontalAlignment="Stretch"
              ToolTip.Tip="{loc:Loc MetadataEditorWindow_AddElementTip}" />
      <Button x:Name="AddPropertyButton" Content="{loc:Loc MetadataEditorWindow_AddProperty}" HorizontalAlignment="Stretch"
              ToolTip.Tip="{loc:Loc MetadataEditorWindow_AddPropertyTip}" />
      <Button Content="{loc:Loc MetadataEditorWindow_RemoveRow}" HorizontalAlignment="Stretch" Command="{Binding RemoveCommand}" />
      <Separator />
      <UniformGrid Columns="2">
        <Button Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="{loc:Loc EditTocWindow_MoveUpTip}" />
        <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="{loc:Loc EditTocWindow_MoveDownTip}" />
      </UniformGrid>
    </StackPanel>

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1">
      <TreeView x:Name="Tree"
                ItemsSource="{Binding Nodes}"
                SelectionMode="Single">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:MetadataNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem x:Name="AddElementMenuItem" Header="{loc:Loc MetadataEditorWindow_AddElementMenu}" />
            <MenuItem x:Name="AddPropertyMenuItem" Header="{loc:Loc MetadataEditorWindow_AddPropertyMenu}" />
            <MenuItem Header="{loc:Loc MetadataEditorWindow_RemoveRow}" Command="{Binding RemoveCommand}" />
            <MenuItem Header="{loc:Loc MetadataEditorWindow_MoveRowUp}" Command="{Binding MoveUpCommand}" />
            <MenuItem Header="{loc:Loc MetadataEditorWindow_MoveRowDown}" Command="{Binding MoveDownCommand}" />
          </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:MetadataNodeViewModel" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="*,2*" ColumnSpacing="6" Margin="0,1" MinHeight="26">
              <TextBlock Grid.Column="0" Text="{Binding NameDisplay}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding Content, Mode=TwoWay}"
                       BorderThickness="0" Background="Transparent" Padding="2,1" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>
  </DockPanel>
</Window>
