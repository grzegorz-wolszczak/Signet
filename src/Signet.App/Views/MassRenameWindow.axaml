<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.MassRenameWindow"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc MassRenameWindow_Title}">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Opacity="0.8" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,6,0,0">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc MassRenameWindow_Prefix}" VerticalAlignment="Center" />
        <TextBox x:Name="PrefixBox" Grid.Row="0" Grid.Column="1" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc MassRenameWindow_StartNumber}" VerticalAlignment="Center" />
        <NumericUpDown x:Name="StartNumberBox" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="999999999"
                       Increment="1" FormatString="0" HorizontalAlignment="Left" Width="160" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc MassRenameWindow_PaddingChar}" VerticalAlignment="Center" />
        <TextBox x:Name="PaddingCharBox" Grid.Row="2" Grid.Column="1" MaxLength="1" HorizontalAlignment="Left" Width="60" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc MassRenameWindow_MinLength}" VerticalAlignment="Center" />
        <NumericUpDown x:Name="MinLengthBox" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="30"
                       Increment="1" FormatString="0" HorizontalAlignment="Left" Width="160" />
      </Grid>
      <CheckBox x:Name="BookOrderBox" Content="{loc:Loc MassRenameWindow_BookOrder}"
                ToolTip.Tip="{loc:Loc MassRenameWindow_BookOrderTip}" />
      <TextBlock x:Name="ExampleText" FontFamily="Consolas,Menlo,monospace" />
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SignetRenameErrorTextBrush}" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton" Content="{loc:Loc MassRenameWindow_RenameButton}" IsDefault="True" MinWidth="100" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <Border BorderBrush="{DynamicResource SignetFrameBrush}" BorderThickness="1">
      <ScrollViewer>
        <ItemsControl x:Name="PreviewList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Padding="4,2" FontFamily="Consolas,Menlo,monospace" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
