<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.ToolbarCustomizeWindow"
        x:DataType="vm:ToolbarCustomizeViewModel"
        Title="{loc:Loc ToolbarCustomizeWindow_Title}"
        Width="640" Height="440"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto" Margin="12" >

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="{loc:Loc ToolbarCustomizeWindow_Toolbar}" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Toolbars}"
                SelectedItem="{Binding SelectedToolbar}"
                MinWidth="160">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static vm:ToolbarCustomizeViewModel.ToolbarNameConverter}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ToolbarCustomizeWindow_AvailableActions}" FontWeight="Bold" Margin="0,0,0,4" />
        <ListBox ItemsSource="{Binding AvailableActions}"
                 SelectedItem="{Binding SelectedAvailable}" />
      </DockPanel>

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="8,0">
        <Button Content="{loc:Loc ToolbarCustomizeWindow_Add}" Command="{Binding AddCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ToolbarCustomizeWindow_AddSeparator}" Command="{Binding AddSeparatorCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ToolbarCustomizeWindow_Up}" Command="{Binding MoveUpCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ToolbarCustomizeWindow_Down}" Command="{Binding MoveDownCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ToolbarCustomizeWindow_Remove}" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ToolbarCustomizeWindow_CurrentLayout}" FontWeight="Bold" Margin="0,0,0,4" />
        <ListBox ItemsSource="{Binding CurrentItems}"
                 SelectedItem="{Binding SelectedCurrent}" />
      </DockPanel>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="{loc:Loc ToolbarCustomizeWindow_ResetAll}" Command="{Binding ResetAllCommand}" />
      <Button Content="{loc:Loc Common_Close}" Click="OnCloseClick" IsDefault="True" />
    </StackPanel>

  </Grid>

</Window>
