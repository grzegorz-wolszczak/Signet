<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        xmlns:infra="using:Signet.App.Infrastructure"
        x:Class="Signet.App.Views.ToolbarCustomizeWindow"
        x:DataType="vm:ToolbarCustomizeViewModel"
        Title="{loc:Loc ToolbarCustomizeWindow_Title}"
        Width="640" Height="440"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <!-- A list entry: a column for the icon (the same width for every entry, empty when the action has no icon), then
         the text. A built-in set gives a colored DrawingImage, "Custom" a monochrome geometry (as on the toolbars). The
         icons are drawn at the biggest toolbar size (ToolbarAppearance.BigIconPixels, 32 px), so that what a button
         will look like can be seen while the toolbar is edited. -->
    <DataTemplate x:Key="EntryTemplate" x:DataType="vm:ToolbarEntry">
      <Grid ColumnDefinitions="40,*" Margin="0,2">
        <Image Grid.Column="0" Width="32" Height="32" HorizontalAlignment="Left"
               Source="{Binding IconKey, Converter={x:Static infra:IconKeyToImageConverter.Instance}}"
               IsVisible="{Binding $self.Source, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <PathIcon Grid.Column="0" Width="32" Height="32" HorizontalAlignment="Left"
                  Data="{Binding IconKey, Converter={x:Static infra:IconKeyToGeometryConverter.Instance}}"
                  IsVisible="{Binding $self.Data, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" Margin="12" >

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="{loc:Loc ToolbarCustomizeWindow_Toolbar}" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Toolbars}"
                SelectedItem="{Binding SelectedToolbar}"
                MinWidth="160">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static vm:ToolbarCustomizeViewModel.ToolbarNameConverter}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ToolbarCustomizeWindow_AvailableActions}" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox DockPanel.Dock="Top"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="{loc:Loc ToolbarCustomizeWindow_SearchPlaceholder}"
                 Margin="0,0,0,4">
          <TextBox.InnerLeftContent>
            <Path Classes="filterSearchIcon" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Content="✕" Padding="6,2" Background="Transparent" Focusable="False"
                    ToolTip.Tip="{loc:Loc ToolbarCustomizeWindow_ClearSearch}"
                    Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </TextBox.InnerRightContent>
        </TextBox>
        <ListBox ItemsSource="{Binding FilteredAvailableActions}"
                 SelectedItem="{Binding SelectedAvailable}"
                 ItemTemplate="{StaticResource EntryTemplate}" />
      </DockPanel>

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="8,0">
        <Button Content="{loc:Loc ToolbarCustomizeWindow_Add}" Command="{Binding AddCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ToolbarCustomizeWindow_AddSeparator}" Command="{Binding AddSeparatorCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ToolbarCustomizeWindow_Up}" Command="{Binding MoveUpCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ToolbarCustomizeWindow_Down}" Command="{Binding MoveDownCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ToolbarCustomizeWindow_Remove}" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ToolbarCustomizeWindow_CurrentLayout}" FontWeight="Bold" Margin="0,0,0,4" />
        <ListBox ItemsSource="{Binding CurrentItems}"
                 SelectedItem="{Binding SelectedCurrent}"
                 ItemTemplate="{StaticResource EntryTemplate}" />
      </DockPanel>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="{loc:Loc ToolbarCustomizeWindow_ResetAll}" Command="{Binding ResetAllCommand}" />
      <Button Content="{loc:Loc Common_Close}" Click="OnCloseClick" IsDefault="True" />
    </StackPanel>

  </Grid>

</Window>
