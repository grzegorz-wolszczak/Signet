<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.ImageResizeWindow"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{loc:Loc ImageResizeWindow_Title}">

  <StackPanel Margin="16" Spacing="10">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc ImageResizeWindow_Width}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="WidthBox"
                     Minimum="1" Maximum="20000" Increment="1" FormatString="0" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc ImageResizeWindow_Height}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="HeightBox"
                     Minimum="1" Maximum="20000" Increment="1" FormatString="0" />
    </Grid>

    <CheckBox x:Name="KeepAspect" Content="{loc:Loc ImageResizeWindow_KeepAspectRatio}" IsChecked="True" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="80" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
