<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.SelectIdWindow"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{loc:Loc SelectIdWindow_Title}">

  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="{loc:Loc SelectIdWindow_Prompt}" TextWrapping="Wrap" />
    <AutoCompleteBox x:Name="IdInput" FilterMode="ContainsOrdinal" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="80" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
