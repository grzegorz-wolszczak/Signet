<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        xmlns:v="using:Signet.App.Views"
        x:Class="Signet.App.Views.CleanupWindow"
        infra:TooltipFonts.Area="Cleanup"
        x:DataType="vm:CleanupViewModel"
        Width="760" Height="700" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc CleanupWindow_Title}">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CloseButton" Content="{loc:Loc Common_Close}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <v:CleanupView />
  </DockPanel>
</Window>
