<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.FontRemovalWindow"
        x:DataType="vm:FontRemovalViewModel"
        Width="860" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc FontRemovalWindow_Title}">

  <Window.Styles>
    <!-- Each part as a card, like the sections of Cleanup. -->
    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- An item: a check box for a change, ⚠ for a note; double click opens the place. -->
    <DataTemplate x:Key="ItemTemplate" x:DataType="vm:FontRemovalItemViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsVisible="{Binding IsActionable}" />
        <TextBlock Grid.Column="0" Text="⚠" IsVisible="{Binding IsNote}" FontWeight="Bold"
                   Foreground="{DynamicResource SignetWarningBrush}" Margin="4,0,8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0" />
        <TextBlock Grid.Column="2" Text="{Binding FileText}" Classes="note" VerticalAlignment="Center" Margin="8,0,4,0" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="DeleteButton" Classes="danger" Content="{loc:Loc Common_Delete}" MinWidth="80" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="{loc:Loc FontRemovalWindow_Intro}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding FilesText}" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock Classes="note" Text="{loc:Loc FontRemovalWindow_DoubleClickHint}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel>
        <Border Classes="section" IsVisible="{Binding HasRuleItems}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc FontRemovalWindow_Rules}" FontWeight="SemiBold" />
            <TextBlock Classes="note" Text="{loc:Loc FontRemovalWindow_RulesNote}" />
            <ListBox ItemsSource="{Binding RuleItems}" ItemTemplate="{StaticResource ItemTemplate}"
                     DoubleTapped="OnItemsDoubleTapped" />
          </StackPanel>
        </Border>

        <Border Classes="section" IsVisible="{Binding HasUsageItems}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc FontRemovalWindow_Usages}" FontWeight="SemiBold" />
            <TextBlock Classes="warningNote" Text="{loc:Loc FontRemovalWindow_UsagesNote}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Loc CleanupWindow_SelectAll}" Command="{Binding SelectAllUsagesCommand}" />
              <Button Content="{loc:Loc CleanupWindow_SelectNone}" Command="{Binding SelectNoUsagesCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding UsageItems}" ItemTemplate="{StaticResource ItemTemplate}"
                     DoubleTapped="OnItemsDoubleTapped" />
          </StackPanel>
        </Border>

        <Border Classes="section" IsVisible="{Binding HasNotes}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc FontRemovalWindow_Notes}" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource ItemTemplate}"
                     DoubleTapped="OnItemsDoubleTapped" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
