<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.AddFootnoteWindow"
        x:DataType="vm:AddFootnoteViewModel"
        Width="600" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc AddFootnoteWindow_Title}">

  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="{loc:Loc AddFootnoteWindow_Where}" />
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1"
            CornerRadius="4" Padding="8,6">
      <!-- The runs are on one line: whitespace between them would show as spaces around the marker. -->
      <TextBlock x:Name="ContextText" TextWrapping="Wrap" Opacity="0.85"><Run Text="{Binding ContextBefore}" /><Run
          Text="{Binding Marker}" FontWeight="Bold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" /><Run
          Text="{Binding ContextAfter}" /></TextBlock>
    </Border>

    <TextBlock Text="{loc:Loc AddFootnoteWindow_Content}" Margin="0,4,0,0" />
    <TextBox x:Name="ContentBox" Text="{Binding Content, Mode=TwoWay}"
             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="260" />
    <TextBlock Text="{loc:Loc AddFootnoteWindow_ContentHint}" Opacity="0.7" TextWrapping="Wrap" />
    <TextBlock Text="{Binding ValidationError}"
               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
               TextWrapping="Wrap"
               IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Spacing="8" Margin="0,6,0,0">
      <RadioButton GroupName="Placement" Content="{loc:Loc AddFootnoteWindow_Local}"
                   IsChecked="{Binding IsLocal, Mode=TwoWay}" />
      <RadioButton GroupName="Placement" Content="{loc:Loc AddFootnoteWindow_Global}"
                   IsChecked="{Binding IsGlobal, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="OkButton" Content="{loc:Loc AddFootnoteWindow_AddButton}" MinWidth="100"
              IsEnabled="{Binding CanAccept}" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
