<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.FontPickerWindow"
        x:DataType="vm:FontPickerViewModel"
        Width="520" Height="560" MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc FontPickerWindow_Title}">

  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton" Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="80"
              IsEnabled="{Binding CanAccept}" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <!-- Preview of the selected font at the chosen size. -->
    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10" MinHeight="70" CornerRadius="4"
            BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <TextBlock x:Name="SampleText" Text="{loc:Loc FontPickerWindow_Sample}" TextWrapping="Wrap"
                 FontFamily="{Binding SelectedFont.Family, FallbackValue={x:Static FontFamily.Default}}"
                 FontSize="{Binding Size}" VerticalAlignment="Center" />
    </Border>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,120" ColumnSpacing="8" Margin="0,10,0,0"
          IsVisible="{Binding ShowSize}" HorizontalAlignment="Left">
      <TextBlock Text="{loc:Loc FontPickerWindow_Size}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" x:Name="SizeBox" Value="{Binding Size}" Minimum="6" Maximum="72"
                     Increment="1" FormatString="0" />
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,8">
      <TextBox x:Name="FilterBox" Text="{Binding Filter}" PlaceholderText="{loc:Loc FontPickerWindow_Search}" />
      <CheckBox Grid.Column="1" Content="{loc:Loc FontPickerWindow_MonospaceOnly}" IsChecked="{Binding MonospaceOnly}"
                VerticalAlignment="Center" />
    </Grid>

    <!-- Each name is rendered in its own font. The ListBox virtualizes rows, so with several hundred
         fonts only the visible ones are loaded. -->
    <ListBox x:Name="FontList" ItemsSource="{Binding VisibleFonts}" SelectedItem="{Binding SelectedFont}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="infra:FontEntry">
          <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="16" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
