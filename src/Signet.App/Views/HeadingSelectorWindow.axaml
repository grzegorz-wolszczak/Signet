<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.HeadingSelectorWindow"
        x:DataType="vm:HeadingSelectorViewModel"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc HeadingSelectorWindow_Title}">

  <Window.Resources>
    <!-- Cell templates of the headings tree (looked up by key from the code-behind): the title is edited in place, the
         check box includes the heading in the TOC. -->
    <DataTemplate x:Key="TitleCellTemplate" x:DataType="vm:HeadingNodeViewModel">
      <TextBox Text="{Binding TitleText, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="2,1" />
    </DataTemplate>
    <DataTemplate x:Key="IncludeCellTemplate" x:DataType="vm:HeadingNodeViewModel">
      <CheckBox IsChecked="{Binding IncludeInToc, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                ToolTip.Tip="{loc:Loc HeadingSelectorWindow_IncludeInTocTip}" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="90" Command="{Binding AcceptCommand}" />
      <Button Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" Command="{Binding CancelCommand}" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountsSummary}" Opacity="0.7" Margin="0,8,0,0" />

    <ComboBox DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Left" MinWidth="260"
              ItemsSource="{Binding LevelChoices}"
              SelectedIndex="{Binding SelectedLevelChoiceIndex}"
              ToolTip.Tip="{loc:Loc HeadingSelectorWindow_LevelChoiceTip}" />

    <CheckBox DockPanel.Dock="Bottom" Margin="0,8,0,0" Content="{loc:Loc HeadingSelectorWindow_TocItemsOnly}"
              IsChecked="{Binding TocItemsOnly}" />

    <StackPanel DockPanel.Dock="Right" Width="46" Margin="8,0,0,0" Spacing="6">
      <Button Content="◀" MinWidth="40" Command="{Binding DecreaseLevelCommand}"
              ToolTip.Tip="{loc:Loc HeadingSelectorWindow_DecreaseLevelTip}" />
      <Button Content="▶" MinWidth="40" Command="{Binding IncreaseLevelCommand}"
              ToolTip.Tip="{loc:Loc HeadingSelectorWindow_IncreaseLevelTip}" />
    </StackPanel>

    <Border BorderBrush="Gray" BorderThickness="1">
      <!-- The headings tree (Title, Level, In TOC), not sortable; source built in the code-behind, the selection
           follows SelectedNode. -->
      <TreeDataGrid x:Name="Tree" CanUserSortColumns="False" />
    </Border>
  </DockPanel>
</Window>
