<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.HeadingSelectorWindow"
        infra:TooltipFonts.Area="TableOfContents"
        x:DataType="vm:HeadingSelectorViewModel"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc HeadingSelectorWindow_Title}">

  <Window.Resources>
    <!-- The title is read-only until editing starts; the check box includes the heading in the TOC. -->
    <DataTemplate x:Key="TitleCellTemplate" x:DataType="vm:HeadingNodeViewModel">
      <TextBlock Text="{Binding TitleText}" Padding="2,1" VerticalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TitleEditingTemplate" x:DataType="vm:HeadingNodeViewModel">
      <TextBox Text="{Binding TitleText, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="2,1" />
    </DataTemplate>
    <DataTemplate x:Key="IncludeCellTemplate" x:DataType="vm:HeadingNodeViewModel">
      <CheckBox IsChecked="{Binding IncludeInToc, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                ToolTip.Tip="{loc:Loc HeadingSelectorWindow_IncludeInTocTip}" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="{loc:Loc Common_Ok}" IsDefault="True" MinWidth="90" Command="{Binding AcceptCommand}" />
      <Button Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" Command="{Binding CancelCommand}" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountsSummary}" Opacity="0.7" Margin="0,8,0,0" />

    <ComboBox DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Left" MinWidth="260"
              ItemsSource="{Binding LevelChoices}"
              SelectedIndex="{Binding SelectedLevelChoiceIndex}"
              ToolTip.Tip="{loc:Loc HeadingSelectorWindow_LevelChoiceTip}" />

    <CheckBox DockPanel.Dock="Bottom" Margin="0,8,0,0" Content="{loc:Loc HeadingSelectorWindow_TocItemsOnly}"
              IsChecked="{Binding TocItemsOnly}" />

    <CheckBox DockPanel.Dock="Bottom" Margin="0,8,0,0"
              Content="{loc:Loc HeadingSelectorWindow_UpdateChildHeadingsLevels}"
              IsChecked="{Binding UpdateChildHeadingsLevels}" />

    <Border DockPanel.Dock="Left" BorderThickness="0,0,1,0" Padding="2"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="4">
        <Button x:Name="ExpandAllButton" Classes="panelTool" Command="{Binding ExpandAllCommand}"
                ToolTip.Tip="{loc:Loc HeadingSelectorWindow_ExpandAllTip}">
          <Path Data="M8.42,9.29L12,5.72L15.58,9.29L16.68,8.19L12,3.51L7.32,8.19Z M8.42,14.71L12,18.28L15.58,14.71L16.68,15.81L12,20.49L7.32,15.81Z" />
        </Button>
        <Button x:Name="CollapseAllButton" Classes="panelTool" Command="{Binding CollapseAllCommand}"
                ToolTip.Tip="{loc:Loc HeadingSelectorWindow_CollapseAllTip}">
          <Path Data="M8.42,4.11L12,7.68L15.58,4.11L16.68,5.21L12,9.89L7.32,5.21Z M8.42,19.89L12,16.32L15.58,19.89L16.68,18.79L12,14.11L7.32,18.79Z" />
        </Button>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Right" Width="46" Margin="8,0,0,0" Spacing="6">
      <Button Content="◀" MinWidth="40" Command="{Binding DecreaseLevelCommand}"
              ToolTip.Tip="{loc:Loc HeadingSelectorWindow_DecreaseLevelTip}" />
      <Button Content="▶" MinWidth="40" Command="{Binding IncreaseLevelCommand}"
              ToolTip.Tip="{loc:Loc HeadingSelectorWindow_IncreaseLevelTip}" />
      <Button x:Name="EditTitleButton" MinWidth="40" Command="{Binding EditTitleCommand}"
              ToolTip.Tip="{loc:Loc HeadingSelectorWindow_EditTitleTip}">
        <PathIcon Width="16" Height="16" Data="M 11 1 L 15 5 L 6 14 L 1 15 L 2 10 Z M 10 3 L 13 6" />
      </Button>
    </StackPanel>

    <Border BorderBrush="{DynamicResource SignetFrameBrush}" BorderThickness="1">
      <!-- The headings tree (Title, Level, In TOC), not sortable; source built in the code-behind, the selection
           follows SelectedNode. -->
      <TreeDataGrid x:Name="Tree" CanUserSortColumns="False" KeepEstimatedScrollExtentStable="True" />
    </Border>
  </DockPanel>
</Window>
