<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:nwv="clr-namespace:NativeWebView.Controls;assembly=NativeWebView"
             xmlns:loc="using:Signet.App.Resources"
             xmlns:infra="using:Signet.App.Infrastructure"
             xmlns:views="using:Signet.App.Views"
             x:Class="Signet.App.Views.PreviewView"
             infra:TooltipFonts.Area="Preview"
             x:DataType="vm:PreviewViewModel">

  <UserControl.Styles>
    <!-- Flat icon buttons. -->
    <Style Selector="Button.previewTool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Button.previewTool:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.previewTool:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </UserControl.Styles>

  <!-- Layout: the page on top, the panel's own toolbar at the bottom (ToolbarId.Preview — its buttons are configured
       like those of any other toolbar) and, always at its end, the preview's own zoom bar (− NN% +), which is not an
       item of the toolbar and cannot be taken off it. -->
  <Grid RowDefinitions="*,Auto">

    <!-- The page: grayed out while no book is open (the toolbar under it stays enabled). -->
    <Panel Grid.Row="0" IsEnabled="{Binding IsContentEnabled}">
      <!-- Opacity="0" until the first real frame: in GpuSurface mode the library, before WebView2
           delivers an image, shows a synthetic test frame (a colored pattern) — see PreviewView.OnRenderFrameCaptured. -->
      <nwv:NativeWebView x:Name="WebView" RenderMode="GpuSurface" Opacity="0" />

      <TextBlock Text="{loc:Loc PreviewView_OpenFileToPreview}"
                 IsVisible="{Binding !HasContent}"
                 Margin="16"
                 Opacity="0.6"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top" />

      <TextBlock x:Name="FallbackText"
                 IsVisible="False"
                 Margin="16"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top" />
    </Panel>

    <!-- The look of this toolbar is its own (ToolbarManager.PreviewAppearance): the code-behind puts it into the
         resources of this border, which come before the application's (those hold the look of the main window's
         toolbars). -->
    <Border x:Name="ToolbarHost"
            Grid.Row="1"
            Padding="1"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Separator Width="1" Height="16" Margin="4,0" VerticalAlignment="Center"
                     Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
          <Button Classes="previewTool" Content="−" Command="{Binding ZoomOutCommand}" Padding="6,0"
                  VerticalAlignment="Center" ToolTip.Tip="{loc:Loc PreviewView_ZoomOut}" />
          <Button Classes="previewTool" Content="{Binding ZoomPercentText}" Command="{Binding ZoomResetCommand}"
                  Padding="4,0" MinWidth="44" FontSize="11" VerticalAlignment="Center"
                  HorizontalContentAlignment="Center" ToolTip.Tip="{loc:Loc PreviewView_ZoomReset}" />
          <Button Classes="previewTool" Content="+" Command="{Binding ZoomInCommand}" Padding="6,0"
                  VerticalAlignment="Center" ToolTip.Tip="{loc:Loc PreviewView_ZoomIn}" />
        </StackPanel>
        <views:ToolbarStripView x:Name="Toolbar" DataContext="{Binding Toolbar}"
                                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
