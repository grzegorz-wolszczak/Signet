<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.ClipEditorWindow"
        x:DataType="vm:ClipsViewModel"
        Width="820" Height="560"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <!-- The name cell of the clips tree (looked up by key from the code-behind): the name as text; editing only after
         a double click or F2 (handled in ClipEditorWindow): Enter and focus loss commit, Esc cancels. -->
    <DataTemplate x:Key="NameCellTemplate" x:DataType="vm:ClipNodeViewModel">
      <Grid Background="Transparent" MinHeight="24" DoubleTapped="OnNodeDoubleTapped">
        <TextBlock Text="{Binding Name}" Classes.group="{Binding IsGroup}"
                   VerticalAlignment="Center" IsVisible="{Binding !IsEditing}" />
        <TextBox Classes="inPlaceRename" Text="{Binding EditText, Mode=TwoWay}"
                 IsVisible="{Binding IsEditing}" MinWidth="140"
                 MinHeight="0" Padding="2,0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!-- "*" in the title for unsaved changes (like the main window title). -->
  <Window.Title>
    <MultiBinding StringFormat="{}{0}{1}">
      <ReflectionBinding Path="[ClipEditorWindow_Title]" Source="{x:Static loc:Localizer.Instance}" />
      <Binding Path="ModifiedMarker" />
    </MultiBinding>
  </Window.Title>

  <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="6">

    <!-- Filter -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
      <TextBlock Text="{loc:Loc ClipEditorWindow_Filter}" VerticalAlignment="Center" />
      <TextBox Text="{Binding FilterText, Mode=TwoWay}" Width="240"
               PlaceholderText="{loc:Loc ClipEditorWindow_FilterPlaceholder}" />
      <CheckBox Content="{loc:Loc ClipEditorWindow_FilterNameAndText}" IsChecked="{Binding FilterAll, Mode=TwoWay}"
                VerticalAlignment="Center" />
    </StackPanel>

    <!-- Tree + details + button panel; the splitter between the tree and the details is remembered
         (ClipEditorWindow). -->
    <Grid x:Name="Body" Grid.Row="1" ColumnDefinitions="2*,Auto,3*,Auto" ColumnSpacing="4">
      <!-- The clips tree (Name, Text): source built in the code-behind; the filter hides nodes through
           VisibleItemsView, several nodes can be selected. Every group has an expander, even an empty one
           (hasChildren = IsGroup). -->
      <!-- TreeHost carries the key bindings of the panel-scoped actions (Rename): they fire only while the focus is
           in the tree, not in the clip text box. -->
      <Panel x:Name="TreeHost" Grid.Column="0">
        <TreeDataGrid x:Name="Tree"
                      BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
          <TreeDataGrid.Styles>
            <Style Selector="TextBlock.group">
              <Setter Property="FontWeight" Value="Bold" />
            </Style>
          </TreeDataGrid.Styles>
        </TreeDataGrid>
      </Panel>

      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="4"
            IsEnabled="{Binding SelectedNode.IsGroup, Converter={x:Static BoolConverters.Not}, FallbackValue=False}">
        <TextBlock Grid.Row="0" Text="{loc:Loc ClipEditorWindow_ClipTextLabel}" Opacity="0.8" />
        <TextBox Grid.Row="1" Text="{Binding SelectedNode.Text, Mode=TwoWay}"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" FontFamily="Cascadia Code,Consolas,monospace" />
      </Grid>

      <StackPanel Grid.Column="3" Spacing="4" Width="130" Margin="4,0,0,0">
        <Button Content="{loc:Loc ClipEditorWindow_Paste}" Command="{Binding PasteCommand}" HorizontalAlignment="Stretch" />
        <Separator />
        <Button Content="{loc:Loc ClipEditorWindow_AddEntry}" Command="{Binding AddEntryCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ClipEditorWindow_AddGroup}" Command="{Binding AddGroupCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc Common_Delete}" Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" />
        <UniformGrid Columns="4">
          <Button Content="↑" Command="{Binding MoveUpCommand}" />
          <Button Content="←" Command="{Binding MoveLeftCommand}" />
          <Button Content="→" Command="{Binding MoveRightCommand}" />
          <Button Content="↓" Command="{Binding MoveDownCommand}" />
        </UniformGrid>
        <Separator />
        <Button Content="{loc:Loc ClipEditorWindow_AutoFillCss}" Command="{Binding AutoFillCommand}" HorizontalAlignment="Stretch" />
        <Separator />
        <Button Content="{loc:Loc Common_Import}" Command="{Binding ImportCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc Common_Export}" Command="{Binding ExportCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc ClipEditorWindow_ExportAll}" Command="{Binding ExportAllCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc Common_Save}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{loc:Loc Common_Reload}" Command="{Binding ReloadCommand}" HorizontalAlignment="Stretch" />
        <UniformGrid Columns="2">
          <Button Content="{loc:Loc Common_Expand}" Command="{Binding ExpandAllCommand}" />
          <Button Content="{loc:Loc Common_Collapse}" Command="{Binding CollapseAllCommand}" />
        </UniformGrid>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding Message}"
               Foreground="{DynamicResource SystemAccentColor}" TextWrapping="Wrap" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{loc:Loc Common_Close}" Click="OnCloseClicked" MinWidth="80" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
