<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Signet.App.Resources"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:views="using:Signet.App.Views"
             x:Class="Signet.App.Views.KeymapView"
             x:DataType="vm:KeymapViewModel">

  <!-- The keymap editor modelled on IntelliJ's Keymap page: Expand All / Collapse All / Edit Shortcut, a search box
       and "Find Shortcut" above a tree of the actions with their shortcuts. A double click, Enter, the pencil or the
       context menu opens "Edit Shortcuts" (add keyboard / mouse shortcut, remove, reset). -->
  <UserControl.Resources>
    <DataTemplate x:Key="KeymapNameCellTemplate" x:DataType="vm:KeymapNode">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Background="Transparent" DoubleTapped="OnNodeDoubleTapped">
        <PathIcon Grid.Column="0" Width="14" Height="14" IsVisible="{Binding IsGroup}" Opacity="0.75"
                  Data="M 1 3 H 6 L 7.5 4.5 H 15 V 13 H 1 Z" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                   Classes.modified="{Binding IsModified}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding ShortcutsText}" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,10,0" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Actions whose shortcuts differ from the defaults, as IntelliJ shows them. -->
    <Style Selector="TextBlock.modified">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="Button.keymapTool">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="4" Margin="0,0,0,6">
      <Button Grid.Column="0" Classes="keymapTool" Click="OnExpandAllClicked" ToolTip.Tip="{loc:Loc Keymap_ExpandAll}">
        <PathIcon Width="14" Height="14" Data="M 3 3 L 8 7 L 13 3 L 13 5 L 8 9 L 3 5 Z M 3 8 L 8 12 L 13 8 L 13 10 L 8 14 L 3 10 Z" />
      </Button>
      <Button Grid.Column="1" Classes="keymapTool" Click="OnCollapseAllClicked" ToolTip.Tip="{loc:Loc Keymap_CollapseAll}">
        <PathIcon Width="14" Height="14" Data="M 3 13 L 8 9 L 13 13 L 13 11 L 8 7 L 3 11 Z M 3 8 L 8 4 L 13 8 L 13 6 L 8 2 L 3 6 Z" />
      </Button>
      <Button Grid.Column="2" Classes="keymapTool" Click="OnEditClicked" ToolTip.Tip="{loc:Loc Keymap_EditShortcut}">
        <PathIcon Width="14" Height="14" Data="M 11 1 L 15 5 L 6 14 L 1 15 L 2 10 Z M 10 3 L 13 6" />
      </Button>
      <TextBox Grid.Column="3" Text="{Binding Filter}" PlaceholderText="{loc:Loc Keymap_SearchPlaceholder}" Margin="8,0,0,0" />
      <Button x:Name="FindShortcutButton" Grid.Column="4" Classes="keymapTool" Click="OnFindShortcutClicked"
              ToolTip.Tip="{loc:Loc Keymap_FindShortcut}">
        <PathIcon Width="16" Height="16"
                  Data="M 6.5 1 A 5.5 5.5 0 1 1 6.5 12 A 5.5 5.5 0 1 1 6.5 1 Z M 6.5 3 A 3.5 3.5 0 1 0 6.5 10 A 3.5 3.5 0 1 0 6.5 3 Z M 10 10.5 L 11.5 9 L 15.5 13 L 14 14.5 Z" />
      </Button>
      <Button Grid.Column="5" Classes="keymapTool" Click="OnClearShortcutFilterClicked" IsVisible="{Binding HasShortcutFilter}"
              ToolTip.Tip="{loc:Loc Keymap_ClearShortcutFilter}" Content="✕" />
    </Grid>

    <!-- IntelliJ's "Find Shortcut" popup: press a shortcut (optionally with a second stroke) or make a mouse shortcut. -->
    <Popup x:Name="FindPopup" DockPanel.Dock="Top" PlacementTarget="{Binding #FindShortcutButton}"
           Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True">
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1"
              CornerRadius="4" Padding="10" Width="300">
        <StackPanel Spacing="6">
          <TextBlock Text="{loc:Loc Keymap_FindShortcut}" FontWeight="Bold" HorizontalAlignment="Center" />
          <views:ShortcutCaptureBox x:Name="FindFirstStroke" />
          <CheckBox x:Name="FindSecondEnabled" Content="{loc:Loc KeymapKeyboardDialog_SecondStroke}" />
          <views:ShortcutCaptureBox x:Name="FindSecondStroke" IsVisible="{Binding #FindSecondEnabled.IsChecked}" />
          <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,1,0,0"
                  IsVisible="{Binding !#FindSecondEnabled.IsChecked}">
            <views:MouseShortcutPad x:Name="FindMousePad" />
          </Border>
        </StackPanel>
      </Border>
    </Popup>

    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnResetAllClicked"
            Content="{loc:Loc PreferencesWindow_ResetAll}" />

    <Border Classes="listFrame">
      <TreeDataGrid x:Name="Tree" ShowColumnHeaders="False" />
    </Border>
  </DockPanel>
</UserControl>
