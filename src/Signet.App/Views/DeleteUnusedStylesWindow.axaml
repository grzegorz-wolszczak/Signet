<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Signet.App.Views"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.DeleteUnusedStylesWindow"
        x:DataType="v:DeleteUnusedStylesWindow"
        Width="620" Height="480"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc DeleteUnusedStylesWindow_Title}">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton" Content="{loc:Loc DeleteUnusedStylesWindow_DeleteMarked}" IsDefault="True" MinWidth="150" />
      <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <CheckBox x:Name="ToggleSelectAllCheckBox" DockPanel.Dock="Top" IsChecked="True"
              Content="{loc:Loc Common_ToggleSelectAll}" Margin="0,0,0,8" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,2*,3*" Margin="0,0,0,4">
      <TextBlock Grid.Column="1" Text="{loc:Loc DeleteUnusedStylesWindow_FileColumn}" FontWeight="Bold" Margin="4,0" />
      <TextBlock Grid.Column="2" Text="{loc:Loc DeleteUnusedStylesWindow_StyleColumn}" FontWeight="Bold" Margin="4,0" />
    </Grid>

    <ListBox x:Name="RowsList" ItemsSource="{Binding Rows}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="v:DeleteUnusedStylesRow">
          <Grid ColumnDefinitions="Auto,2*,3*">
            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
            <TextBlock Grid.Column="1" Text="{Binding CssBookPath}" Margin="4,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding SelectorText}" Margin="4,0" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
