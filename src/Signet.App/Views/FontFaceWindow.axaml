<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.FontFaceWindow"
        x:DataType="vm:FontFaceDialogViewModel"
        Width="920" Height="700" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc FontFaceDialog_Title}">

  <Window.Styles>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="4,0" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="AddButton" Classes="accent" Content="{loc:Loc FontFaceDialog_Add}" IsDefault="True" MinWidth="80"
              IsEnabled="{Binding CanAdd}" />
      <Button x:Name="SkipButton" Content="{loc:Loc FontFaceDialog_Skip}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc FontFaceDialog_Intro}" TextWrapping="Wrap" Margin="0,0,0,10" />

    <!-- The font files: the descriptors read from each file, the family editable. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="28,220,*,130,130" Margin="0,0,0,4">
      <TextBlock Grid.Column="1" Classes="header" Text="{loc:Loc FontFaceDialog_File}" />
      <TextBlock Grid.Column="2" Classes="header" Text="{loc:Loc FontFaceDialog_Family}" />
      <TextBlock Grid.Column="3" Classes="header" Text="{loc:Loc FontFaceDialog_Weight}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="4" Classes="header" Text="{loc:Loc FontFaceDialog_Style}" TextTrimming="CharacterEllipsis" />
    </Grid>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1" CornerRadius="4" Padding="4" MaxHeight="260">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FontFaceRowViewModel">
              <StackPanel Margin="0,2,0,6">
                <Grid ColumnDefinitions="28,220,*,130,130">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding !IsConflict}"
                            VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" Margin="4,0"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Candidate.BookPath}" />
                  <TextBox Grid.Column="2" Text="{Binding Family, Mode=TwoWay}" Margin="4,0" IsEnabled="{Binding !IsConflict}" />
                  <TextBox Grid.Column="3" Text="{Binding Weight, Mode=TwoWay}" Margin="4,0" IsEnabled="{Binding !IsConflict}" />
                  <ComboBox Grid.Column="4" ItemsSource="{Binding Styles}" SelectedItem="{Binding Style, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" Margin="4,0" IsEnabled="{Binding !IsConflict}" />
                </Grid>
                <TextBlock Classes="warning" Text="{Binding ConflictText}" IsVisible="{Binding IsConflict}" Margin="32,2,0,0" />
                <TextBlock Classes="warning" Text="{Binding WarningText}" IsVisible="{Binding HasWarning}" Margin="32,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Where the rules go and the optional font of body. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="10" Margin="0,12,0,0">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc FontFaceDialog_Stylesheet}" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Stylesheets}" SelectedItem="{Binding SelectedStylesheet, Mode=TwoWay}"
                MinWidth="320" />
      <CheckBox Grid.Row="1" Grid.Column="0" Content="{loc:Loc FontFaceDialog_SetBody}" IsChecked="{Binding SetBodyFont, Mode=TwoWay}" />
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding SetBodyFont}">
        <ComboBox ItemsSource="{Binding BodyFamilies}" SelectedItem="{Binding BodyFamily, Mode=TwoWay}" MinWidth="240" />
        <ComboBox ItemsSource="{Binding GenericFamilies}" SelectedItem="{Binding BodyGeneric, Mode=TwoWay}" MinWidth="130" />
      </StackPanel>
    </Grid>

    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap" />
    <TextBlock DockPanel.Dock="Top" Classes="note" Text="{loc:Loc FontFaceDialog_PreviewHint}" Margin="0,0,0,4" />

    <!-- The CSS that will be written. -->
    <TextBox Text="{Binding PreviewText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="13"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
