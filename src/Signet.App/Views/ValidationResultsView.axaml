<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.ValidationResultsView"
             x:DataType="vm:ValidationResultsViewModel">

  <Panel>
    <TextBlock Text="{loc:Loc ValidationResultsView_NoProblems}"
               IsVisible="{Binding !HasResults}"
               FontSize="16" Opacity="0.6"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

    <DataGrid x:Name="Grid"
              IsVisible="{Binding HasResults}"
              ItemsSource="{Binding Rows}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              GridLinesVisibility="Horizontal"
              DoubleTapped="OnDoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Loc ReportsWindow_File}" Binding="{Binding FileName}" Width="220" />
        <DataGridTextColumn Header="{loc:Loc ValidationResultsView_Line}" Binding="{Binding LineText}" Width="70" />
        <DataGridTextColumn Header="{loc:Loc DryRunReplaceWindow_OffsetColumn}" Binding="{Binding OffsetText}" Width="70" />
        <DataGridTextColumn Header="{loc:Loc ValidationResultsView_Message}" Binding="{Binding Message}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Panel>
</UserControl>
