<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.ValidationResultsView"
             x:DataType="vm:ValidationResultsViewModel">

  <UserControl.Styles>
    <!-- The buttons of the left toolbar: small, flat, with a vector icon (like the Find Usages panel). -->
    <Style Selector="Button.panelTool">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.panelTool Path">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Button.panelTool:disabled Path">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Left" BorderThickness="0,0,1,0" Padding="2"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="4">
        <Button x:Name="FixButton" Classes="panelTool" IsEnabled="{Binding CanFixSelection}"
                Click="OnFixClick" ToolTip.Tip="{loc:Loc ValidationResultsView_Fix}">
          <!-- Material Design "wrench" icon (Apache License 2.0). -->
          <Path Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L9,6L6,9L1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1C4.8,14 7.5,14.5 9.8,13.6L18.9,22.7C19.3,23.1 19.9,23.1 20.3,22.7L22.6,20.4C23.1,20 23.1,19.3 22.7,19Z" />
        </Button>
        <Button x:Name="FixAllButton" Classes="panelTool" IsEnabled="{Binding HasFixable}"
                Click="OnFixAllClick" ToolTip.Tip="{loc:Loc ValidationResultsView_FixAll}">
          <!-- Material Design "auto-fix" icon (Apache License 2.0): a magic wand. -->
          <Path Data="M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10 17.1,10.65 16.71,11.04L5.04,22.71C4.65,23.1 4,23.1 3.63,22.71L1.29,20.37C0.9,20 0.9,19.35 1.29,18.96L12.96,7.29C13.35,6.9 14,6.9 14.37,7.29Z" />
        </Button>
        <Button x:Name="SkippedRulesButton" Classes="panelTool" IsEnabled="{Binding HasSkippedRules}"
                ToolTip.Tip="{loc:Loc ValidationResultsView_SkippedRules}">
          <!-- Material Design "eye" icon (Apache License 2.0): show the skipped problems again. -->
          <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" />
          <Button.Flyout>
            <!-- Items are built in the code-behind when the flyout opens. -->
            <MenuFlyout Placement="RightEdgeAlignedTop" Opening="OnSkippedRulesOpening" />
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Border>

    <Panel>
      <TextBlock Text="{loc:Loc ValidationResultsView_NoProblems}"
                 IsVisible="{Binding !HasResults}"
                 FontSize="16" Opacity="0.6"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />

      <!-- Source and columns (File, Line, Offset, Fix, Message) are built in the code-behind. -->
      <TreeDataGrid x:Name="Grid"
                    Classes="gridLines"
                    IsVisible="{Binding HasResults}"
                    DoubleTapped="OnDoubleTapped">
        <TreeDataGrid.ContextMenu>
          <ContextMenu x:Name="RowMenu" Opening="OnRowMenuOpening">
            <MenuItem x:Name="FixMenuItem" Header="{loc:Loc ValidationResultsView_FixMenu}" Click="OnFixClick" />
            <MenuItem x:Name="SkipRuleMenuItem" Header="{loc:Loc ValidationResultsView_SkipRule}" Click="OnSkipRuleClick" />
          </ContextMenu>
        </TreeDataGrid.ContextMenu>
      </TreeDataGrid>
    </Panel>
  </DockPanel>
</UserControl>
