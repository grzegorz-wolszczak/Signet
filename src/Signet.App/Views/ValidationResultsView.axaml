<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.ValidationResultsView"
             x:DataType="vm:ValidationResultsViewModel">

  <Panel>
    <TextBlock Text="{loc:Loc ValidationResultsView_NoProblems}"
               IsVisible="{Binding !HasResults}"
               FontSize="16" Opacity="0.6"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

    <!-- Columns (File, Line, Offset, Message) are defined by ValidationResultsViewModel.Source. -->
    <TreeDataGrid x:Name="Grid"
                  Classes="gridLines"
                  IsVisible="{Binding HasResults}"
                  Source="{Binding Source}"
                  DoubleTapped="OnDoubleTapped" />
  </Panel>
</UserControl>
