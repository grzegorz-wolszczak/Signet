<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:menu="using:Signet.App.Menu"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:dc="using:Dock.Avalonia.Controls"
        xmlns:dconv="using:Dock.Avalonia.Converters"
        xmlns:dmc="using:Dock.Model.Controls"
        xmlns:loc="using:Signet.App.Resources"
        xmlns:tb="using:Signet.App.Toolbars"
        xmlns:views="using:Signet.App.Views"
        x:Class="Signet.App.Views.MainWindow"
        Classes="noFrame"
        Classes.multilineTabs="{Binding MultilineTabs}"
        infra:TooltipFonts.Area="MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <DockPanel>
    <DockPanel.Styles>
      <!-- The status bar message: a flat clickable area (opens the Notifications panel). -->
      <Style Selector="Button.statusMessage">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
      </Style>
      <!-- An error message (a blocked or failed operation) in the status bar. -->
      <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource SignetErrorBrush}" />
      </Style>
      <!-- Find & Replace sits below the document tab area (below the editor),
           not below the whole window: the DocumentDockControl template from Dock.Avalonia.Themes.Fluent
           (v12.1.0.6) extended with a FindReplacePanel docked at the bottom. The panel takes its context
           from MainWindow, because the template's DataContext is IDocumentDock. -->
      <Style Selector="dc|DocumentDockControl">
        <Setter Property="Template">
          <ControlTemplate>
            <dc:DockableControl TrackingMode="Visible" x:DataType="dmc:IDocumentDock">
              <DockPanel>
                <views:FindReplacePanel DockPanel.Dock="Bottom"
                                        DataContext="{Binding $parent[views:MainWindow].DataContext}" />
                <Panel>
                  <dc:DocumentControl IsActive="{Binding IsActive}" infra:TooltipFonts.Area="DocumentTabs"
                                      IsVisible="{Binding LayoutMode, Converter={x:Static dconv:DocumentLayoutModeMatchConverter.Instance}, ConverterParameter=Tabbed}" />
                  <dc:MdiDocumentControl IsActive="{Binding IsActive}" infra:TooltipFonts.Area="DocumentTabs"
                                         IsVisible="{Binding LayoutMode, Converter={x:Static dconv:DocumentLayoutModeMatchConverter.Instance}, ConverterParameter=Mdi}" />
                </Panel>
              </DockPanel>
            </dc:DockableControl>
          </ControlTemplate>
        </Setter>
      </Style>
      <!-- The items of the main menu and of the toolbar areas' context menu (View › Toolbars, the same item view models);
         the title of that context menu is a plain MenuItem of its own. -->
      <Style Selector="Menu#MainMenu MenuItem, ContextMenu.toolbarsMenu MenuItem:not(.menuTitle)" x:DataType="menu:MenuItemViewModel">
        <Setter Property="Header" Value="{Binding Header}" />
        <Setter Property="ItemsSource" Value="{Binding Items}" />
        <Setter Property="Command" Value="{Binding Command}" />
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}" />
        <!-- A recent file that is no longer on disk is dimmed while staying clickable (MenuItemViewModel.IsDimmed). -->
        <Setter Property="Opacity" Value="{Binding Opacity}" />
        <Setter Property="InputGesture" Value="{Binding InputGesture}" />
        <Setter Property="ToggleType" Value="{Binding ToggleType}" />
        <Setter Property="StaysOpenOnClick" Value="{Binding StaysOpenOnClick}" />
        <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=TwoWay}" />
        <!-- Action icons in the menu (from the current icon set); the icon state
             (e.g. the gray/red "Save" floppy disk) goes through ActionIcons. -->
        <Setter Property="Icon">
          <Template>
            <Panel x:DataType="menu:MenuItemViewModel">
              <Image Width="16" Height="16"
                     IsVisible="{Binding $self.Source, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image.Source>
                  <MultiBinding Converter="{x:Static infra:ActionIcons.ImageForState}">
                    <Binding Path="IconKey" />
                    <Binding Path="IconState" />
                  </MultiBinding>
                </Image.Source>
              </Image>
              <PathIcon Width="16" Height="16"
                        Data="{Binding IconKey, Converter={x:Static infra:IconKeyToGeometryConverter.Instance}}"
                        Foreground="{Binding IconState, Converter={x:Static infra:ActionIcons.ForegroundForState}}"
                        IsVisible="{Binding $self.Data, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Panel>
          </Template>
        </Setter>
      </Style>
    </DockPanel.Styles>

    <Menu x:Name="MainMenu" DockPanel.Dock="Top" ItemsSource="{Binding MenuItems}">
    </Menu>

    <!-- Toolbar areas under the menu and above the status bar: rows of toolbars that can be moved by their
         grips (between rows, into new rows, between the two areas). The bottom one is declared after the status
         bar so that it sits above it. -->
    <views:ToolbarAreaView x:Name="TopToolbarArea" DockPanel.Dock="Top" DataContext="{Binding TopToolbars}" />

    <Border DockPanel.Dock="Bottom"
            Padding="8,3"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="0" x:Name="StatusMessageButton"
                Classes="statusMessage"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                Command="{Binding OpenNotificationsCommand}"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                ToolTip.Tip="{loc:Loc MainWindow_StatusMessageTooltip}">
          <TextBlock Text="{Binding StatusMessage}"
                     Classes.error="{Binding IsStatusMessageWarning}"
                     TextTrimming="CharacterEllipsis" />
        </Button>
        <!-- Unread errors: the bell with a red dot + "[n]" (as on the Notifications tab); a click opens the panel. -->
        <Button Grid.Column="1" x:Name="UnreadWarningsButton"
                Classes="toolbar" Padding="4,0" Margin="8,0,0,0"
                Command="{Binding OpenNotificationsCommand}"
                IsVisible="{Binding HasUnreadWarnings}"
                ToolTip.Tip="{Binding UnreadWarningsTooltip}">
          <views:NotificationBell UnreadCount="{Binding Notifications.UnreadWarnings}" />
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
          <!-- The open book: its file name, the full path in the tooltip (books of the same name from other folders). -->
          <TextBlock x:Name="BookFileText"
                     Text="{Binding BookFileName}"
                     VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"
                     Background="Transparent"
                     ToolTip.Tip="{Binding BookFileTooltip}"
                     IsVisible="{Binding BookFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding TabStatus}"
                     VerticalAlignment="Center"
                     IsVisible="{Binding TabStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding CaretStatus}"
                     VerticalAlignment="Center"
                     IsVisible="{Binding CaretStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Content="−" Command="{Binding ZoomOutCommand}" Classes="toolbar" Padding="6,0" />
            <Button Content="{Binding ZoomPercentText}" Command="{Binding ZoomResetCommand}"
                    Classes="toolbar" Padding="4,0" MinWidth="44" />
            <Button Content="+" Command="{Binding ZoomInCommand}" Classes="toolbar" Padding="6,0" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <views:ToolbarAreaView x:Name="BottomToolbarArea" DockPanel.Dock="Bottom" DataContext="{Binding BottomToolbars}" />

    <!-- The stripes of the panels (IntelliJ's tool window bars) along the sides of the dock area. -->
    <views:PanelStripeView x:Name="LeftPanelStripe" DockPanel.Dock="Left" DataContext="{Binding PanelStripes.Left}" />
    <views:PanelStripeView x:Name="RightPanelStripe" DockPanel.Dock="Right" DataContext="{Binding PanelStripes.Right}" />

    <dc:DockControl Layout="{Binding Layout}"
                    Factory="{Binding DockFactory}"
                    InitializeLayout="False" />

  </DockPanel>

</Window>
