<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:search="using:Signet.Core.Search"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.DryRunReplaceWindow"
        x:DataType="vm:DryRunReplaceViewModel"
        Title="{loc:Loc DryRunReplaceWindow_Title}"
        Width="900" Height="520"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="8">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="Bold" />
      <TextBlock Text="{loc:Loc DryRunReplaceWindow_Context}" VerticalAlignment="Center" Margin="16,0,0,0" />
      <ComboBox ItemsSource="{Binding ContextOptions}"
                SelectedItem="{Binding ContextAmount, Mode=TwoWay}" MinWidth="70" />
      <Button Content="{loc:Loc Common_Refresh}" Command="{Binding RefreshCommand}" />
      <TextBlock Text="{loc:Loc DryRunReplaceWindow_FunctionReplacementUnsupported}"
                 Foreground="IndianRed" VerticalAlignment="Center"
                 IsVisible="{Binding HasFunctionReplacement}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{loc:Loc ClipEditorWindow_Filter}" VerticalAlignment="Center" />
      <TextBox Text="{Binding FilterText, Mode=TwoWay}" Width="360"
               PlaceholderText="{loc:Loc DryRunReplaceWindow_FilterPlaceholder}" />
    </StackPanel>

    <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="220,70,*,*" ColumnSpacing="6"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
          <TextBlock Grid.Column="0" Text="{loc:Loc DryRunReplaceWindow_BookPathColumn}" FontWeight="Bold" Margin="6,4" />
          <TextBlock Grid.Column="1" Text="{loc:Loc DryRunReplaceWindow_OffsetColumn}" FontWeight="Bold" Margin="6,4" />
          <TextBlock Grid.Column="2" Text="{loc:Loc DryRunReplaceWindow_BeforeColumn}" FontWeight="Bold" Margin="6,4" />
          <TextBlock Grid.Column="3" Text="{loc:Loc DryRunReplaceWindow_AfterColumn}" FontWeight="Bold" Margin="6,4" />
        </Grid>
        <ListBox ItemsSource="{Binding Rows}" x:Name="RowsList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="search:ReplacePreviewRow">
              <Grid ColumnDefinitions="220,70,*,*" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="{Binding BookPath}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Offset}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding BeforeSnippet}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding AfterSnippet}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</Window>
