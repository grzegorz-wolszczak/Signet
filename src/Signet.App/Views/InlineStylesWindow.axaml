<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="using:Signet.App.Infrastructure"
        xmlns:vm="using:Signet.App.ViewModels"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.InlineStylesWindow"
        infra:TooltipFonts.Area="OtherWindows"
        x:DataType="vm:InlineStylesViewModel"
        Width="980" Height="660" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc InlineStylesWindow_Title}">

  <!-- The cells of the tree (the columns are built in code; InlineStyleNode). A double click opens the place. -->
  <Window.Resources>
    <DataTemplate x:Key="InlineStylesTitleCellTemplate" x:DataType="vm:InlineStyleNode">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" DoubleTapped="OnRowDoubleTapped">
        <CheckBox IsChecked="{Binding Check, Mode=TwoWay}" IsVisible="{Binding HasCheckBox}" MinWidth="0" Margin="0,0,4,0" />
        <TextBlock Text="{loc:Loc InlineStylesWindow_WarningMark}" IsVisible="{Binding IsWarning}" Margin="0,0,6,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="InlineStylesPlaceCellTemplate" x:DataType="vm:InlineStyleNode">
      <TextBlock Text="{Binding Place}" VerticalAlignment="Stretch" TextTrimming="CharacterEllipsis" Background="Transparent"
                 ToolTip.Tip="{Binding Place}" DoubleTapped="OnRowDoubleTapped" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="ExtractButton" Content="{loc:Loc InlineStylesWindow_Extract}" Command="{Binding ExtractCommand}"
              Classes="accent" MinWidth="80" />
      <Button x:Name="CloseButton" Content="{loc:Loc Common_Close}" IsCancel="True" MinWidth="80" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="{loc:Loc InlineStylesWindow_Intro}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StylesheetText}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding OutsideText}" IsVisible="{Binding HasOutside}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{loc:Loc InlineStylesWindow_MinOccurrences}" VerticalAlignment="Center" />
        <NumericUpDown x:Name="MinOccurrencesBox" Value="{Binding MinOccurrences}" Minimum="1" Increment="1" FormatString="0" MinWidth="110" />
      </StackPanel>
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" IsVisible="{Binding HasItems}">
        <Button x:Name="SelectAllButton" Content="{loc:Loc FootnoteConversionWindow_SelectAll}" Command="{Binding SelectAllCommand}" />
        <Button x:Name="SelectNoneButton" Content="{loc:Loc FootnoteConversionWindow_SelectNone}" Command="{Binding SelectNoneCommand}" />
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{loc:Loc InlineStylesWindow_DoubleClickHint}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Text="{loc:Loc InlineStylesWindow_None}" IsVisible="{Binding !HasItems}" TextWrapping="Wrap" />
    </StackPanel>

    <Border BorderBrush="{DynamicResource SignetFrameBrush}" BorderThickness="1" IsVisible="{Binding HasItems}">
      <TreeDataGrid x:Name="Tree" />
    </Border>
  </DockPanel>
</Window>
