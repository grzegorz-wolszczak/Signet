<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Signet.App.Infrastructure"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.BookBrowserView"
             infra:TooltipFonts.Area="BookBrowser"
             x:DataType="vm:BookBrowserViewModel"
             x:Name="Root">

  <UserControl.Resources>

    <!-- The folder and file icons are application resources drawn in the colors of the theme (AppTheme). -->

    <!-- The name cell (looked up by key from the code-behind): icon, name trimmed in the middle, ⚠ for a file that
         is not well-formed, and the in-place rename editor. -->
    <DataTemplate x:Key="NameCellTemplate" x:DataType="vm:BookBrowserNode">
      <!-- The cover/nav have no markers (the information is in the tooltip); the ⚠ for a
           file that is not well-formed is a deliberate addition. -->
      <DockPanel ToolTip.Tip="{Binding ToolTip}" Background="Transparent">
        <!-- The folders with a calibre icon (Text, Styles, Images, Fonts, Misc); Audio and Video keep the plain folder. -->
        <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,5,0"
               Source="{Binding FolderIconKey, Converter={x:Static infra:IconKeyToImageConverter.Instance}}"
               IsVisible="{Binding HasFolderIcon}" />
        <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,5,0"
               Source="{DynamicResource SignetFolderIcon}" IsVisible="{Binding IsPlainFolder}" />
        <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,5,0"
               Source="{DynamicResource SignetFileIcon}" IsVisible="{Binding !IsFolder}" />
        <TextBlock DockPanel.Dock="Right" Text="⚠" Foreground="{DynamicResource SignetRiskMarkerBrush}" Margin="4,0,0,0"
                   IsVisible="{Binding IsMalformed}" ToolTip.Tip="{loc:Loc BookBrowserView_MalformedTip}" />
        <!-- Trimming in the middle of the name. -->
        <TextBlock Text="{Binding Header}" TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center"
                   IsVisible="{Binding !IsEditing}" />
        <!-- In-place rename: Enter confirms, Esc and focus loss cancel —
             handled in BookBrowserView. -->
        <TextBox Classes="inPlaceRename" Text="{Binding EditText, Mode=TwoWay}"
                 IsVisible="{Binding IsEditing}"
                 MinHeight="0" Padding="2,0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
      </DockPanel>
    </DataTemplate>

    <!-- The menu of the Fonts folder and of font files (opened from the code-behind instead of the files menu): only
         the actions that make sense for fonts; on the folder itself only the folder actions. -->
    <ContextMenu x:Key="FontContextMenu" x:DataType="vm:BookBrowserViewModel">
      <MenuItem Header="{loc:Loc BookBrowserView_Open}" Command="{Binding OpenSelectedCommand}" IsVisible="{Binding !IsFontFolderMenu}" />
      <MenuItem Header="{loc:Loc Common_RenameEllipsis}" Command="{Binding RenameSelectedCommand}" IsVisible="{Binding !IsFontFolderMenu}" />
      <MenuItem Header="{loc:Loc BookBrowserView_RenameWithTemplate}" Command="{Binding RenameSelectedWithTemplateCommand}" IsVisible="{Binding !IsFontFolderMenu}" />
      <MenuItem Header="{loc:Loc RegexRenameWindow_Title}" Command="{Binding BulkRegexRenameSelectedCommand}" IsVisible="{Binding !IsFontFolderMenu}" />
      <MenuItem Header="{loc:Loc Common_Delete}" Command="{Binding DeleteSelectedCommand}" IsVisible="{Binding !IsFontFolderMenu}" />
      <MenuItem Header="{loc:Loc BookBrowserView_MoveToFolder}" Command="{Binding MoveSelectedCommand}" IsVisible="{Binding !IsFontFolderMenu}" />
      <Separator IsVisible="{Binding !IsFontFolderMenu}" />
      <MenuItem Header="{loc:Loc BookBrowserView_AddCopy}" Command="{Binding AddCopySelectedCommand}" IsVisible="{Binding !IsFontFolderMenu}" />
      <MenuItem Header="{loc:Loc BookBrowserView_SaveAs}" Command="{Binding SaveAsSelectedCommand}" IsVisible="{Binding !IsFontFolderMenu}" />
      <MenuItem Header="{loc:Loc BookBrowserView_SelectAll}" Command="{Binding SelectAllInFolderCommand}" />
      <MenuItem Header="{loc:Loc BookBrowserView_GetInfo}" Command="{Binding GetInfoSelectedCommand}" IsVisible="{Binding !IsFontFolderMenu}" />
      <Separator />
      <MenuItem Header="{loc:Loc BookBrowserView_AddFontFiles}" Command="{Binding AddFontFilesCommand}" />
      <MenuItem Header="{loc:Loc BookBrowserView_ManageFonts}" Command="{Binding ManageFontsCommand}" />
    </ContextMenu>
  </UserControl.Resources>

  <Panel>
    <TextBlock Text="{loc:Loc BookBrowserView_NoBookOpen}"
               IsVisible="{Binding !HasBook}"
               Margin="16" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top" />

    <!-- The files tree: Name (expandable) and the optional columns # / Semantics / Properties, chosen from the
         context menu of the column headers (remembered in the settings). Source and columns are built in the
         code-behind. Not sortable: the order of the files is the book's (Move Up / Down). -->
    <Grid IsVisible="{Binding HasBook}">
      <TreeDataGrid x:Name="Tree"
                    Background="{DynamicResource SignetBookBrowserBackgroundBrush}"
                    CanUserSortColumns="False">
        <TreeDataGrid.Styles>
          <!-- The defaults of the look settings until a view model is bound (ApplyAppearance replaces them): a row is as
               high as its content, at least 16 px; the space between the rows is the row spacing (the margin of a row). -->
          <Style Selector=":is(TreeDataGridCell)">
            <Setter Property="MinHeight" Value="16" />
          </Style>
          <Style Selector="TreeDataGridTextCell">
            <Setter Property="Padding" Value="4,0" />
          </Style>
        </TreeDataGrid.Styles>
        <TreeDataGrid.ContextMenu>
          <ContextMenu x:DataType="vm:BookBrowserViewModel">
            <MenuItem Header="{loc:Loc BookBrowserView_Open}" Command="{Binding OpenSelectedCommand}" />
            <MenuItem Header="{loc:Loc Common_RenameEllipsis}" Command="{Binding RenameSelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_RenameWithTemplate}" Command="{Binding RenameSelectedWithTemplateCommand}" />
            <MenuItem Header="{loc:Loc RegexRenameWindow_Title}" Command="{Binding BulkRegexRenameSelectedCommand}" />
            <MenuItem Header="{loc:Loc Common_Delete}" Command="{Binding DeleteSelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_MoveToFolder}" Command="{Binding MoveSelectedCommand}" />
            <Separator />
            <MenuItem Header="{loc:Loc BookBrowserView_MoveUp}" Command="{Binding MoveTextUpCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_MoveDown}" Command="{Binding MoveTextDownCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_MoveToTop}" Command="{Binding MoveTextToTopCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_MoveToBottom}" Command="{Binding MoveTextToBottomCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_SortSelected}" Command="{Binding SortTextCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_MergeSelected}" Command="{Binding MergeSelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_SplitAtMarkers}" Command="{Binding SplitSelectedCommand}" />
            <!-- The "add" actions only on a folder (none on files), and only the ones that fit that folder are enabled. -->
            <Separator IsVisible="{Binding ShowAddItems}" />
            <MenuItem Header="{loc:Loc BookBrowserView_AddBlankHtml}" Command="{Binding AddBlankHtmlCommand}"
                      IsVisible="{Binding ShowAddItems}" IsEnabled="{Binding CanAddBlankHtmlHere}" />
            <MenuItem Header="{loc:Loc BookBrowserView_AddBlankCss}" Command="{Binding AddBlankCssCommand}"
                      IsVisible="{Binding ShowAddItems}" IsEnabled="{Binding CanAddBlankCssHere}" />
            <MenuItem Header="{loc:Loc BookBrowserView_AddBlankSvg}" Command="{Binding AddBlankSvgCommand}"
                      IsVisible="{Binding ShowAddItems}" IsEnabled="{Binding CanAddBlankSvgHere}" />
            <MenuItem Header="{loc:Loc BookBrowserView_AddBlankJs}" Command="{Binding AddBlankJsCommand}"
                      IsVisible="{Binding ShowAddItems}" IsEnabled="{Binding CanAddBlankJsHere}"
                      ToolTip.Tip="{Binding AddBlankJsTip}" ToolTip.ShowOnDisabled="True" />
            <MenuItem Header="{Binding AddExistingFilesHeader}" Command="{Binding AddExistingFilesCommand}"
                      IsVisible="{Binding ShowAddItems}" IsEnabled="{Binding CanAddExistingFilesHere}" />
            <Separator />
            <MenuItem Header="{loc:Loc BookBrowserView_AddSemantics}" Command="{Binding AddSemanticsSelectedCommand}" />
            <MenuItem Classes="actionIcon" Tag="delete" Header="{loc:Loc BookBrowserView_RemoveSemantics}"
                      Command="{Binding RemoveSemanticsSelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_CoverImage}" Command="{Binding CoverImageSelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_MarkAsNav}" Command="{Binding MarkAsNavSelectedCommand}" />
            <Separator />
            <MenuItem Header="{loc:Loc BookBrowserView_LinkStylesheetsMenu}" Command="{Binding LinkStylesheetsSelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_LinkJavascriptsMenu}" Command="{Binding LinkJavascriptsSelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_ValidateWithW3C}" Command="{Binding ValidateSelectedWithW3CCommand}" />
            <Separator />
            <MenuItem Header="{loc:Loc BookBrowserView_AddCopy}" Command="{Binding AddCopySelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_RenumberToc}" Command="{Binding RenumberTocSelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_SaveAs}" Command="{Binding SaveAsSelectedCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_SelectAll}" Command="{Binding SelectAllInFolderCommand}" />
            <MenuItem Header="{loc:Loc BookBrowserView_GetInfo}" Command="{Binding GetInfoSelectedCommand}" />
          </ContextMenu>
        </TreeDataGrid.ContextMenu>
      </TreeDataGrid>
      <Border x:Name="TextReorderIndicator"
              IsVisible="False"
              IsHitTestVisible="False"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Height="2"
              Background="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Grid>
  </Panel>
</UserControl>
