<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:infra="using:Signet.App.Infrastructure"
             xmlns:loc="using:Signet.App.Resources"
             xmlns:cv="using:Signet.App.CodeEditor"
             x:Name="Page"
             x:Class="Signet.App.Views.FontsPageView"
             x:DataType="vm:FontPageViewModel">
  <!-- A "Fonts" page of the Preferences window: the font settings, each with its preview under it. -->
  <!-- The settings take half of the page at most to start with; the splitter after them moves: they can be made wider or
       narrower (the space they leave stays free). -->
  <Grid x:Name="PreviewGrid" Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="240" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" MinWidth="160" />
    </Grid.ColumnDefinitions>
    <!-- Only the settings are disabled (IsContentEnabled), not the scroll viewer: a page of settings that are switched
         off (e.g. while the theme does not use its own fonts) can still be scrolled. -->
    <ScrollViewer Grid.Column="0">
      <!-- The right margin keeps the cards off the scroll bar, as far as they are from the left edge of the page. -->
      <StackPanel x:Name="Settings" Spacing="14" Margin="0,0,20,0" IsEnabled="{Binding #Page.IsContentEnabled}">
        <!-- Filled in code: the rows exist before the page is shown, so the search of the window finds them. -->
        <StackPanel x:Name="Rows" Spacing="14" />
        <HyperlinkButton x:Name="RestoreDefaultsLink" Content="{loc:Loc PreferencesWindow_RestoreFontDefaults}"
                         Command="{Binding RestoreDefaultsCommand}" Padding="0" />
        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Opacity="0.7" FontStyle="Italic" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent"
                  ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted" />

    <!-- What the settings do not take stays free: the previews are in the rows, under the fonts. -->
  </Grid>
</UserControl>
