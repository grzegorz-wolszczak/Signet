<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:infra="using:Signet.App.Infrastructure"
             xmlns:loc="using:Signet.App.Resources"
             xmlns:cv="using:Signet.App.CodeEditor"
             x:Name="Page"
             x:Class="Signet.App.Views.FontsPageView"
             x:DataType="vm:FontPageViewModel">
  <!-- A "Fonts" page of the Preferences window, as Rider's Editor › Font: the font settings on the left, the preview of
       the one focused or changed last on the right. -->
  <!-- The splitter between the settings and the preview moves: the preview can be made wider or narrower. -->
  <Grid x:Name="PreviewGrid" Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="240" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" MinWidth="160" />
    </Grid.ColumnDefinitions>
    <!-- Only the settings are disabled (IsContentEnabled), not the scroll viewer: a page of settings that are switched
         off (e.g. while the theme does not use its own fonts) can still be scrolled. -->
    <ScrollViewer Grid.Column="0">
      <!-- The right margin keeps the cards off the scroll bar, as far as they are from the left edge of the page. -->
      <StackPanel x:Name="Settings" Spacing="14" Margin="0,0,20,0" IsEnabled="{Binding #Page.IsContentEnabled}">
        <!-- Filled in code: the rows exist before the page is shown, so the search of the window finds them. -->
        <StackPanel x:Name="Rows" Spacing="14" />
        <HyperlinkButton x:Name="RestoreDefaultsLink" Content="{loc:Loc PreferencesWindow_RestoreFontDefaults}"
                         Command="{Binding RestoreDefaultsCommand}" Padding="0" />
        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Opacity="0.7" FontStyle="Italic" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent"
                  ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted" />

    <Border Grid.Column="2" Padding="10" CornerRadius="4" BorderThickness="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <CheckBox x:Name="WrapPreviewBox" DockPanel.Dock="Right" Content="{loc:Loc PreferencesWindow_WrapPreview}"
                    IsChecked="{Binding WrapPreview}" Margin="8,0,0,0" />
          <TextBlock Classes="noSearch" Text="{Binding Active.Label, FallbackValue={x:Null}}"
                     Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <Panel>
          <!-- A sample of text, in the colors of the place the font is used in, or a sample of code, highlighted as in
               Code Editor with line numbers: which one shows, the code sample and the wrapping are set in code. -->
          <ScrollViewer x:Name="PlainPreview" HorizontalScrollBarVisibility="Auto">
            <Border x:Name="PreviewSurface" Padding="6,4" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{Binding Active.PreviewBackground, Converter={x:Static infra:ColorConverters.ToBrush}, FallbackValue={x:Null}}">
              <TextBlock x:Name="PreviewText" Classes="noSearch" Text="{Binding Active.PreviewText, FallbackValue={x:Null}}"
                         FontFamily="{Binding Active.EffectiveFamily, Converter={x:Static infra:FontFamilyConverters.FromName}, FallbackValue={x:Static FontFamily.Default}}"
                         FontSize="{Binding Active.EffectiveSize, FallbackValue=14}"
                         FontWeight="{Binding Active.EffectiveWeight, Converter={x:Static infra:FontWeightOptions.FromNumber}, FallbackValue=Normal}"
                         Foreground="{Binding Active.PreviewForeground, Converter={x:Static infra:ColorConverters.ToBrush}}" />
            </Border>
          </ScrollViewer>
          <cv:CodePreviewEditor x:Name="CodePreview" IsVisible="False" />
        </Panel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
