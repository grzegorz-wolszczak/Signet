<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Signet.App.Resources"
        x:Class="Signet.App.Views.LoadWarningsDialog"
        Width="900" Height="520" MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{loc:Loc LoadWarningsDialog_Title}">

  <Window.Styles>
    <!-- The buttons of the left toolbar: small, flat, with a vector icon (as in the Find Usages panel). -->
    <Style Selector="Button.panelTool">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.panelTool Path">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CopyButton" Content="{loc:Loc LoadWarningsDialog_Copy}" MinWidth="90" />
      <Button x:Name="OkButton" Content="{loc:Loc Common_Ok}" IsDefault="True" IsCancel="True" MinWidth="90" />
    </StackPanel>

    <!-- Left toolbar, like the Find tool window of the JetBrains IDEs. -->
    <Border DockPanel.Dock="Left" BorderThickness="0,0,1,0" Padding="2" Margin="0,0,6,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="4">
        <Button x:Name="ExpandAllButton" Classes="panelTool" ToolTip.Tip="{loc:Loc LoadWarningsDialog_ExpandAll}">
          <!-- Material Design "unfold-more-horizontal" icon (Apache License 2.0): two chevrons pointing apart. -->
          <Path Data="M12,18.17L8.83,15L7.42,16.41L12,21L16.59,16.41L15.17,15M12,5.83L15.17,9L16.58,7.59L12,3L7.41,7.59L8.83,9L12,5.83Z" />
        </Button>
        <Button x:Name="CollapseAllButton" Classes="panelTool" ToolTip.Tip="{loc:Loc LoadWarningsDialog_CollapseAll}">
          <!-- Material Design "unfold-less-horizontal" icon (Apache License 2.0): two chevrons pointing together. -->
          <Path Data="M16.59,5.59L18,7L12,13L6,7L7.41,5.59L12,10.17L16.59,5.59M16.59,18.41L12,13.83L7.41,18.41L6,17L12,11L18,17L16.59,18.41Z" />
        </Button>
      </StackPanel>
    </Border>

    <!-- The warnings as a tree (a warning, then its files with the reason and the line:column) in a virtualizing
         TreeDataGrid: a warning about hundreds of files stays fast. Source and columns are built in the code-behind. -->
    <TreeDataGrid x:Name="WarningsTree" DoubleTapped="OnTreeDoubleTapped" />
  </DockPanel>
</Window>
