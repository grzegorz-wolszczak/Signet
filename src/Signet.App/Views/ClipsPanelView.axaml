<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Signet.App.ViewModels"
             xmlns:loc="using:Signet.App.Resources"
             x:Class="Signet.App.Views.ClipsPanelView"
             x:DataType="vm:ClipsViewModel">

  <UserControl.Resources>
    <!-- The name cell of the clips tree (looked up by key from the code-behind): the name as text; editing only after
         the Rename action (F2 by default, handled in ClipsPanelView): Enter and focus loss commit, Esc cancels. -->
    <DataTemplate x:Key="NameCellTemplate" x:DataType="vm:ClipNodeViewModel">
      <Grid Background="Transparent" MinHeight="24">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}" />
        <TextBox Classes="inPlaceRename" Text="{Binding EditText, Mode=TwoWay}"
                 IsVisible="{Binding IsEditing}" MinWidth="140"
                 MinHeight="0" Padding="2,0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Margin="0,6,0,0"
               Foreground="{DynamicResource SystemAccentColor}" TextWrapping="Wrap" />

    <!-- The clips tree (Name, Text): source built in the code-behind; the filter hides nodes through
         VisibleItemsView, several nodes can be selected. -->
    <TreeDataGrid x:Name="Tree"
                  BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <TreeDataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{loc:Loc ClipEditorWindow_Paste}" Command="{Binding PasteCommand}" />
          <Separator />
          <MenuItem Header="{loc:Loc ClipsPanelView_CollapseAll}" Command="{Binding CollapseAllCommand}" />
          <MenuItem Header="{loc:Loc ClipsPanelView_ExpandAll}" Command="{Binding ExpandAllCommand}" />
        </ContextMenu>
      </TreeDataGrid.ContextMenu>
    </TreeDataGrid>
  </DockPanel>
</UserControl>
