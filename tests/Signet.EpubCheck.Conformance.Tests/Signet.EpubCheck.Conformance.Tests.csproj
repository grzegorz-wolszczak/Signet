<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the conformance suite of EPUBCheck (the Cucumber scenarios copied into tests/corpus/epubcheck) against the port.
    The .feature files are parsed by the Gherkin package; the steps are bound here (Harness/Steps), after upstream's
    step definitions. A scenario runs when its feature is listed in ConformanceStatus.EnabledFeatures (or when
    SIGNET_CONFORMANCE_ALL=1 asks for all of them); the others are skipped with the reason.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Gherkin" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!-- The temporary-folder isolation and cleanup check shared by all the test projects. -->
    <Compile Include="..\Signet.Core.Tests\TestSupport\TestIsolation.cs" Link="TestSupport\TestIsolation.cs" />
    <Compile Include="..\Signet.Core.Tests\TestSupport\TempDir.cs" Link="TestSupport\TempDir.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Signet.EpubCheck.Core\Signet.EpubCheck.Core.csproj" />
    <ProjectReference Include="..\..\src\Signet.EpubCheck.Cli\Signet.EpubCheck.Cli.csproj" />
  </ItemGroup>

  <!-- Path to tests/corpus, read by ConformanceCorpus. -->
  <ItemGroup>
    <AssemblyMetadata Include="CorpusRoot" Value="$(MSBuildThisFileDirectory)..\corpus" />
  </ItemGroup>

</Project>
