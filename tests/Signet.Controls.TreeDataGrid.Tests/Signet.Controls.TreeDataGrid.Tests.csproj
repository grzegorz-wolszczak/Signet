<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of Signet.Controls.TreeDataGrid (the fork of the MIT TreeDataGrid control), ported from the upstream test
    project. Avalonia headless tests ([AvaloniaFact]) on Signet's test stack. As in the control's project, the code
    keeps its upstream style: .NET analyzers and code-style enforcement are off.
  -->
  <PropertyGroup>
    <RootNamespace>Signet.Controls.TreeDataGrid.Tests</RootNamespace>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Signet.Controls.TreeDataGrid\Signet.Controls.TreeDataGrid.csproj" />
  </ItemGroup>

</Project>
