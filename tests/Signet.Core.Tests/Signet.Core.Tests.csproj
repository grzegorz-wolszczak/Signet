<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="AutoFixture" />
    <PackageReference Include="AutoFixture.Xunit3" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Signet.Core\Signet.Core.csproj" />
  </ItemGroup>

  <!-- Path to the test corpus (tests/corpus) injected as an assembly attribute,
       read by Signet.Core.Tests.TestSupport.CorpusPaths. -->
  <ItemGroup>
    <AssemblyMetadata Include="CorpusRoot" Value="$(MSBuildThisFileDirectory)..\corpus" />
  </ItemGroup>

</Project>
