<Project>

  <!-- Inherits the settings from the root Directory.Build.props and then adds the rules
       specific to test projects. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- CA1707: test method names deliberately use underscores (the "Method_scenario_result" style). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
