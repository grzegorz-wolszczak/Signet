<Project>

  <!-- Shared settings for all projects in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- Signet's version is MAJOR.MINOR.PATCH.BUILD. Released versions come from the git tags vX.Y.Z.W made by the release
         pipeline (.github/workflows/release.yml), which passes -p:SignetReleaseVersion=X.Y.Z.W; this prefix is only the
         version of local builds and is not bumped by hand. -->
    <VersionPrefix>0.1.0.0</VersionPrefix>
    <VersionPrefix Condition="'$(SignetReleaseVersion)' != ''">$(SignetReleaseVersion)</VersionPrefix>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Required by the IDE0005 analyzer (unused usings) with EnforceCodeStyleInBuild.
         CS1591 (missing XML comment) is suppressed globally - public API documentation
         is enforced by review, not by the compiler. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- The IDE style rules (IDExxxx) are warnings, not errors. -->
  <Import Project="$(MSBuildThisFileDirectory)IdeWarnings.props" />

</Project>
