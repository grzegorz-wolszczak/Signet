# Line endings as in Microsoft's .NET repositories (dotnet/runtime, roslyn, aspnetcore, sdk): text files are stored
# with LF and checked out with the platform's line endings (LF on Linux, CRLF on Windows). No eol is forced for
# C# or project files; .editorconfig sets no end_of_line for them either.
* text=auto

*.cs text diff=csharp

# Scripts that only work with one kind of line ending.
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

*.bin binary

# Embedded reference data tables - byte-stable on every platform.
src/Signet.Core/EmbeddedData/*.tsv text eol=lf
src/Signet.Core/EmbeddedData/*.json text eol=lf
src/Signet.Core/EmbeddedData/*.gz binary
