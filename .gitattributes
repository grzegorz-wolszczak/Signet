# Line endings. .NET source and project files follow Visual Studio / Microsoft's recommendation: CRLF on disk on every
# platform (stored as LF in git). Everything else is text=auto (platform line endings on disk). Keep .editorconfig
# (end_of_line) in step with the .NET list below.
* text=auto

# .NET files: CRLF everywhere.
*.cs text eol=crlf diff=csharp
*.csx text eol=crlf diff=csharp
*.vb text eol=crlf
*.csproj text eol=crlf
*.vbproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.slnx text eol=crlf
*.sln text eol=crlf
*.axaml text eol=crlf
*.xaml text eol=crlf
*.resx text eol=crlf

# Scripts that only work with one kind of line ending.
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

*.bin binary

# Embedded reference data tables - byte-stable on every platform.
src/Signet.Core/EmbeddedData/*.tsv text eol=lf
src/Signet.Core/EmbeddedData/*.json text eol=lf
src/Signet.Core/EmbeddedData/*.gz binary
